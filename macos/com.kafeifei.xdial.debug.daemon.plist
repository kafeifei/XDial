<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.kafeifei.xdial.debug.daemon</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/xdial-daemon</string>
	<key>ProgramArguments</key>
	<array>
		<string>xdial-daemon</string>
		<string>daemon</string>
		<string>--socket</string>
		<string>/tmp/xdial-debug.sock</string>
	</array>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>com.kafeifei.xdial.debug</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/tmp/xdial-debug.log</string>
	<key>StandardErrorPath</key>
	<string>/tmp/xdial-debug.log</string>
</dict>
</plist>
