{
  "sourceLanguage": "en",
  "strings": {
    "line.address.missing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Address not obtained"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地址未获取"
          }
        }
      }
    },
    "line.address.retryHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click to query this address again. The Line connection is unchanged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击重新查询此地址，不改变线路连接。"
          }
        }
      }
    },
    "line.address.retryLabel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry address lookup"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新查询地址"
          }
        }
      }
    },
    "line.address.updateFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Address update failed. Click to query again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地址更新失败，点击重新查询。"
          }
        }
      }
    },
    "line.address.display": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Display address"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示地址"
          }
        }
      }
    },
    "line.address.query": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Looking up address"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在获取地址"
          }
        }
      }
    },
    "line.address.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unavailable"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不可用"
          }
        }
      }
    },
    "feedback.intro": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择支持原生文件交接的 AI 助手，带上诊断文件聊。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose an AI assistant with native file handoff support."
          }
        }
      }
    },
    "feedback.kind": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I want to"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我想要"
          }
        }
      }
    },
    "feedback.kind.problem": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get help or give feedback"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用帮助与反馈"
          }
        }
      }
    },
    "feedback.kind.diagnosis": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnose a failure"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "排查故障"
          }
        }
      }
    },
    "feedback.kind.configuration": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjust configuration"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整配置"
          }
        }
      }
    },
    "feedback.kind.suggestion": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggest a feature"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提出建议"
          }
        }
      }
    },
    "feedback.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What would you like help with? (optional)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "想聊什么（可选）"
          }
        }
      }
    },
    "feedback.placeholder.problem": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe a problem or idea, or start a conversation directly."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "描述问题或想法，也可以直接开始对话。"
          }
        }
      }
    },
    "feedback.placeholder.diagnosis": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For example: a website stopped opening after switching Scenarios."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "例如：切换场景后某个网站打不开。"
          }
        }
      }
    },
    "feedback.placeholder.configuration": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For example: use the work Line for company domains, and connect directly for other traffic."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "例如：公司域名走办公线路，其他流量保持直连。"
          }
        }
      }
    },
    "feedback.placeholder.suggestion": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What is getting in your way? How would you like XDial to improve?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你想解决什么不便？希望 XDial 怎样改进？"
          }
        }
      }
    },
    "feedback.includeDiagnostics": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Include a diagnostic snapshot"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "附带诊断快照"
          }
        }
      }
    },
    "feedback.privacy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic diagnostics include only version, connection/task states, and known error categories, without configuration, credentials, addresses, or raw logs. Your description is shared as written."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动资料仅含版本、连接与任务状态、已分类的错误，不含配置、凭据、地址或原始日志。你填写的内容会原样交给助手。"
          }
        }
      }
    },
    "feedback.preview": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review the file to be shared"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看将分享的文件"
          }
        }
      }
    },
    "feedback.assistant": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI assistant on this Mac"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机 AI 助手"
          }
        }
      }
    },
    "feedback.refresh": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Detect assistants again and refresh the diagnostic snapshot"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新检测助手并刷新诊断快照"
          }
        }
      }
    },
    "feedback.noAssistant": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未发现已安装的 AI 软件。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No installed AI apps found."
          }
        }
      }
    },
    "feedback.continue": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue in %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 %@ 中继续"
          }
        }
      }
    },
    "feedback.handoffHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste and send after opening. Attach the diagnostic file if the assistant cannot read local files."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开后粘贴并发送。若助手无法读取本地文件，请添加诊断文件。"
          }
        }
      }
    },
    "feedback.copy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy feedback contents"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制反馈内容"
          }
        }
      }
    },
    "feedback.reveal": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show diagnostic file…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看诊断文件…"
          }
        }
      }
    },
    "feedback.copied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnostic file and short prompt copied. Paste into an AI conversation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "诊断文件和简短说明已复制，可粘贴到 AI 对话。"
          }
        }
      }
    },
    "feedback.openFailed": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能发起文件交接。请检查助手是否可用后重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not request file handoff. Check the assistant and retry."
          }
        }
      }
    },
    "feedback.exportFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not create or copy the feedback file. Retry, or copy your description manually."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能生成或复制反馈文件。请重试；仍未成功时，可先复制你填写的描述。"
          }
        }
      }
    },
    "feedback.choose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 %@"
          }
        }
      }
    },
    "feedback.assistantUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The previously selected assistant is no longer available. Choose an assistant before continuing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "之前选择的助手已不可用。请选择要使用的助手，再继续交接。"
          }
        }
      }
    },
    "feedback.newConversation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New conversation in %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 %@ 中新建对话"
          }
        }
      }
    },
    "feedback.folderHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste and send in the new conversation. Details are saved in the file."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开新对话后，粘贴并发送。详细资料保存在文件中。"
          }
        }
      }
    },
    "feedback.codexHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The new conversation has a short prompt; the AI reads the details from the file."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新对话只预填简短说明，详细资料由 AI 从文件读取。"
          }
        }
      }
    },
    "feedback.context.connection": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This connection failure is included."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已附带这次连接失败的现场。"
          }
        }
      }
    },
    "feedback.context.switch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Scenario switch failure is included."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已附带这次场景切换失败的现场。"
          }
        }
      }
    },
    "feedback.context.clear": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discuss something else"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "聊其他问题"
          }
        }
      }
    },
    "feedback.description.additional": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Additional details (optional)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "补充说明（可选）"
          }
        }
      }
    },
    "feedback.placeholder.additional": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For example: whether this happens every time, or which apps are affected. No need to repeat the error above."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "例如：是否每次都会发生，或哪些应用受影响。不必重新描述已经记录的错误。"
          }
        }
      }
    },
    "feedback.context.omitted": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已关闭诊断信息，错误现场不会交给 AI。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnostics are off. The error context will not be shared."
          }
        }
      }
    },
    "feedback.intro.connection": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let your AI assistant pick up from this connection failure and help restore your connection."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让 AI 助手接着排查这次连接失败，帮你恢复连接。"
          }
        }
      }
    },
    "feedback.intro.switch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let your AI assistant pick up from this Scenario switch failure and help get the target Scenario working."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让 AI 助手接着排查这次场景切换失败，帮你让目标场景正常生效。"
          }
        }
      }
    },
    "feedback.askAI": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找 AI 帮忙"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask AI"
          }
        }
      }
    },
    "feedback.unsupported": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不支持原生文件交接"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Native file handoff unsupported"
          }
        }
      }
    },
    "feedback.requested": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已向 %@ 发起文件交接，请在应用中确认。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File handoff requested in %@. Confirm in the app."
          }
        }
      }
    }
  },
  "version": "1.0"
}
