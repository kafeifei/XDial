+func validTailscaleDNSDomain(domain string) bool {
+	if len(domain) == 0 || len(domain) > 253 {
+		return false
+	}
+	for _, label := range strings.Split(domain, ".") {
+		if len(label) == 0 || len(label) > 63 {
+			return false
+		}
+		for _, character := range []byte(label) {
+			if (character >= 'a' && character <= 'z') ||
+				(character >= '0' && character <= '9') ||
+				character == '-' || character == '_' {
+				continue
+			}
+			return false
+		}
+	}
+	return true
+}
+
+func cloneDNSMemorySnapshot(snapshot DNSMemorySnapshot) DNSMemorySnapshot {
+	hosts := make(map[string][]netip.Addr, len(snapshot.Hosts))
+	for domain, addresses := range snapshot.Hosts {
+		hosts[domain] = append([]netip.Addr(nil), addresses...)
+	}
+	return DNSMemorySnapshot{
+		Hosts:          hosts,
+		CaptureDomains: append([]string(nil), snapshot.CaptureDomains...),
+		OwnedDomains:   append([]string(nil), snapshot.OwnedDomains...),
+		RecordCount:    snapshot.RecordCount,
+	}
 }
 
