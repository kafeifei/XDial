+func TestXDialDNSMemorySnapshotIncludesExactHostsAndShortAliases(t *testing.T) {
+	tailnet := mustXDialFQDN(t, "example-tailnet.ts.net")
+	member := mustXDialFQDN(t, "mba32k.example-tailnet.ts.net")
+	address4 := netip.MustParseAddr("100.64.0.8")
+	address6 := netip.MustParseAddr("fd7a:115c:a1e0::8")
+	state := tailscaleDNSMemorySnapshotFromConfig(&tsDNS.Config{
+		SearchDomains: []dnsname.FQDN{tailnet},
+		Routes: map[dnsname.FQDN][]*dnstype.Resolver{
+			tailnet: nil,
+		},
+		Hosts: map[dnsname.FQDN][]netip.Addr{
+			member: {address4, address6},
+		},
+	})
+	if state.errorCode != tailscaleDNSSnapshotValid {
+		t.Fatalf("snapshot error code = %d", state.errorCode)
+	}
+	wantAddresses := []netip.Addr{address4, address6}
+	for _, name := range []string{"mba32k", "mba32k.example-tailnet.ts.net"} {
+		if !reflect.DeepEqual(state.snapshot.Hosts[name], wantAddresses) {
+			t.Fatalf("record address count for %q = %d, want %d", name, len(state.snapshot.Hosts[name]), len(wantAddresses))
+		}
+	}
+
+	clone := cloneDNSMemorySnapshot(state.snapshot)
+	clone.Hosts["mba32k"][0] = netip.MustParseAddr("100.64.0.9")
+	clone.CaptureDomains[0] = "changed.invalid"
+	if state.snapshot.Hosts["mba32k"][0] != address4 || state.snapshot.CaptureDomains[0] == "changed.invalid" {
+		t.Fatal("snapshot clone shares mutable storage")
+	}
+}
