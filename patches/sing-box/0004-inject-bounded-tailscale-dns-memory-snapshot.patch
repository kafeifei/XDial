+// ReplacePredefined atomically replaces the transport's in-memory records and
+// authoritative suffixes. The caller retains no ownership of supplied values.
+func (t *Transport) ReplacePredefined(predefined map[string][]netip.Addr, owned []string) error {
+	if !t.memoryOnly {
+		return os.ErrPermission
+	}
+	next := make(map[string][]netip.Addr, len(predefined))
+	for domain, addresses := range predefined {
+		canonicalDomain := mDNS.CanonicalName(domain)
+		if canonicalDomain == "." || len(addresses) == 0 {
+			return os.ErrInvalid
+		}
+		clonedAddresses := make([]netip.Addr, len(addresses))
+		for index, address := range addresses {
+			if !address.IsValid() || address.Zone() != "" {
+				return os.ErrInvalid
+			}
+			clonedAddresses[index] = address
+		}
+		next[canonicalDomain] = clonedAddresses
+	}
+	nextOwnedSet := make(map[string]bool, len(owned))
+	for _, domain := range owned {
+		canonicalDomain := mDNS.CanonicalName(domain)
+		if canonicalDomain == "." {
+			return os.ErrInvalid
+		}
+		nextOwnedSet[canonicalDomain] = true
+	}
+	nextOwned := make([]string, 0, len(nextOwnedSet))
+	for domain := range nextOwnedSet {
+		nextOwned = append(nextOwned, domain)
+	}
+	sort.Strings(nextOwned)
+	t.access.Lock()
+	t.predefined = next
+	t.owned = nextOwned
+	t.access.Unlock()
+	return nil
+}
