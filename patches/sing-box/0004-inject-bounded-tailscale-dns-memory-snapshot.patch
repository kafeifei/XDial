+// DNSMemorySnapshot returns one immutable, bounded copy of the endpoint's
+// current DNS ownership and host records. Domain names and addresses stay
+// inside the data-plane process; callers must not log or persist this value.
+func (t *Endpoint) DNSMemorySnapshot() (DNSMemorySnapshot, error) {
+	state := t.dnsMemorySnapshot.Load()
+	if state.errorCode != tailscaleDNSSnapshotValid {
+		switch state.errorCode {
+		case tailscaleDNSSnapshotTooLarge:
+			return DNSMemorySnapshot{}, fmt.Errorf("Tailscale DNS snapshot exceeds safe limits")
+		case tailscaleDNSSnapshotInvalid:
+			return DNSMemorySnapshot{}, fmt.Errorf("Tailscale DNS snapshot is invalid")
+		default:
+			return DNSMemorySnapshot{}, fmt.Errorf("Tailscale DNS snapshot is unavailable")
+		}
+	}
+	return cloneDNSMemorySnapshot(state.snapshot), nil
 }
 
