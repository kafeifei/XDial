--- /dev/null
+++ b/protocol/tailscale/endpoint_xdial_test.go
@@ -0,0 +1,31 @@
+package tailscale
+
+import (
+	"net/netip"
+	"testing"
+
+	"github.com/sagernet/tailscale/wgengine/wgcfg"
+)
+
+func TestXDialPreferredRouteSetExcludesExitDefaults(t *testing.T) {
+	peerAddress := netip.MustParsePrefix("100.100.0.8/32")
+	subnetRoute := netip.MustParsePrefix("10.20.0.0/16")
+	routes := tailscalePreferredRouteSet([]wgcfg.Peer{{
+		AllowedIPs: []netip.Prefix{
+			netip.MustParsePrefix("0.0.0.0/0"),
+			netip.MustParsePrefix("::/0"),
+			peerAddress,
+			subnetRoute,
+		},
+	}})
+
+	if !routes.Contains(peerAddress.Addr()) {
+		t.Fatal("peer address was removed from preferred routes")
+	}
+	if !routes.Contains(netip.MustParseAddr("10.20.1.2")) {
+		t.Fatal("subnet route was removed from preferred routes")
+	}
+	if routes.Contains(netip.MustParseAddr("203.0.113.7")) {
+		t.Fatal("Exit Node default route leaked into preferred routes")
+	}
+}
