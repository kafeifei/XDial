+func TestXDialDNSServiceLookupLoopback(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+	defer cancel()
+	result, err := xdialDNSServiceLookup(ctx, "localhost.", mDNS.TypeA, 3*time.Second)
+	if err != nil {
+		t.Fatal("DNSServiceGetAddrInfo localhost: ", err)
+	}
+	if !containsXDialAddress(result.addresses, netip.MustParseAddr("127.0.0.1")) {
+		t.Fatalf("DNSServiceGetAddrInfo localhost returned %v", result.addresses)
+	}
+}
