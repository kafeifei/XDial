+func TestXDialSystemResolverOptionDoesNotRequireTunFallback(t *testing.T) {
+	transport := &Transport{xdialUseSystemResolver: true}
+	if !transport.xdialUseSystemResolver || transport.fallback {
+		t.Fatal("explicit system resolver must be independent of TUN fallback")
+	}
+}
+
+func TestXDialSystemResolverOptionRoutesPublicQueriesThroughNativeAPI(t *testing.T) {
+	originalLookup := xdialSystemLookup
+	t.Cleanup(func() { xdialSystemLookup = originalLookup })
+	var queriedName string
+	xdialSystemLookup = func(_ context.Context, name string, qtype uint16, _ time.Duration) (xdialLookupResult, error) {
+		queriedName = name
+		if qtype != mDNS.TypeA {
+			t.Fatalf("unexpected query type: %d", qtype)
+		}
+		return xdialLookupResult{
+			addresses: []netip.Addr{netip.MustParseAddr("192.0.2.1")},
+			ttl:       60,
+		}, nil
+	}
+
+	transport := &Transport{xdialUseSystemResolver: true}
+	message := new(mDNS.Msg)
+	message.SetQuestion("service.example.", mDNS.TypeA)
+	response, err := transport.Exchange(context.Background(), message)
+	if err != nil {
+		t.Fatal("native resolver exchange: ", err)
+	}
+	if queriedName != "service.example." || len(response.Answer) != 1 {
+		t.Fatalf("public query did not use native resolver: name=%q response=%v", queriedName, response)
+	}
+}
