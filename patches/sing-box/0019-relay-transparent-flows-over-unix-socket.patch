+func TestXDialRelaySocketGracefulCloseFinishesAndAbortiveCloseDoesNot(t *testing.T) {
+	t.Run("graceful", func(t *testing.T) {
+		server, client := xdialRelayTestPair(t)
+		_, err := server.Write([]byte("reply"))
+		require.NoError(t, err)
+		require.NoError(t, server.Close())
+		frameType, payload := xdialRelayTestReadFrame(t, client)
+		require.Equal(t, xdialRelayFrameData, frameType)
+		require.Equal(t, "reply", string(payload))
+		frameType, _ = xdialRelayTestReadFrame(t, client)
+		require.Equal(t, xdialRelayFrameFin, frameType, "an ordinary close ends the stream cleanly, as a TCP close does")
+		_, err = client.Read(make([]byte, 1))
+		require.ErrorIs(t, err, io.EOF)
+	})
+	t.Run("abortive", func(t *testing.T) {
+		server, client := xdialRelayTestPair(t)
+		_, err := server.Write([]byte("partial"))
+		require.NoError(t, err)
+		// The idiom sing-box and the XDial relay use to reset a TCP socket.
+		require.NoError(t, server.SetLinger(0))
+		require.NoError(t, server.Close())
+		frameType, payload := xdialRelayTestReadFrame(t, client)
+		require.Equal(t, xdialRelayFrameData, frameType)
+		require.Equal(t, "partial", string(payload))
+		_, err = client.Read(make([]byte, 1))
+		require.ErrorIs(t, err, io.EOF, "a reset stream ends without a FIN frame")
+	})
+	t.Run("close under a stalled writer", func(t *testing.T) {
+		server, client := xdialRelayTestPair(t)
+		require.NoError(t, server.SetDeadline(time.Time{}))
+		writeDone := make(chan error, 1)
+		go func() {
+			_, writeErr := server.Write(make([]byte, 8<<20))
+			writeDone <- writeErr
+		}()
+		// Nobody reads, so the writer fills the socket and blocks.
+		time.Sleep(100 * time.Millisecond)
+		closed := make(chan error, 1)
+		go func() { closed <- server.Close() }()
+		select {
+		case err := <-closed:
+			require.NoError(t, err)
+		case <-time.After(xdialRelayTestTimeout):
+			t.Fatal("close waited for a writer that could not finish")
+		}
+		require.ErrorIs(t, <-writeDone, net.ErrClosed)
+		_, err := io.Copy(io.Discard, client)
+		require.NoError(t, err)
+	})
+}
+
+func TestXDialRelaySocketCarriesDatagramsInBand(t *testing.T) {
+	server, client := xdialRelayTestPair(t)
+	packetConn, err := server.ListenPacket(net.ListenConfig{}, context.Background(), "udp4", "127.0.0.1:0")
+	require.NoError(t, err)
+	require.Equal(t, "0.0.0.0:0", packetConn.LocalAddr().String(), "the association has no relay endpoint to announce")
+
+	large := make([]byte, 65769)
+	for index := range large {
+		large[index] = byte(index * 7)
+	}
+	writeDone := make(chan error, 1)
+	go func() {
+		stream := append(xdialRelayTestFrame(xdialRelayFrameData, []byte("first")), xdialRelayTestFrame(xdialRelayFrameData, large)...)
+		stream = append(stream, xdialRelayTestFrame(xdialRelayFrameData, []byte("truncated"))...)
+		_, writeErr := client.Write(stream)
+		writeDone <- writeErr
+	}()
+	buffer := make([]byte, 1<<17)
+	n, addr, err := packetConn.ReadFrom(buffer)
+	require.NoError(t, err)
+	require.Equal(t, "first", string(buffer[:n]), "one frame is one datagram")
+	require.NotNil(t, addr)
+	n, _, err = packetConn.ReadFrom(buffer)
+	require.NoError(t, err)
+	require.Equal(t, large, buffer[:n])
+	n, _, err = packetConn.ReadFrom(buffer[:4])
+	require.NoError(t, err)
+	require.Equal(t, "trun", string(buffer[:n]), "a short buffer cuts the datagram, as a UDP socket does")
+	require.NoError(t, <-writeDone)
+
+	// A deadline between two pieces of one datagram must not lose the frame.
+	frame := xdialRelayTestFrame(xdialRelayFrameData, []byte("resumed"))
+	_, err = client.Write(frame[:7])
+	require.NoError(t, err)
+	require.NoError(t, packetConn.SetReadDeadline(time.Now().Add(50*time.Millisecond)))
+	_, _, err = packetConn.ReadFrom(buffer)
+	require.True(t, E.IsTimeout(err), "expected a timeout, got %v", err)
+	_, err = client.Write(frame[7:])
+	require.NoError(t, err)
+	require.NoError(t, packetConn.SetReadDeadline(time.Now().Add(xdialRelayTestTimeout)))
+	n, _, err = packetConn.ReadFrom(buffer)
+	require.NoError(t, err)
+	require.Equal(t, "resumed", string(buffer[:n]))
+
+	_, err = packetConn.WriteTo([]byte("reply"), nil)
+	require.NoError(t, err)
+	frameType, payload := xdialRelayTestReadFrame(t, client)
+	require.Equal(t, xdialRelayFrameData, frameType)
+	require.Equal(t, "reply", string(payload))
+	_, err = packetConn.WriteTo(make([]byte, xdialRelayMaxFramePayload+1), nil)
+	require.ErrorIs(t, err, syscall.EMSGSIZE)
+
+	require.NoError(t, client.Close())
+	_, _, err = packetConn.ReadFrom(buffer)
+	require.ErrorIs(t, err, syscall.ECONNRESET, "an association ends with its control connection")
+}
