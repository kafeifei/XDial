+	"strings"
+	"sync"
+	"syscall"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/adapter/inbound"
+	"github.com/sagernet/sing-box/common/uot"
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/log"
+	"github.com/sagernet/sing-box/option"
+	"github.com/sagernet/sing/common"
+	"github.com/sagernet/sing/common/auth"
+	"github.com/sagernet/sing/common/buf"
+	E "github.com/sagernet/sing/common/exceptions"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+
+	"github.com/stretchr/testify/require"
+)
+
+const xdialRelayTestTimeout = 5 * time.Second
+
+// xdialRelayTestDirectory is a short private directory: the temporary
+// directory Go hands to tests is already longer than a socket path may be.
+func xdialRelayTestDirectory(t *testing.T) string {
+	t.Helper()
+	directory, err := os.MkdirTemp("/tmp", "xdr")
+	require.NoError(t, err)
+	t.Cleanup(func() { os.RemoveAll(directory) })
+	return directory
+}
+
+// xdialRelayTestPair is one relay socket connection: the framed server end and
+// the raw client end the Provider would hold.
+func xdialRelayTestPair(t *testing.T) (*xdialRelayConn, *net.UnixConn) {
+	t.Helper()
+	path := filepath.Join(xdialRelayTestDirectory(t), "relay")
+	listener, err := listenXDialRelaySocket(path)
+	require.NoError(t, err)
+	t.Cleanup(func() { listener.Close() })
+	client, err := net.DialUnix("unix", nil, &net.UnixAddr{Name: path, Net: "unix"})
+	require.NoError(t, err)
+	t.Cleanup(func() { client.Close() })
+	server, err := listener.AcceptUnix()
+	require.NoError(t, err)
+	relayConn := newXDialRelayConn(server)
+	t.Cleanup(func() { relayConn.Close() })
+	deadline := time.Now().Add(xdialRelayTestTimeout)
+	require.NoError(t, client.SetDeadline(deadline))
+	require.NoError(t, relayConn.SetDeadline(deadline))
+	return relayConn, client
+}
+
+func xdialRelayTestFrame(frameType byte, payload []byte) []byte {
+	frame := []byte{frameType, byte(len(payload) >> 16), byte(len(payload) >> 8), byte(len(payload))}
+	return append(frame, payload...)
+}
+
+func xdialRelayTestReadFrame(t *testing.T, conn net.Conn) (byte, []byte) {
+	t.Helper()
+	var header [xdialRelayFrameHeaderLength]byte
+	_, err := io.ReadFull(conn, header[:])
+	require.NoError(t, err)
+	payload := make([]byte, int(header[1])<<16|int(header[2])<<8|int(header[3]))
+	_, err = io.ReadFull(conn, payload)
+	require.NoError(t, err)
+	return header[0], payload
+}
+
+func TestXDialRelaySocketFramesBothDirectionsAndEndsWithFinish(t *testing.T) {
+	server, client := xdialRelayTestPair(t)
+
+	// One frame may arrive in pieces, and one read may hold several frames.
+	stream := append(xdialRelayTestFrame(xdialRelayFrameData, []byte("hel")), xdialRelayTestFrame(xdialRelayFrameData, []byte("lo"))...)
+	stream = append(stream, xdialRelayTestFrame(xdialRelayFrameFin, nil)...)
+	_, err := client.Write(stream[:5])
+	require.NoError(t, err)
+	_, err = client.Write(stream[5:])
+	require.NoError(t, err)
+	received, err := io.ReadAll(server)
+	require.NoError(t, err, "a FIN frame is a clean end of stream")
+	require.Equal(t, "hello", string(received))
+
+	large := make([]byte, xdialRelayStreamChunk*2+1)
+	for index := range large {
+		large[index] = byte(index)
+	}
+	writeDone := make(chan error, 1)
+	go func() {
+		_, writeErr := server.Write(large)
+		if writeErr == nil {
+			writeErr = server.CloseWrite()
+		}
+		writeDone <- writeErr
+	}()
+	var reassembled []byte
+	for {
+		frameType, payload := xdialRelayTestReadFrame(t, client)
+		if frameType == xdialRelayFrameFin {
+			require.Empty(t, payload)
+			break
+		}
+		require.Equal(t, xdialRelayFrameData, frameType)
+		require.LessOrEqual(t, len(payload), xdialRelayStreamChunk)
+		reassembled = append(reassembled, payload...)
+	}
+	require.NoError(t, <-writeDone)
+	require.Equal(t, large, reassembled)
+
+	// The socket itself stays open after the FIN frame: the other direction
+	// is still in use, and only the frame means anything.
+	_, err = server.Write([]byte("late"))
+	require.ErrorIs(t, err, syscall.EPIPE)
+	require.NoError(t, server.CloseWrite(), "a second half-close is a no-op")
+}
