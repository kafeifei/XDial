+func TestXDialRelaySocketReportsStreamWithoutFinishAsReset(t *testing.T) {
+	for name, tail := range map[string][]byte{
+		"at a frame boundary": nil,
+		"inside a header":     {xdialRelayFrameData, 0x00},
+		"inside a payload":    xdialRelayTestFrame(xdialRelayFrameData, []byte("partial"))[:6],
+	} {
+		t.Run(name, func(t *testing.T) {
+			server, client := xdialRelayTestPair(t)
+			_, err := client.Write(append(xdialRelayTestFrame(xdialRelayFrameData, []byte("data")), tail...))
+			require.NoError(t, err)
+			require.NoError(t, client.Close())
+
+			received := make([]byte, 4)
+			_, err = io.ReadFull(server, received)
+			require.NoError(t, err, "bytes sent before the cut still arrive")
+			require.Equal(t, "data", string(received))
+			_, err = io.ReadAll(server)
+			require.ErrorIs(t, err, syscall.ECONNRESET)
+			var opErr *net.OpError
+			require.ErrorAs(t, err, &opErr)
+			require.Equal(t, "read", opErr.Op)
+			require.Equal(t, server.LocalAddr().String(), opErr.Source.String())
+			require.Equal(t, server.RemoteAddr().String(), opErr.Addr.String())
+		})
+	}
+}
