diff --git a/protocol/socks/xdial_relay_socket.go b/protocol/socks/xdial_relay_socket.go
new file mode 100644
--- /dev/null
+++ b/protocol/socks/xdial_relay_socket.go
@@ -0,0 +1,417 @@
+package socks
+
+import (
+	std_bufio "bufio"
+	"context"
+	"errors"
+	"io"
+	"net"
+	"os"
+	"path/filepath"
+	"sync"
+	"sync/atomic"
+	"syscall"
+	"time"
+
+	E "github.com/sagernet/sing/common/exceptions"
+)
+
+// XDial relay socket.
+//
+// The transparent proxy Provider and sing-box share one process. Relaying every
+// flow over loopback TCP made the kernel hand each one an ephemeral port, and a
+// long-lived flow kept that port away from whatever program meant to listen on
+// it. With xdial_relay_socket the inbound listens on a Unix stream socket and
+// takes no port.
+//
+// A Unix stream socket cannot say how it ended: a peer that was cut looks the
+// same as one that finished. Both directions are therefore framed, and a
+// direction that finished cleanly says so with a FIN frame. A stream that ends
+// without one was cut, which is what a TCP reset used to report.
+//
+//	+------+--------+---------+
+//	| type | length | payload |
+//	|  1   |   3    | length  |   length is big-endian
+//	+------+--------+---------+
+//
+//	0x01 DATA  one or more payload bytes
+//	0x02 FIN   no payload; this direction finished and sends nothing more
+//
+// A SOCKS UDP association takes no port either. Once UDP ASSOCIATE has been
+// answered, every DATA frame on its control connection is one SOCKS5 UDP
+// datagram, in both directions.
+const (
+	xdialRelayFrameData byte = 0x01
+	xdialRelayFrameFin  byte = 0x02
+
+	xdialRelayFrameHeaderLength = 4
+	// The largest SOCKS5 UDP datagram is 65507 payload bytes behind a header
+	// of at most 262 bytes.
+	xdialRelayMaxFramePayload = 1 << 17
+	// A byte stream is cut into frames of this size at most, so the Provider
+	// never has to hold much of one before it can pass the bytes on.
+	xdialRelayStreamChunk = 32 << 10
+	// The sender's buffer bounds what a Unix stream socket queues for its peer.
+	xdialRelaySocketBuffer = 256 << 10
+	xdialRelayReaderSize   = 4 << 10
+	// A graceful close announces itself with a FIN frame. It must not wait on a
+	// peer that stopped reading.
+	xdialRelayCloseTimeout = 100 * time.Millisecond
+	// sockaddr_un.sun_path holds 104 bytes on Darwin, 108 on Linux, including
+	// the terminating NUL.
+	xdialRelaySocketPathLimit = 103
+)
+
+var errXDialRelayFrame = E.New("invalid XDial relay frame")
+
+// Both ends of a relay connection are this process. The addresses only keep
+// SOCKS replies and connection metadata well formed; they name no socket.
+var (
+	xdialRelayStreamAddr net.Addr = &net.TCPAddr{IP: net.IPv4(127, 0, 0, 1)}
+	xdialRelayPacketAddr net.Addr = &net.UDPAddr{IP: net.IPv4zero}
+	xdialRelayPacketPeer net.Addr = &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1)}
+)
+
+// listenXDialRelaySocket binds the relay socket at path, replacing a socket a
+// previous process left behind. Only the owner may connect, and the entry
+// still asks every connection for the session credentials.
+func listenXDialRelaySocket(path string) (*net.UnixListener, error) {
+	if !filepath.IsAbs(path) || filepath.Clean(path) != path {
+		return nil, E.New("XDial relay socket path is not an absolute clean path")
+	}
+	if len(path) > xdialRelaySocketPathLimit {
+		return nil, E.New("XDial relay socket path is too long: ", len(path), " bytes")
+	}
+	info, err := os.Lstat(path)
+	switch {
+	case err == nil:
+		if info.Mode()&os.ModeSocket == 0 {
+			return nil, E.New("XDial relay socket path is occupied by another file")
+		}
+		err = os.Remove(path)
+		if err != nil {
+			return nil, E.Cause(err, "remove stale XDial relay socket")
+		}
+	case !os.IsNotExist(err):
+		return nil, E.Cause(err, "inspect XDial relay socket path")
+	}
+	listener, err := net.ListenUnix("unix", &net.UnixAddr{Name: path, Net: "unix"})
+	if err != nil {
+		return nil, E.Cause(err, "listen XDial relay socket")
+	}
+	listener.SetUnlinkOnClose(true)
+	// Connecting needs write permission on the socket file. The directory is
+	// private to the owner already; this keeps the file from depending on it.
+	err = os.Chmod(path, 0o600)
+	if err != nil {
+		listener.Close()
+		return nil, E.Cause(err, "restrict XDial relay socket")
+	}
+	return listener, nil
+}
+
+type xdialRelayTransport interface {
+	net.Conn
+	SetReadBuffer(bytes int) error
+	SetWriteBuffer(bytes int) error
+}
+
+// xdialRelayConn is the framed stream on one relay socket connection. It hides
+// the socket on purpose: anything that reached it would read and write past
+// the framing.
+type xdialRelayConn struct {
+	conn   net.Conn
+	reader *std_bufio.Reader
+
+	readAccess    sync.Mutex
+	readRemaining int
+	readFinished  bool
+	readErr       error
+	packet        []byte
+	packetLength  int
+	packetFilled  int
+
+	writeAccess   sync.Mutex
+	writeFinished bool
+	writeErr      error
+
+	abortive  atomic.Bool
+	closeOnce sync.Once
+	closeErr  error
+}
+
+func newXDialRelayConn(conn net.Conn) *xdialRelayConn {
+	if transport, isTransport := conn.(xdialRelayTransport); isTransport {
+		_ = transport.SetReadBuffer(xdialRelaySocketBuffer)
+		_ = transport.SetWriteBuffer(xdialRelaySocketBuffer)
+	}
+	return &xdialRelayConn{
+		conn:   conn,
+		reader: std_bufio.NewReaderSize(conn, xdialRelayReaderSize),
+	}
+}
+
+func (c *xdialRelayConn) Read(p []byte) (n int, err error) {
+	if len(p) == 0 {
+		return 0, nil
+	}
+	c.readAccess.Lock()
+	defer c.readAccess.Unlock()
+	for c.readRemaining == 0 {
+		length, finished, err := c.readHeader()
+		if err != nil {
+			return 0, err
+		}
+		if finished {
+			return 0, io.EOF
+		}
+		c.readRemaining = length
+	}
+	if len(p) > c.readRemaining {
+		p = p[:c.readRemaining]
+	}
+	for n == 0 {
+		n, err = c.reader.Read(p)
+		if n == 0 && err != nil {
+			return 0, c.failRead(err)
+		}
+	}
+	c.readRemaining -= n
+	return n, nil
+}
+
+// readFrame reads one whole DATA frame as a datagram. A datagram longer than p
+// is cut short, as a UDP socket would.
+func (c *xdialRelayConn) readFrame(p []byte) (n int, err error) {
+	c.readAccess.Lock()
+	defer c.readAccess.Unlock()
+	if c.readRemaining != 0 {
+		return 0, c.failRead(errXDialRelayFrame)
+	}
+	if c.packetLength == 0 {
+		length, finished, err := c.readHeader()
+		if err != nil {
+			return 0, err
+		}
+		if finished {
+			return 0, io.EOF
+		}
+		if cap(c.packet) < length {
+			c.packet = make([]byte, length)
+		}
+		c.packet = c.packet[:length]
+		c.packetLength = length
+		c.packetFilled = 0
+	}
+	// A deadline may fire between two pieces of a datagram. The pieces read so
+	// far stay here, so the next read resumes instead of losing the frame.
+	for c.packetFilled < c.packetLength {
+		read, err := c.reader.Read(c.packet[c.packetFilled:c.packetLength])
+		c.packetFilled += read
+		if err != nil && c.packetFilled < c.packetLength {
+			return 0, c.failRead(err)
+		}
+	}
+	n = copy(p, c.packet[:c.packetLength])
+	c.packetLength = 0
+	c.packetFilled = 0
+	return n, nil
+}
+
+// readHeader reads the next frame header and reports the payload length of a
+// DATA frame, or that the peer finished. Callers hold readAccess.
+func (c *xdialRelayConn) readHeader() (length int, finished bool, err error) {
+	if c.readFinished {
+		return 0, true, nil
+	}
+	if c.readErr != nil {
+		return 0, false, c.readErr
+	}
+	// Peek leaves a partial header buffered, so a deadline costs nothing.
+	header, err := c.reader.Peek(xdialRelayFrameHeaderLength)
+	if err != nil {
+		return 0, false, c.failRead(err)
+	}
+	frameType := header[0]
+	length = int(header[1])<<16 | int(header[2])<<8 | int(header[3])
+	_, _ = c.reader.Discard(xdialRelayFrameHeaderLength)
+	switch {
+	case frameType == xdialRelayFrameData && length > 0 && length <= xdialRelayMaxFramePayload:
+		return length, false, nil
+	case frameType == xdialRelayFrameFin && length == 0:
+		c.readFinished = true
+		return 0, true, nil
+	default:
+		return 0, false, c.failRead(errXDialRelayFrame)
+	}
+}
+
+// failRead turns the end of a read into what the caller should see. A stream
+// that stops short of its FIN frame was cut, and so was one that stopped making
+// sense. Deadlines pass through and may be retried.
+func (c *xdialRelayConn) failRead(err error) error {
+	if isXDialRelayTimeout(err) {
+		return c.opError("read", err)
+	}
+	if !errors.Is(err, net.ErrClosed) {
+		err = syscall.ECONNRESET
+	}
+	c.readErr = c.opError("read", err)
+	return c.readErr
+}
+
+func (c *xdialRelayConn) Write(p []byte) (n int, err error) {
+	c.writeAccess.Lock()
+	defer c.writeAccess.Unlock()
+	for len(p) > 0 {
+		chunk := p
+		if len(chunk) > xdialRelayStreamChunk {
+			chunk = chunk[:xdialRelayStreamChunk]
+		}
+		err = c.writeFrameLocked(xdialRelayFrameData, chunk)
+		if err != nil {
+			return n, err
+		}
+		n += len(chunk)
+		p = p[len(chunk):]
+	}
+	return n, nil
+}
+
+// writeFrame writes p as one DATA frame, which is one datagram.
+func (c *xdialRelayConn) writeFrame(p []byte) error {
+	if len(p) == 0 || len(p) > xdialRelayMaxFramePayload {
+		return c.opError("write", syscall.EMSGSIZE)
+	}
+	c.writeAccess.Lock()
+	defer c.writeAccess.Unlock()
+	return c.writeFrameLocked(xdialRelayFrameData, p)
+}
+
+func (c *xdialRelayConn) writeFrameLocked(frameType byte, payload []byte) error {
+	if c.writeErr != nil {
+		return c.writeErr
+	}
+	if c.writeFinished {
+		return c.opError("write", syscall.EPIPE)
+	}
+	header := [xdialRelayFrameHeaderLength]byte{
+		frameType,
+		byte(len(payload) >> 16),
+		byte(len(payload) >> 8),
+		byte(len(payload)),
+	}
+	buffers := net.Buffers{header[:]}
+	if len(payload) > 0 {
+		buffers = append(buffers, payload)
+	}
+	_, err := buffers.WriteTo(c.conn)
+	if err != nil {
+		// Part of a frame may be on the wire; nothing after it can be read.
+		c.writeErr = c.opError("write", err)
+		return c.writeErr
+	}
+	if frameType == xdialRelayFrameFin {
+		c.writeFinished = true
+	}
+	return nil
+}
+
+// CloseWrite tells the peer that this direction finished cleanly. The socket
+// stays open both ways: only the frame carries the meaning.
+func (c *xdialRelayConn) CloseWrite() error {
+	c.writeAccess.Lock()
+	defer c.writeAccess.Unlock()
+	if c.writeFinished {
+		return nil
+	}
+	return c.writeFrameLocked(xdialRelayFrameFin, nil)
+}
+
+// SetLinger keeps the TCP idiom the rest of sing-box already uses for an
+// abortive close: SetLinger(0) followed by Close ends the stream without a FIN
+// frame, and the peer reports a reset.
+func (c *xdialRelayConn) SetLinger(sec int) error {
+	c.abortive.Store(sec == 0)
+	return nil
+}
+
+func (c *xdialRelayConn) Close() error {
+	c.closeOnce.Do(func() {
+		// A writer blocked on a stalled peer holds the lock. Closing under it
+		// is not a clean end, so there is no FIN frame to wait for.
+		if !c.abortive.Load() && c.writeAccess.TryLock() {
+			if !c.writeFinished && c.writeErr == nil {
+				_ = c.conn.SetWriteDeadline(time.Now().Add(xdialRelayCloseTimeout))
+				_ = c.writeFrameLocked(xdialRelayFrameFin, nil)
+			}
+			c.writeAccess.Unlock()
+		}
+		c.closeErr = c.conn.Close()
+	})
+	return c.closeErr
+}
+
+func (c *xdialRelayConn) LocalAddr() net.Addr  { return xdialRelayStreamAddr }
+func (c *xdialRelayConn) RemoteAddr() net.Addr { return xdialRelayStreamAddr }
+
+func (c *xdialRelayConn) SetDeadline(t time.Time) error      { return c.conn.SetDeadline(t) }
+func (c *xdialRelayConn) SetReadDeadline(t time.Time) error  { return c.conn.SetReadDeadline(t) }
+func (c *xdialRelayConn) SetWriteDeadline(t time.Time) error { return c.conn.SetWriteDeadline(t) }
+
+// opError reports err as an error of this connection, so the relay can tell a
+// failure of the inbound side from one of the upstream.
+func (c *xdialRelayConn) opError(op string, err error) error {
+	var opErr *net.OpError
+	if errors.As(err, &opErr) {
+		err = opErr.Err
+	}
+	return &net.OpError{
+		Op:     op,
+		Net:    "unix",
+		Source: c.LocalAddr(),
+		Addr:   c.RemoteAddr(),
+		Err:    err,
+	}
+}
+
+func isXDialRelayTimeout(err error) bool {
+	var netErr net.Error
+	return errors.As(err, &netErr) && netErr.Timeout()
+}
+
+// ListenPacket answers UDP ASSOCIATE on this connection. The association gets
+// no socket of its own: its datagrams travel as frames on the connection that
+// asked for it.
+func (c *xdialRelayConn) ListenPacket(net.ListenConfig, context.Context, string, string) (net.PacketConn, error) {
+	return &xdialRelayPacketConn{conn: c}, nil
+}
+
+type xdialRelayPacketConn struct {
+	conn *xdialRelayConn
+}
+
+func (c *xdialRelayPacketConn) ReadFrom(p []byte) (n int, addr net.Addr, err error) {
+	n, err = c.conn.readFrame(p)
+	if err != nil {
+		return 0, nil, err
+	}
+	return n, xdialRelayPacketPeer, nil
+}
+
+func (c *xdialRelayPacketConn) WriteTo(p []byte, _ net.Addr) (n int, err error) {
+	err = c.conn.writeFrame(p)
+	if err != nil {
+		return 0, err
+	}
+	return len(p), nil
+}
+
+func (c *xdialRelayPacketConn) Close() error        { return c.conn.Close() }
+func (c *xdialRelayPacketConn) LocalAddr() net.Addr { return xdialRelayPacketAddr }
+
+func (c *xdialRelayPacketConn) SetDeadline(t time.Time) error     { return c.conn.SetDeadline(t) }
+func (c *xdialRelayPacketConn) SetReadDeadline(t time.Time) error { return c.conn.SetReadDeadline(t) }
+func (c *xdialRelayPacketConn) SetWriteDeadline(t time.Time) error {
+	return c.conn.SetWriteDeadline(t)
+}
