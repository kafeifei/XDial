+func TestXDialRelaySocketInboundRelaysTCPWithFinishAndReset(t *testing.T) {
+	relayInbound, router, path := xdialRelayTestInbound(t)
+	require.NoError(t, relayInbound.Start(adapter.StartStateStart))
+	t.Cleanup(func() { relayInbound.Close() })
+
+	connect := func(port byte) *xdialRelayTestClient {
+		client := xdialRelayTestDial(t, path)
+		require.Zero(t, client.authenticate("secret"))
+		client.send(0x05, 0x01, 0x00, 0x01, 192, 0, 2, 1, 0x00, port)
+		return client
+	}
+
+	clean := connect(80)
+	clean.send([]byte("ping")...)
+	require.Equal(t, []byte{0x05, 0x00, 0x00, 0x01, 127, 0, 0, 1, 0, 0}, clean.receive(10), "the reply names no port: the relay took none")
+	require.Equal(t, "ping", string(clean.receive(4)))
+	_, err := clean.conn.Write(xdialRelayTestFrame(xdialRelayFrameFin, nil))
+	require.NoError(t, err)
+	frameType, _ := xdialRelayTestReadFrame(t, clean.conn)
+	require.Equal(t, xdialRelayFrameFin, frameType, "an upstream that finished ends the stream with a FIN frame")
+
+	reset := connect(7)
+	reset.send([]byte("ping")...)
+	reset.receive(10)
+	require.Equal(t, "ping", string(reset.receive(4)))
+	_, err = reset.conn.Write(xdialRelayTestFrame(xdialRelayFrameFin, nil))
+	require.NoError(t, err)
+	_, err = reset.conn.Read(make([]byte, 1))
+	require.ErrorIs(t, err, io.EOF, "an upstream that failed ends the stream without a FIN frame")
+
+	refused := connect(9)
+	reply := refused.receive(10)
+	require.Equal(t, []byte{0x05, 0x05}, reply[:2], "a refused connection is still answered in SOCKS")
+
+	connections, _ := router.routed()
+	require.Len(t, connections, 3)
+	require.Equal(t, "transparent-proxy-in", connections[0].Inbound)
+	require.Equal(t, M.ParseSocksaddr("192.0.2.1:80"), connections[0].Destination)
+	require.Equal(t, "127.0.0.1:0", connections[0].Source.String())
+}
