+func TestXDialRelaySocketRejectsUnframedAndMalformedStreams(t *testing.T) {
+	for name, stream := range map[string][]byte{
+		"plain SOCKS greeting": {0x05, 0x01, 0x00, 0x00},
+		"empty DATA frame":     xdialRelayTestFrame(xdialRelayFrameData, nil),
+		"FIN with a payload":   xdialRelayTestFrame(xdialRelayFrameFin, []byte{0x00}),
+		"oversized DATA frame": {xdialRelayFrameData, 0x02, 0x00, 0x01},
+	} {
+		t.Run(name, func(t *testing.T) {
+			server, client := xdialRelayTestPair(t)
+			_, err := client.Write(stream)
+			require.NoError(t, err)
+			_, err = server.Read(make([]byte, 16))
+			require.ErrorIs(t, err, syscall.ECONNRESET)
+			_, err = server.Read(make([]byte, 16))
+			require.ErrorIs(t, err, syscall.ECONNRESET, "a broken stream stays broken")
+		})
+	}
+}
