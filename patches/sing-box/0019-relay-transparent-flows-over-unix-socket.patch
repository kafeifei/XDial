+// xdialRelayTestClient speaks the relay socket's client side: SOCKS5 with
+// username and password, every byte inside DATA frames.
+type xdialRelayTestClient struct {
+	t    *testing.T
+	conn *net.UnixConn
+	rest []byte
+}
+
+func xdialRelayTestDial(t *testing.T, path string) *xdialRelayTestClient {
+	t.Helper()
+	conn, err := net.DialUnix("unix", nil, &net.UnixAddr{Name: path, Net: "unix"})
+	require.NoError(t, err)
+	t.Cleanup(func() { conn.Close() })
+	require.NoError(t, conn.SetDeadline(time.Now().Add(xdialRelayTestTimeout)))
+	return &xdialRelayTestClient{t: t, conn: conn}
+}
+
+func (c *xdialRelayTestClient) send(payload ...byte) {
+	c.t.Helper()
+	_, err := c.conn.Write(xdialRelayTestFrame(xdialRelayFrameData, payload))
+	require.NoError(c.t, err)
+}
+
+func (c *xdialRelayTestClient) receive(length int) []byte {
+	c.t.Helper()
+	for len(c.rest) < length {
+		frameType, payload := xdialRelayTestReadFrame(c.t, c.conn)
+		require.Equal(c.t, xdialRelayFrameData, frameType)
+		c.rest = append(c.rest, payload...)
+	}
+	received := c.rest[:length]
+	c.rest = c.rest[length:]
+	return received
+}
+
+func (c *xdialRelayTestClient) authenticate(password string) byte {
+	c.t.Helper()
+	c.send(0x05, 0x01, 0x02)
+	require.Equal(c.t, []byte{0x05, 0x02}, c.receive(2))
+	request := append([]byte{0x01, byte(len("session"))}, "session"...)
+	request = append(request, byte(len(password)))
+	request = append(request, password...)
+	c.send(request...)
+	reply := c.receive(2)
+	require.Equal(c.t, byte(0x01), reply[0])
+	return reply[1]
+}
