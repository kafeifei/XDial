+func xdialRelayTestInbound(t *testing.T) (*Inbound, *xdialRelayTestRouter, string) {
+	t.Helper()
+	path := filepath.Join(xdialRelayTestDirectory(t), "relay")
+	router := &xdialRelayTestRouter{}
+	logger := log.NewNOPFactory().NewLogger("test")
+	relayInbound := &Inbound{
+		Adapter:          inbound.NewAdapter(C.TypeSOCKS, "transparent-proxy-in"),
+		router:           uot.NewRouter(router, logger),
+		logger:           logger,
+		authenticator:    auth.NewAuthenticator([]auth.User{{Username: "session", Password: "secret"}}),
+		udpTimeout:       xdialRelayTestTimeout,
+		ctx:              context.Background(),
+		xdialRelaySocket: path,
+	}
+	return relayInbound, router, path
+}
