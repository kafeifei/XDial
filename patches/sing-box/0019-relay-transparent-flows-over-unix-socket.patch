+func TestXDialRelaySocketListenerOwnsItsSocketFile(t *testing.T) {
+	directory := xdialRelayTestDirectory(t)
+	path := filepath.Join(directory, "relay")
+
+	stale, err := net.ListenUnix("unix", &net.UnixAddr{Name: path, Net: "unix"})
+	require.NoError(t, err)
+	stale.SetUnlinkOnClose(false)
+	require.NoError(t, stale.Close())
+	_, err = os.Lstat(path)
+	require.NoError(t, err, "the stale socket of a crashed process is still on disk")
+
+	listener, err := listenXDialRelaySocket(path)
+	require.NoError(t, err, "a stale socket is replaced")
+	info, err := os.Lstat(path)
+	require.NoError(t, err)
+	require.NotZero(t, info.Mode()&os.ModeSocket)
+	require.Equal(t, os.FileMode(0o600), info.Mode().Perm(), "only the owner may connect")
+	require.NoError(t, listener.Close())
+	_, err = os.Lstat(path)
+	require.True(t, os.IsNotExist(err), "closing the listener removes the socket file")
+
+	require.NoError(t, os.WriteFile(path, []byte("not a socket"), 0o600))
+	_, err = listenXDialRelaySocket(path)
+	require.Error(t, err, "a file that is not a socket is never removed")
+	content, err := os.ReadFile(path)
+	require.NoError(t, err)
+	require.Equal(t, "not a socket", string(content))
+
+	_, err = listenXDialRelaySocket("relative/relay")
+	require.Error(t, err)
+	_, err = listenXDialRelaySocket(filepath.Join(directory, strings.Repeat("a", xdialRelaySocketPathLimit)))
+	require.Error(t, err, "a path the kernel would truncate is refused")
+}
