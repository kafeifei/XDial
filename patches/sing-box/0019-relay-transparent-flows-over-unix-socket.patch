+type xdialRelayTestRouter struct {
+	access      sync.Mutex
+	connections []adapter.InboundContext
+	packets     []adapter.InboundContext
+}
+
+func (r *xdialRelayTestRouter) RouteConnection(context.Context, net.Conn, adapter.InboundContext) error {
+	return os.ErrInvalid
+}
+
+func (r *xdialRelayTestRouter) RoutePacketConnection(context.Context, N.PacketConn, adapter.InboundContext) error {
+	return os.ErrInvalid
+}
+
+// RouteConnectionEx echoes the stream and forwards the application's
+// half-close, unless the destination asks for the upstream to fail.
+func (r *xdialRelayTestRouter) RouteConnectionEx(_ context.Context, conn net.Conn, metadata adapter.InboundContext, _ N.CloseHandlerFunc) {
+	r.access.Lock()
+	r.connections = append(r.connections, metadata)
+	r.access.Unlock()
+	go func() {
+		if metadata.Destination.Port == 9 {
+			N.CloseOnHandshakeFailure(conn, nil, syscall.ECONNREFUSED)
+			return
+		}
+		// The connection arrives behind the deferred SOCKS reply, as it does
+		// in the connection manager, which looks through it the same way.
+		_, err := io.Copy(conn, conn)
+		if err != nil || metadata.Destination.Port == 7 {
+			lingerConn, _ := common.Cast[interface{ SetLinger(sec int) error }](conn)
+			lingerConn.SetLinger(0)
+			conn.Close()
+			return
+		}
+		writeCloser, _ := common.Cast[N.WriteCloser](conn)
+		writeCloser.CloseWrite()
+		conn.Close()
+	}()
+}
+
+func (r *xdialRelayTestRouter) RoutePacketConnectionEx(_ context.Context, conn N.PacketConn, metadata adapter.InboundContext, _ N.CloseHandlerFunc) {
+	r.access.Lock()
+	r.packets = append(r.packets, metadata)
+	r.access.Unlock()
+	go func() {
+		defer conn.Close()
+		headroom := N.CalculateFrontHeadroom(conn)
+		for {
+			buffer := buf.NewPacket()
+			destination, err := conn.ReadPacket(buffer)
+			if err != nil {
+				buffer.Release()
+				return
+			}
+			reply := buf.NewSize(headroom + buffer.Len())
+			reply.Resize(headroom, 0)
+			_, _ = reply.Write(buffer.Bytes())
+			buffer.Release()
+			err = conn.WritePacket(reply, destination)
+			if err != nil {
+				return
+			}
+		}
+	}()
+}
+
+func (r *xdialRelayTestRouter) routed() (connections []adapter.InboundContext, packets []adapter.InboundContext) {
+	r.access.Lock()
+	defer r.access.Unlock()
+	return append([]adapter.InboundContext(nil), r.connections...), append([]adapter.InboundContext(nil), r.packets...)
+}
