@@ -0,0 +1,25 @@
+package adapter
+
+import (
+	"github.com/sagernet/sing/common"
+	M "github.com/sagernet/sing/common/metadata"
+)
+
+// XDialSourcePortFor returns the application socket's local port for the
+// flow's own packet connection to destination, or zero. Lookups made while
+// routing the flow carry the same metadata, and their sockets must never take
+// the port the flow needs.
+func (c *InboundContext) XDialSourcePortFor(destination M.Socksaddr) uint16 {
+	if c == nil || c.XDialSourcePort == 0 {
+		return 0
+	}
+	if destination.Port != c.Destination.Port {
+		return 0
+	}
+	if c.Destination.IsDomain() ||
+		destination.Addr == c.Destination.Addr ||
+		common.Contains(c.DestinationAddresses, destination.Addr) {
+		return c.XDialSourcePort
+	}
+	return 0
+}
