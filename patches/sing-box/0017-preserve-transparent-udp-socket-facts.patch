new file mode 100644
--- /dev/null
+++ b/protocol/direct/xdial_source_port_test.go
@@ -0,0 +1,90 @@
+package direct
+
+import (
+	"context"
+	"net"
+	"syscall"
+	"testing"
+
+	"github.com/sagernet/sing-box/common/dialer"
+	"github.com/sagernet/sing-box/option"
+	M "github.com/sagernet/sing/common/metadata"
+
+	"github.com/stretchr/testify/require"
+	"golang.org/x/sys/unix"
+)
+
+func TestXDialSourcePortDialerOptionsKeepBaseAndInterface(t *testing.T) {
+	base := option.DialerOptions{
+		AbstractDialerOptions: option.AbstractDialerOptions{
+			DomainResolver: &option.DomainResolveOptions{Server: "xdial-native-dns"},
+		},
+	}
+	options := xdialSourcePortDialerOptions(base, "en0", 5901)
+	require.Equal(t, uint16(5901), options.UDPBindPort)
+	require.True(t, options.ReuseAddr)
+	require.Equal(t, "en0", options.BindInterface)
+	require.Equal(t, "xdial-native-dns", options.DomainResolver.Server)
+	require.Zero(t, base.UDPBindPort)
+	require.False(t, base.ReuseAddr)
+
+	unbound := xdialSourcePortDialerOptions(base, "", 5900)
+	require.Empty(t, unbound.BindInterface)
+}
+
+func xdialApplicationSocket(t *testing.T, address string, share bool) uint16 {
+	t.Helper()
+	listenConfig := net.ListenConfig{Control: func(_, _ string, raw syscall.RawConn) error {
+		if !share {
+			return nil
+		}
+		var optionErr error
+		err := raw.Control(func(fd uintptr) {
+			optionErr = unix.SetsockoptInt(int(fd), unix.SOL_SOCKET, unix.SO_REUSEADDR, 1)
+			if optionErr == nil {
+				optionErr = unix.SetsockoptInt(int(fd), unix.SOL_SOCKET, unix.SO_REUSEPORT, 1)
+			}
+		})
+		if err != nil {
+			return err
+		}
+		return optionErr
+	}}
+	conn, err := listenConfig.ListenPacket(context.Background(), "udp4", address+":0")
+	require.NoError(t, err)
+	t.Cleanup(func() { conn.Close() })
+	return uint16(conn.LocalAddr().(*net.UDPAddr).Port)
+}
+
+func xdialListenOnSourcePort(sourcePort uint16) (net.PacketConn, error) {
+	portDialer, err := dialer.NewDefault(context.Background(), xdialSourcePortDialerOptions(option.DialerOptions{}, "", sourcePort))
+	if err != nil {
+		return nil, err
+	}
+	return portDialer.ListenPacket(context.Background(), M.ParseSocksaddrHostPort("127.0.0.1", 9))
+}
+
+// Screen Sharing's media sockets share their ports: the viewer binds the
+// wildcard address, the shared Mac its own address. The Direct socket joins
+// either so the peer's datagrams to that port have a receiver. A wildcard port
+// the application holds exclusively refuses the bind, and the flow keeps an
+// ephemeral port.
+func TestXDialSourcePortDialerJoinsTheApplicationPort(t *testing.T) {
+	for name, application := range map[string]struct {
+		address string
+		share   bool
+	}{
+		"shared wildcard":         {"0.0.0.0", true},
+		"shared specific address": {"127.0.0.1", true},
+	} {
+		sourcePort := xdialApplicationSocket(t, application.address, application.share)
+		conn, err := xdialListenOnSourcePort(sourcePort)
+		require.NoError(t, err, name)
+		require.Equal(t, int(sourcePort), conn.LocalAddr().(*net.UDPAddr).Port, name)
+		conn.Close()
+	}
+
+	exclusivePort := xdialApplicationSocket(t, "0.0.0.0", false)
+	_, err := xdialListenOnSourcePort(exclusivePort)
+	require.Error(t, err)
+}
