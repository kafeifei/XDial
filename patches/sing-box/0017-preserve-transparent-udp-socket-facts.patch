new file mode 100644
--- /dev/null
+++ b/protocol/direct/xdial_source_port.go
@@ -0,0 +1,55 @@
+package direct
+
+import (
+	"context"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/common/dialer"
+	"github.com/sagernet/sing-box/option"
+	M "github.com/sagernet/sing/common/metadata"
+)
+
+func xdialSourcePortDialerOptions(
+	base option.DialerOptions,
+	boundInterface string,
+	sourcePort uint16,
+) option.DialerOptions {
+	if boundInterface != "" {
+		base = xdialBoundDialerOptions(base, boundInterface)
+	}
+	base.UDPBindPort = sourcePort
+	base.ReuseAddr = true
+	return base
+}
+
+// xdialSourcePortDialer binds the flow's own packet connection to the
+// application socket's local port, shared through SO_REUSEPORT. macOS does not
+// deliver datagrams to a socket the transparent proxy holds, so a peer that
+// sends to the port it negotiated (Screen Sharing's media) reaches the flow
+// only through this socket. A wildcard port the application holds exclusively
+// fails to bind, and the caller keeps its ephemeral dialer.
+func (h *Outbound) xdialSourcePortDialer(
+	ctx context.Context,
+	destination M.Socksaddr,
+) dialer.ParallelInterfaceDialer {
+	metadata := adapter.ContextFrom(ctx)
+	sourcePort := metadata.XDialSourcePortFor(destination)
+	if sourcePort == 0 {
+		return nil
+	}
+	newDialer, err := dialer.NewWithOptions(dialer.Options{
+		Context: h.ctx,
+		Options: xdialSourcePortDialerOptions(
+			h.dialerOptions,
+			metadata.XDialBoundInterface,
+			sourcePort,
+		),
+		RemoteIsDomain: true,
+		DirectOutbound: true,
+	})
+	if err != nil {
+		return nil
+	}
+	portDialer, _ := newDialer.(dialer.ParallelInterfaceDialer)
+	return portDialer
+}
