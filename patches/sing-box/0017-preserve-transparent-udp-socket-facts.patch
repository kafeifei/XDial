+)
+
+func xdialEncodedUDPAssociation(interfaceName string, sourcePort uint16) string {
+	raw := append([]byte(nil), xdialUDPAssociationMagic...)
+	var flags byte
+	if interfaceName != "" {
+		flags |= xdialBoundInterfaceFlag
+	}
+	if sourcePort != 0 {
+		flags |= xdialSourcePortFlag
+	}
+	raw = append(raw, flags)
+	if interfaceName != "" {
+		raw = append(raw, byte(len(interfaceName)))
+		raw = append(raw, interfaceName...)
+	}
+	if sourcePort != 0 {
+		raw = append(raw, byte(sourcePort>>8), byte(sourcePort))
+	}
+	return string(raw)
+}
+
+func TestXDialUDPAssociationCarriesSocketFacts(t *testing.T) {
+	association, encoded, err := parseXDialUDPAssociation(M.Socksaddr{
+		Fqdn: xdialEncodedUDPAssociation("en0", 5901),
+	})
+	require.NoError(t, err)
+	require.True(t, encoded)
+	require.Equal(t, xdialUDPAssociation{boundInterface: "en0", sourcePort: 5901}, association)
+
+	association, encoded, err = parseXDialUDPAssociation(M.Socksaddr{
+		Fqdn: xdialEncodedUDPAssociation("", 5900),
+	})
+	require.NoError(t, err)
+	require.True(t, encoded)
+	require.Equal(t, xdialUDPAssociation{sourcePort: 5900}, association)
+
+	_, encoded, err = parseXDialUDPAssociation(M.ParseSocksaddrHostPort("0.0.0.0", 0))
+	require.NoError(t, err)
+	require.False(t, encoded)
+}
+
+func TestXDialUDPAssociationRejectsMalformedEnvelope(t *testing.T) {
+	valid := xdialEncodedUDPAssociation("en0", 5901)
+	for name, raw := range map[string]string{
+		"no flags":      string(xdialUDPAssociationMagic) + "\x00",
+		"unknown flag":  string(xdialUDPAssociationMagic) + "\x01",
+		"zero port":     string(xdialUDPAssociationMagic) + string([]byte{xdialSourcePortFlag, 0, 0}),
+		"short port":    string(xdialUDPAssociationMagic) + string([]byte{xdialSourcePortFlag, 0x17}),
+		"trailing byte": valid + "\x00",
+		"bad interface": xdialEncodedUDPAssociation("en/0", 5901),
+	} {
+		_, encoded, err := parseXDialUDPAssociation(M.Socksaddr{Fqdn: raw})
+		require.Error(t, err, name)
+		require.True(t, encoded, name)
+	}
+}
+
+type xdialCapturingRouter struct {
+	packetMetadata chan adapter.InboundContext
+	keepPacketConn chan N.PacketConn
+}
+
+func (r *xdialCapturingRouter) RouteConnection(context.Context, net.Conn, adapter.InboundContext) error {
+	return nil
+}
+
+func (r *xdialCapturingRouter) RoutePacketConnection(context.Context, N.PacketConn, adapter.InboundContext) error {
+	return nil
+}
+
+func (r *xdialCapturingRouter) RouteConnectionEx(_ context.Context, conn net.Conn, _ adapter.InboundContext, onClose N.CloseHandlerFunc) {
+	conn.Close()
+}
+
+func (r *xdialCapturingRouter) RoutePacketConnectionEx(_ context.Context, conn N.PacketConn, metadata adapter.InboundContext, onClose N.CloseHandlerFunc) {
+	r.packetMetadata <- metadata
+	if r.keepPacketConn != nil {
+		r.keepPacketConn <- conn
+		return
+	}
+	conn.Close()
+}
+
+// The relay states the application socket's facts in the UDP ASSOCIATE
+// request. They must survive the handshake into the routed metadata, while
+// the destination still comes from the first datagram.
+func TestXDialUDPAssociateHandshakeKeepsSocketFacts(t *testing.T) {
+	for name, testCase := range map[string]struct {
+		request        M.Socksaddr
+		boundInterface string
+		sourcePort     uint16
+	}{
+		"socket facts": {
+			request:        M.Socksaddr{Fqdn: xdialEncodedUDPAssociation("en0", 5901)},
+			boundInterface: "en0",
+			sourcePort:     5901,
+		},
+		"plain request": {
+			request: M.ParseSocksaddrHostPort("0.0.0.0", 0),
+		},
+	} {
+		t.Run(name, func(t *testing.T) {
+			router := &xdialCapturingRouter{packetMetadata: make(chan adapter.InboundContext, 1)}
+			authenticator := auth.NewAuthenticator([]auth.User{{Username: "relay", Password: "secret"}})
+			h := &Inbound{
+				Adapter:           inbound.NewAdapter(C.TypeSOCKS, "transparent-proxy-in"),
+				router:            router,
+				logger:            log.NewNOPFactory().Logger(),
+				authenticator:     authenticator,
+				xdialFlowMetadata: true,
+			}
+
+			listener, err := net.Listen("tcp", "127.0.0.1:0")
+			require.NoError(t, err)
+			defer listener.Close()
+			serverErr := make(chan error, 1)
+			go func() {
+				conn, err := listener.Accept()
+				if err != nil {
+					serverErr <- err
+					return
+				}
+				handler := adapter.NewUpstreamHandler(adapter.InboundContext{}, h.newUserConnection, h.streamUserPacketConnection)
+				serverErr <- xdialHandleConnection(context.Background(), conn, std_bufio.NewReader(conn), authenticator, handler, nil, 0, M.SocksaddrFromNet(conn.RemoteAddr()), nil)
+			}()
+
+			control, err := net.Dial("tcp", listener.Addr().String())
+			require.NoError(t, err)
+			defer control.Close()
+			control.SetDeadline(time.Now().Add(5 * time.Second))
+			reader := std_bufio.NewReader(control)
+			require.NoError(t, socks5.WriteAuthRequest(control, socks5.AuthRequest{Methods: []byte{socks5.AuthTypeUsernamePassword}}))
+			authResponse, err := socks5.ReadAuthResponse(reader)
+			require.NoError(t, err)
+			require.Equal(t, socks5.AuthTypeUsernamePassword, authResponse.Method)
+			require.NoError(t, socks5.WriteUsernamePasswordAuthRequest(control, socks5.UsernamePasswordAuthRequest{Username: "relay", Password: "secret"}))
+			passwordResponse, err := socks5.ReadUsernamePasswordAuthResponse(reader)
+			require.NoError(t, err)
+			require.Equal(t, socks5.UsernamePasswordStatusSuccess, passwordResponse.Status)
+			require.NoError(t, socks5.WriteRequest(control, socks5.Request{Command: socks5.CommandUDPAssociate, Destination: testCase.request}))
+			response, err := socks5.ReadResponse(reader)
+			require.NoError(t, err)
+			require.Equal(t, socks5.ReplyCodeSuccess, response.ReplyCode)
+
+			relay, err := net.DialUDP("udp", nil, response.Bind.UDPAddr())
+			require.NoError(t, err)
+			defer relay.Close()
+			peer := netip.MustParseAddr("100.103.86.57")
+			datagram := []byte{0, 0, 0, 0x01}
+			datagram = append(datagram, peer.AsSlice()...)
+			datagram = append(datagram, 0x17, 0x0d)
+			datagram = append(datagram, "rtcp"...)
+			_, err = relay.Write(datagram)
+			require.NoError(t, err)
+
+			select {
+			case metadata := <-router.packetMetadata:
+				require.Equal(t, M.SocksaddrFrom(peer, 5901), metadata.Destination)
+				require.Equal(t, testCase.boundInterface, metadata.XDialBoundInterface)
+				require.Equal(t, testCase.sourcePort, metadata.XDialSourcePort)
+				require.Equal(t, "relay", metadata.User)
+			case <-time.After(5 * time.Second):
+				t.Fatal("UDP association was not routed")
+			}
+			require.NoError(t, <-serverErr)
+		})
+	}
+}
+
+func TestXDialUDPAssociateRejectsMalformedSocketFacts(t *testing.T) {
+	serverConn, clientConn := net.Pipe()
+	defer clientConn.Close()
+	serverErr := make(chan error, 1)
+	go func() {
+		handler := adapter.NewUpstreamHandler(adapter.InboundContext{}, nil, nil)
+		serverErr <- xdialHandleConnection(context.Background(), serverConn, std_bufio.NewReader(serverConn), nil, handler, nil, 0, M.Socksaddr{}, nil)
+		serverConn.Close()
+	}()
+	reader := std_bufio.NewReader(clientConn)
+	require.NoError(t, socks5.WriteAuthRequest(clientConn, socks5.AuthRequest{Methods: []byte{socks5.AuthTypeNotRequired}}))
+	_, err := socks5.ReadAuthResponse(reader)
+	require.NoError(t, err)
+	malformed := string(xdialUDPAssociationMagic) + string([]byte{xdialSourcePortFlag, 0, 0})
+	require.NoError(t, socks5.WriteRequest(clientConn, socks5.Request{Command: socks5.CommandUDPAssociate, Destination: M.Socksaddr{Fqdn: malformed}}))
+	response, err := socks5.ReadResponse(reader)
+	require.NoError(t, err)
+	require.Equal(t, socks5.ReplyCodeFailure, response.ReplyCode)
+	require.Error(t, <-serverErr)
+}
+
+// The relay tears an association down by closing its control connection.
+// The routed packet connection must end with it, or the outbound keeps the
+// application's source port until the idle timeout.
+func TestXDialUDPAssociationEndsWithControlConnection(t *testing.T) {
+	router := &xdialCapturingRouter{
+		packetMetadata: make(chan adapter.InboundContext, 1),
+		keepPacketConn: make(chan N.PacketConn, 1),
+	}
+	h := &Inbound{
+		Adapter:           inbound.NewAdapter(C.TypeSOCKS, "transparent-proxy-in"),
+		router:            router,
+		logger:            log.NewNOPFactory().Logger(),
+		xdialFlowMetadata: true,
+	}
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	require.NoError(t, err)
+	defer listener.Close()
+	go func() {
+		conn, err := listener.Accept()
+		if err != nil {
+			return
+		}
+		handler := adapter.NewUpstreamHandler(adapter.InboundContext{}, h.newUserConnection, h.streamUserPacketConnection)
+		_ = xdialHandleConnection(context.Background(), conn, std_bufio.NewReader(conn), nil, handler, nil, 5*time.Minute, M.SocksaddrFromNet(conn.RemoteAddr()), nil)
+	}()
+
+	control, err := net.Dial("tcp", listener.Addr().String())
+	require.NoError(t, err)
+	control.SetDeadline(time.Now().Add(5 * time.Second))
+	reader := std_bufio.NewReader(control)
+	require.NoError(t, socks5.WriteAuthRequest(control, socks5.AuthRequest{Methods: []byte{socks5.AuthTypeNotRequired}}))
+	_, err = socks5.ReadAuthResponse(reader)
+	require.NoError(t, err)
+	require.NoError(t, socks5.WriteRequest(control, socks5.Request{Command: socks5.CommandUDPAssociate, Destination: M.Socksaddr{Fqdn: xdialEncodedUDPAssociation("", 5901)}}))
+	response, err := socks5.ReadResponse(reader)
+	require.NoError(t, err)
+	relay, err := net.DialUDP("udp", nil, response.Bind.UDPAddr())
+	require.NoError(t, err)
+	defer relay.Close()
+	datagram := []byte{0, 0, 0, 0x01, 100, 103, 86, 57, 0x17, 0x0d}
+	_, err = relay.Write(append(datagram, "rtcp"...))
+	require.NoError(t, err)
+
+	var routed N.PacketConn
+	select {
+	case <-router.packetMetadata:
+		routed = <-router.keepPacketConn
+	case <-time.After(5 * time.Second):
+		t.Fatal("UDP association was not routed")
+	}
+	readDone := make(chan error, 1)
+	go func() {
+		buffer := buf.NewPacket()
+		defer buffer.Release()
+		for {
+			if _, err := routed.ReadPacket(buffer); err != nil {
+				readDone <- err
+				return
+			}
+			buffer.Reset()
+		}
+	}()
+	require.NoError(t, control.Close())
+	select {
+	case err := <-readDone:
+		require.Error(t, err)
+	case <-time.After(2 * time.Second):
+		t.Fatal("association outlived its control connection")
+	}
+}
