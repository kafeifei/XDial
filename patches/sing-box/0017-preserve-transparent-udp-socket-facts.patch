diff --git a/protocol/socks/xdial_udp_association.go b/protocol/socks/xdial_udp_association.go
new file mode 100644
--- /dev/null
+++ b/protocol/socks/xdial_udp_association.go
@@ -0,0 +1,263 @@
+package socks
+
+import (
+	std_bufio "bufio"
+	"bytes"
+	"context"
+	"encoding/binary"
+	"io"
+	"net"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing/common"
+	"github.com/sagernet/sing/common/auth"
+	"github.com/sagernet/sing/common/buf"
+	"github.com/sagernet/sing/common/bufio"
+	"github.com/sagernet/sing/common/canceler"
+	E "github.com/sagernet/sing/common/exceptions"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+	"github.com/sagernet/sing/protocol/socks"
+	"github.com/sagernet/sing/protocol/socks/socks5"
+)
+
+var xdialUDPAssociationMagic = []byte{0x00, 0x58, 0x44, 0x03}
+
+const xdialSourcePortFlag = byte(1 << 3)
+
+// xdialUDPAssociation holds what the relay states about the application
+// socket behind one UDP ASSOCIATE. These are facts of the socket, not a
+// destination: every datagram still names its own target.
+type xdialUDPAssociation struct {
+	boundInterface string
+	sourcePort     uint16
+}
+
+type xdialUDPAssociationKey struct{}
+
+func (a xdialUDPAssociation) apply(metadata *adapter.InboundContext) {
+	metadata.XDialBoundInterface = a.boundInterface
+	metadata.XDialSourcePort = a.sourcePort
+}
+
+func xdialUDPAssociationFromContext(ctx context.Context) (xdialUDPAssociation, bool) {
+	association, loaded := ctx.Value(xdialUDPAssociationKey{}).(xdialUDPAssociation)
+	return association, loaded
+}
+
+// parseXDialUDPAssociation decodes the UDP ASSOCIATE request address. An
+// ordinary address carries no facts and is not an error.
+func parseXDialUDPAssociation(request M.Socksaddr) (xdialUDPAssociation, bool, error) {
+	if !request.IsDomain() {
+		return xdialUDPAssociation{}, false, nil
+	}
+	raw := []byte(request.Fqdn)
+	if !bytes.HasPrefix(raw, xdialUDPAssociationMagic) {
+		return xdialUDPAssociation{}, false, nil
+	}
+	offset := len(xdialUDPAssociationMagic)
+	if len(raw) <= offset {
+		return xdialUDPAssociation{}, true, E.New("invalid XDial UDP association")
+	}
+	flags := raw[offset]
+	offset++
+	const knownFlags = xdialBoundInterfaceFlag | xdialSourcePortFlag
+	if flags == 0 || flags&^knownFlags != 0 {
+		return xdialUDPAssociation{}, true, E.New("invalid XDial UDP association flags")
+	}
+
+	var association xdialUDPAssociation
+	if flags&xdialBoundInterfaceFlag != 0 {
+		if len(raw) <= offset {
+			return xdialUDPAssociation{}, true, E.New("invalid XDial bound interface")
+		}
+		interfaceLength := int(raw[offset])
+		offset++
+		if interfaceLength == 0 || interfaceLength > 15 ||
+			len(raw) < offset+interfaceLength ||
+			!xdialValidInterfaceName(raw[offset:offset+interfaceLength]) {
+			return xdialUDPAssociation{}, true, E.New("invalid XDial bound interface")
+		}
+		association.boundInterface = string(raw[offset : offset+interfaceLength])
+		offset += interfaceLength
+	}
+	if flags&xdialSourcePortFlag != 0 {
+		if len(raw) < offset+2 {
+			return xdialUDPAssociation{}, true, E.New("invalid XDial source port")
+		}
+		association.sourcePort = binary.BigEndian.Uint16(raw[offset:])
+		offset += 2
+		if association.sourcePort == 0 {
+			return xdialUDPAssociation{}, true, E.New("invalid XDial source port")
+		}
+	}
+	if offset != len(raw) {
+		return xdialUDPAssociation{}, true, E.New("invalid XDial UDP association")
+	}
+	return association, true, nil
+}
+
+func xdialValidInterfaceName(name []byte) bool {
+	for _, character := range name {
+		if !(character >= 'a' && character <= 'z') &&
+			!(character >= 'A' && character <= 'Z') &&
+			!(character >= '0' && character <= '9') &&
+			character != '.' && character != '_' && character != '-' {
+			return false
+		}
+	}
+	return true
+}
+
+// xdialHandleConnection serves the transparent proxy's authenticated loopback
+// relay. It is the SOCKS5 part of socks.HandleConnectionEx with one change:
+// the generic handshake discards the UDP ASSOCIATE request address, which is
+// where the relay states the facts of the application socket.
+func xdialHandleConnection(
+	ctx context.Context,
+	conn net.Conn,
+	reader *std_bufio.Reader,
+	authenticator *auth.Authenticator,
+	handler socks.HandlerEx,
+	packetListener socks.PacketListener,
+	udpTimeout time.Duration,
+	source M.Socksaddr,
+	onClose N.CloseHandlerFunc,
+) error {
+	version, err := reader.ReadByte()
+	if err != nil {
+		return err
+	}
+	if version != socks5.Version {
+		return E.New("xdial socks: unsupported version ", version)
+	}
+	authRequest, err := socks5.ReadAuthRequest0(reader)
+	if err != nil {
+		return err
+	}
+	authMethod := socks5.AuthTypeNotRequired
+	if authenticator != nil {
+		if !common.Contains(authRequest.Methods, socks5.AuthTypeUsernamePassword) {
+			err = socks5.WriteAuthResponse(conn, socks5.AuthResponse{
+				Method: socks5.AuthTypeNoAcceptedMethods,
+			})
+			if err != nil {
+				return err
+			}
+			return E.New("xdial socks: username/password authentication required")
+		}
+		authMethod = socks5.AuthTypeUsernamePassword
+	}
+	err = socks5.WriteAuthResponse(conn, socks5.AuthResponse{Method: authMethod})
+	if err != nil {
+		return err
+	}
+	if authMethod == socks5.AuthTypeUsernamePassword {
+		authRequest, err := socks5.ReadUsernamePasswordAuthRequest(reader)
+		if err != nil {
+			return err
+		}
+		ctx = auth.ContextWithUser(ctx, authRequest.Username)
+		response := socks5.UsernamePasswordAuthResponse{
+			Status: socks5.UsernamePasswordStatusFailure,
+		}
+		if authenticator.Verify(authRequest.Username, authRequest.Password) {
+			response.Status = socks5.UsernamePasswordStatusSuccess
+		}
+		err = socks5.WriteUsernamePasswordAuthResponse(conn, response)
+		if err != nil {
+			return err
+		}
+		if response.Status != socks5.UsernamePasswordStatusSuccess {
+			return E.New("xdial socks: authentication failed, username=", authRequest.Username)
+		}
+	}
+	request, err := socks5.ReadRequest(reader)
+	if err != nil {
+		return err
+	}
+	switch request.Command {
+	case socks5.CommandConnect:
+		handler.NewConnectionEx(ctx, socks.NewLazyConn(conn, socks5.Version), source, request.Destination, onClose)
+		return nil
+	case socks5.CommandUDPAssociate:
+		association, encoded, err := parseXDialUDPAssociation(request.Destination)
+		if err != nil {
+			_ = socks5.WriteResponse(conn, socks5.Response{ReplyCode: socks5.ReplyCodeFailure})
+			return err
+		}
+		if encoded {
+			ctx = context.WithValue(ctx, xdialUDPAssociationKey{}, association)
+		}
+		return xdialServeUDPAssociation(ctx, conn, reader, handler, packetListener, udpTimeout, source, onClose)
+	default:
+		err = socks5.WriteResponse(conn, socks5.Response{ReplyCode: socks5.ReplyCodeUnsupported})
+		if err != nil {
+			return err
+		}
+		return E.New("xdial socks: unsupported command ", request.Command)
+	}
+}
+
+func xdialServeUDPAssociation(
+	ctx context.Context,
+	conn net.Conn,
+	reader *std_bufio.Reader,
+	handler socks.HandlerEx,
+	packetListener socks.PacketListener,
+	udpTimeout time.Duration,
+	source M.Socksaddr,
+	onClose N.CloseHandlerFunc,
+) error {
+	var (
+		listenConfig net.ListenConfig
+		udpConn      net.PacketConn
+		err          error
+	)
+	network := M.NetworkFromNetAddr("udp", M.AddrFromNet(conn.LocalAddr()))
+	address := M.SocksaddrFrom(M.AddrFromNet(conn.LocalAddr()), 0).String()
+	if packetListener != nil {
+		udpConn, err = packetListener.ListenPacket(listenConfig, ctx, network, address)
+	} else {
+		udpConn, err = listenConfig.ListenPacket(ctx, network, address)
+	}
+	if err != nil {
+		return E.Cause(err, "socks5: listen udp")
+	}
+	err = socks5.WriteResponse(conn, socks5.Response{
+		ReplyCode: socks5.ReplyCodeSuccess,
+		Bind:      M.SocksaddrFromNet(udpConn.LocalAddr()).Unwrap(),
+	})
+	if err != nil {
+		udpConn.Close()
+		return E.Cause(err, "socks5: write response")
+	}
+	associatePacketConn := socks.NewAssociatePacketConn(bufio.NewServerPacketConn(udpConn), M.Socksaddr{}, conn)
+	// RFC 1928: a UDP association ends with the TCP connection that requested
+	// it. The generic handshake leaves it to the idle timeout, which would keep
+	// the application's source port bound on the tailnet for minutes after the
+	// socket closed, and a new socket on that port could not take it.
+	go func() {
+		_, _ = io.Copy(io.Discard, reader)
+		_ = associatePacketConn.Close()
+	}()
+	var socksPacketConn N.PacketConn = associatePacketConn
+	if udpTimeout > 0 {
+		udpConn.SetReadDeadline(time.Now().Add(udpTimeout))
+	}
+	firstPacket := buf.NewPacket()
+	destination, err := socksPacketConn.ReadPacket(firstPacket)
+	if err != nil {
+		firstPacket.Release()
+		associatePacketConn.Close()
+		return E.Cause(err, "socks5: read first packet")
+	}
+	if udpTimeout > 0 {
+		udpConn.SetReadDeadline(time.Time{})
+		ctx, socksPacketConn = canceler.NewPacketConn(ctx, socksPacketConn, udpTimeout)
+	}
+	socksPacketConn = bufio.NewCachedPacketConn(socksPacketConn, firstPacket, destination)
+	handler.NewPacketConnectionEx(ctx, socksPacketConn, source, destination, onClose)
+	return nil
+}
