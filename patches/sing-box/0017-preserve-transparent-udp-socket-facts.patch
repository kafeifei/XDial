new file mode 100644
--- /dev/null
+++ b/protocol/tailscale/xdial_udp_source_port.go
@@ -0,0 +1,66 @@
+//go:build with_gvisor
+
+package tailscale
+
+import (
+	"context"
+	"errors"
+	"net"
+
+	"github.com/sagernet/gvisor/pkg/tcpip"
+	"github.com/sagernet/gvisor/pkg/tcpip/adapters/gonet"
+	"github.com/sagernet/gvisor/pkg/tcpip/stack"
+	"github.com/sagernet/sing-box/adapter"
+	M "github.com/sagernet/sing/common/metadata"
+)
+
+// xdialDialUDP opens the tailnet side of a UDP packet connection. When the
+// transparent proxy reports the application socket's local port, the netstack
+// endpoint takes that same port: peers such as macOS Screen Sharing send their
+// media to the port numbers they negotiated, not to the source port they
+// observed, so an ephemeral port leaves those datagrams without a listener.
+// A port another flow already holds falls back to an ephemeral one.
+func (t *Endpoint) xdialDialUDP(
+	ctx context.Context,
+	destination M.Socksaddr,
+	localAddr tcpip.FullAddress,
+	remoteAddr *tcpip.FullAddress,
+	networkProtocol tcpip.NetworkProtocolNumber,
+) (*gonet.UDPConn, error) {
+	sourcePort := adapter.ContextFrom(ctx).XDialSourcePortFor(destination)
+	udpConn, preserved, err := xdialDialUDPPreservingPort(
+		t.stack,
+		localAddr,
+		remoteAddr,
+		networkProtocol,
+		sourcePort,
+	)
+	if err == nil && sourcePort != 0 && !preserved {
+		t.logger.InfoContext(ctx, "source port ", sourcePort, " is taken on the tailnet, using ", udpConn.LocalAddr())
+	}
+	return udpConn, err
+}
+
+func xdialDialUDPPreservingPort(
+	ipStack *stack.Stack,
+	localAddr tcpip.FullAddress,
+	remoteAddr *tcpip.FullAddress,
+	networkProtocol tcpip.NetworkProtocolNumber,
+	sourcePort uint16,
+) (*gonet.UDPConn, bool, error) {
+	if sourcePort != 0 {
+		preservedAddr := localAddr
+		preservedAddr.Port = sourcePort
+		udpConn, err := gonet.DialUDP(ipStack, &preservedAddr, remoteAddr, networkProtocol)
+		if err == nil {
+			return udpConn, true, nil
+		}
+		var opErr *net.OpError
+		if !errors.As(err, &opErr) || opErr.Op != "bind" {
+			return nil, false, err
+		}
+	}
+	localAddr.Port = 0
+	udpConn, err := gonet.DialUDP(ipStack, &localAddr, remoteAddr, networkProtocol)
+	return udpConn, false, err
+}
diff --git a/protocol/tailscale/xdial_udp_source_port_test.go b/protocol/tailscale/xdial_udp_source_port_test.go
new file mode 100644
--- /dev/null
+++ b/protocol/tailscale/xdial_udp_source_port_test.go
@@ -0,0 +1,119 @@
+//go:build with_gvisor
+
+package tailscale
+
+import (
+	"net"
+	"net/netip"
+	"testing"
+	"time"
+
+	"github.com/sagernet/gvisor/pkg/tcpip"
+	"github.com/sagernet/gvisor/pkg/tcpip/adapters/gonet"
+	"github.com/sagernet/gvisor/pkg/tcpip/header"
+	"github.com/sagernet/gvisor/pkg/tcpip/link/loopback"
+	"github.com/sagernet/gvisor/pkg/tcpip/network/ipv4"
+	"github.com/sagernet/gvisor/pkg/tcpip/stack"
+	"github.com/sagernet/gvisor/pkg/tcpip/transport/udp"
+)
+
+var (
+	xdialTestLocalAddress = netip.MustParseAddr("100.113.251.63")
+	xdialTestPeerAddress  = netip.MustParseAddr("100.103.86.57")
+)
+
+func xdialTestStack(t *testing.T) *stack.Stack {
+	t.Helper()
+	ipStack := stack.New(stack.Options{
+		NetworkProtocols:   []stack.NetworkProtocolFactory{ipv4.NewProtocol},
+		TransportProtocols: []stack.TransportProtocolFactory{udp.NewProtocol},
+	})
+	t.Cleanup(ipStack.Close)
+	if err := ipStack.CreateNIC(1, loopback.New()); err != nil {
+		t.Fatal(err)
+	}
+	for _, address := range []netip.Addr{xdialTestLocalAddress, xdialTestPeerAddress} {
+		err := ipStack.AddProtocolAddress(1, tcpip.ProtocolAddress{
+			Protocol:          ipv4.ProtocolNumber,
+			AddressWithPrefix: tcpip.AddrFrom4(address.As4()).WithPrefix(),
+		}, stack.AddressProperties{})
+		if err != nil {
+			t.Fatal(err)
+		}
+	}
+	ipStack.SetRouteTable([]tcpip.Route{{Destination: header.IPv4EmptySubnet, NIC: 1}})
+	return ipStack
+}
+
+func xdialTestAddress(address netip.Addr, port uint16) tcpip.FullAddress {
+	return tcpip.FullAddress{NIC: 1, Addr: tcpip.AddrFrom4(address.As4()), Port: port}
+}
+
+// macOS Screen Sharing sends media from and to the port numbers it announced,
+// so the tailnet socket must hold the application's port and receive what the
+// peer sends there.
+func TestXDialPreservedSourcePortReceivesPeerDatagrams(t *testing.T) {
+	ipStack := xdialTestStack(t)
+	flowConn, preserved, err := xdialDialUDPPreservingPort(ipStack, xdialTestAddress(xdialTestLocalAddress, 0), nil, ipv4.ProtocolNumber, 5901)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer flowConn.Close()
+	if !preserved {
+		t.Fatal("free source port was not preserved")
+	}
+	peerAddr := xdialTestAddress(xdialTestPeerAddress, 5901)
+	peerConn, err := gonet.DialUDP(ipStack, &peerAddr, nil, ipv4.ProtocolNumber)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer peerConn.Close()
+	deadline := time.Now().Add(5 * time.Second)
+	flowConn.SetDeadline(deadline)
+	peerConn.SetDeadline(deadline)
+
+	peerUDPAddr := &net.UDPAddr{IP: xdialTestPeerAddress.AsSlice(), Port: 5901}
+	if _, err = flowConn.WriteTo([]byte("rtcp"), peerUDPAddr); err != nil {
+		t.Fatal(err)
+	}
+	buffer := make([]byte, 64)
+	_, from, err := peerConn.ReadFrom(buffer)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if from.(*net.UDPAddr).Port != 5901 {
+		t.Fatalf("peer saw source port %d", from.(*net.UDPAddr).Port)
+	}
+
+	// The peer does not answer the observed source; it sends to the port it
+	// negotiated, which is the same number.
+	localUDPAddr := &net.UDPAddr{IP: xdialTestLocalAddress.AsSlice(), Port: 5901}
+	if _, err = peerConn.WriteTo([]byte("hevc"), localUDPAddr); err != nil {
+		t.Fatal(err)
+	}
+	n, from, err := flowConn.ReadFrom(buffer)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(buffer[:n]) != "hevc" || from.String() != peerUDPAddr.String() {
+		t.Fatalf("flow received %q from %v", buffer[:n], from)
+	}
+}
+
+func TestXDialTakenSourcePortFallsBackToEphemeral(t *testing.T) {
+	ipStack := xdialTestStack(t)
+	first, preserved, err := xdialDialUDPPreservingPort(ipStack, xdialTestAddress(xdialTestLocalAddress, 0), nil, ipv4.ProtocolNumber, 5901)
+	if err != nil || !preserved {
+		t.Fatalf("first flow: preserved=%v err=%v", preserved, err)
+	}
+	defer first.Close()
+	second, preserved, err := xdialDialUDPPreservingPort(ipStack, xdialTestAddress(xdialTestLocalAddress, 0), nil, ipv4.ProtocolNumber, 5901)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer second.Close()
+	port := second.LocalAddr().(*net.UDPAddr).Port
+	if preserved || port == 0 || port == 5901 {
+		t.Fatalf("taken port: preserved=%v port=%d", preserved, port)
+	}
+}
