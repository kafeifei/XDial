+package adapter
+
+import (
+	"net/netip"
+	"testing"
+
+	M "github.com/sagernet/sing/common/metadata"
+)
+
+func TestXDialSourcePortOnlyForFlowDestination(t *testing.T) {
+	peer := netip.MustParseAddr("100.103.86.57")
+	flow := M.SocksaddrFrom(peer, 5901)
+	metadata := &InboundContext{Destination: flow, XDialSourcePort: 5901}
+	if port := metadata.XDialSourcePortFor(flow); port != 5901 {
+		t.Fatalf("flow destination got port %d", port)
+	}
+	if port := metadata.XDialSourcePortFor(M.ParseSocksaddrHostPort("100.100.100.100", 53)); port != 0 {
+		t.Fatalf("lookup made for the flow took its source port %d", port)
+	}
+	if port := metadata.XDialSourcePortFor(M.SocksaddrFrom(peer, 5900)); port != 0 {
+		t.Fatalf("other port of the same peer took source port %d", port)
+	}
+	byName := &InboundContext{
+		Destination:     M.Socksaddr{Fqdn: "imac16k.example.ts.net", Port: 5901},
+		XDialSourcePort: 5901,
+	}
+	if port := byName.XDialSourcePortFor(flow); port != 5901 {
+		t.Fatalf("connect-by-name flow got port %d", port)
+	}
+	resolved := &InboundContext{
+		Destination:          M.Socksaddr{Fqdn: "imac16k.example.ts.net", Port: 5901},
+		DestinationAddresses: []netip.Addr{peer},
+		XDialSourcePort:      5901,
+	}
+	if port := resolved.XDialSourcePortFor(flow); port != 5901 {
+		t.Fatalf("resolved flow got port %d", port)
+	}
+	var missing *InboundContext
+	if port := missing.XDialSourcePortFor(flow); port != 0 {
+		t.Fatalf("connection without metadata got port %d", port)
+	}
+	if port := (&InboundContext{Destination: flow}).XDialSourcePortFor(flow); port != 0 {
+		t.Fatalf("flow without a reported port got port %d", port)
+	}
+}
