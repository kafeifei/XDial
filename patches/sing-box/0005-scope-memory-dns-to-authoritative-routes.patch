+func TestXDialDNSMemorySnapshotRejectsOversizedAddressRecordSet(t *testing.T) {
+	tailnet := mustXDialFQDN(t, "example-tailnet.ts.net")
+	member := mustXDialFQDN(t, "member.example-tailnet.ts.net")
+	addresses := make([]netip.Addr, tailscaleDNSMaxAddresses+1)
+	for index := range addresses {
+		var raw [16]byte
+		raw[0] = 0xfd
+		raw[14] = byte(index >> 8)
+		raw[15] = byte(index)
+		addresses[index] = netip.AddrFrom16(raw)
+	}
+	state := tailscaleDNSMemorySnapshotFromConfig(&tsDNS.Config{
+		Routes: map[dnsname.FQDN][]*dnstype.Resolver{tailnet: nil},
+		Hosts:  map[dnsname.FQDN][]netip.Addr{member: addresses},
+	})
+	if state.errorCode != tailscaleDNSSnapshotTooLarge {
+		t.Fatalf("snapshot error code = %d, want too large", state.errorCode)
+	}
+}
