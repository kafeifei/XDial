+func TestXDialDNSMemorySnapshotOnlyOwnsAuthoritativeRoutes(t *testing.T) {
+	authoritative := mustXDialFQDN(t, "example-tailnet.ts.net")
+	forwarded := mustXDialFQDN(t, "corp.example.com")
+	member := mustXDialFQDN(t, "mba32k.example-tailnet.ts.net")
+	forwardedHost := mustXDialFQDN(t, "secret.corp.example.com")
+	outsideHost := mustXDialFQDN(t, "outside.public.example")
+	state := tailscaleDNSMemorySnapshotFromConfig(&tsDNS.Config{
+		SearchDomains: []dnsname.FQDN{authoritative, forwarded},
+		Routes: map[dnsname.FQDN][]*dnstype.Resolver{
+			authoritative: nil,
+			forwarded:     {{Addr: "10.0.0.53"}},
+		},
+		Hosts: map[dnsname.FQDN][]netip.Addr{
+			member:        {netip.MustParseAddr("100.64.0.8")},
+			forwardedHost: {netip.MustParseAddr("100.64.0.9")},
+			outsideHost:   {netip.MustParseAddr("100.64.0.10")},
+		},
+	})
+	if state.errorCode != tailscaleDNSSnapshotValid {
+		t.Fatalf("snapshot error code = %d", state.errorCode)
+	}
+	if state.snapshot.RecordCount != 5 {
+		t.Fatalf("record count = %d, want 5", state.snapshot.RecordCount)
+	}
+	if !reflect.DeepEqual(state.snapshot.OwnedDomains, []string{"example-tailnet.ts.net"}) {
+		t.Fatalf("owned domains = %v", state.snapshot.OwnedDomains)
+	}
+	for _, expectedHost := range []string{
+		"mba32k.example-tailnet.ts.net",
+		"mba32k",
+		"secret.corp.example.com",
+		"secret",
+		"outside.public.example",
+	} {
+		if _, found := state.snapshot.Hosts[expectedHost]; !found {
+			t.Fatalf("Tailscale exact host or search alias is missing: %q", expectedHost)
+		}
+	}
+	for _, domain := range state.snapshot.CaptureDomains {
+		if domain == "corp.example.com" {
+			t.Fatalf("forwarded route became locally authoritative: %q", domain)
+		}
+	}
