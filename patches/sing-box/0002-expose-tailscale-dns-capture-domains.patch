+func tailscaleDNSCaptureDomains(dnsCfg *tsDNS.Config) []string {
+	if dnsCfg == nil {
+		return nil
+	}
+	seen := make(map[string]bool)
+	add := func(domain string) {
+		domain = strings.ToLower(strings.TrimSuffix(strings.TrimSpace(domain), "."))
+		if domain != "" {
+			seen[domain] = true
+		}
+	}
+	searchDomains := make([]string, 0, len(dnsCfg.SearchDomains))
+	for _, fqdn := range dnsCfg.SearchDomains {
+		domain := fqdn.WithoutTrailingDot()
+		add(domain)
+		searchDomains = append(searchDomains, strings.ToLower(domain))
+	}
+	for fqdn := range dnsCfg.Routes {
+		add(fqdn.WithoutTrailingDot())
+	}
+	for fqdn := range dnsCfg.Hosts {
+		host := strings.ToLower(fqdn.WithoutTrailingDot())
+		add(host)
+		for _, searchDomain := range searchDomains {
+			relative, found := strings.CutSuffix(host, "."+searchDomain)
+			if found && relative != "" && !strings.Contains(relative, ".") {
+				add(relative)
+			}
+		}
+	}
+	domains := make([]string, 0, len(seen))
+	for domain := range seen {
+		domains = append(domains, domain)
+	}
+	sort.Strings(domains)
+	return domains
+}
