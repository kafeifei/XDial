diff --git a/protocol/tailscale/endpoint_dns_capture_xdial_test.go b/protocol/tailscale/endpoint_dns_capture_xdial_test.go
new file mode 100644
--- /dev/null
+++ b/protocol/tailscale/endpoint_dns_capture_xdial_test.go
@@ -0,0 +1,49 @@
+package tailscale
+
+import (
+	"net/netip"
+	"reflect"
+	"testing"
+
+	tsDNS "github.com/sagernet/tailscale/net/dns"
+	"github.com/sagernet/tailscale/types/dnstype"
+	"github.com/sagernet/tailscale/util/dnsname"
+)
+
+func TestXDialDNSCaptureDomainsFollowTailscaleConfig(t *testing.T) {
+	tailnet := mustXDialFQDN(t, "example-tailnet.ts.net")
+	member := mustXDialFQDN(t, "mba32k.example-tailnet.ts.net")
+	shared := mustXDialFQDN(t, "shared.other-tailnet.ts.net")
+	corp := mustXDialFQDN(t, "corp.example.com")
+
+	got := tailscaleDNSCaptureDomains(&tsDNS.Config{
+		SearchDomains: []dnsname.FQDN{tailnet},
+		Routes: map[dnsname.FQDN][]*dnstype.Resolver{
+			tailnet: nil,
+			corp:    nil,
+		},
+		Hosts: map[dnsname.FQDN][]netip.Addr{
+			member: {netip.MustParseAddr("100.64.0.8")},
+			shared: {netip.MustParseAddr("100.64.0.9")},
+		},
+	})
+	want := []string{
+		"corp.example.com",
+		"example-tailnet.ts.net",
+		"mba32k",
+		"mba32k.example-tailnet.ts.net",
+		"shared.other-tailnet.ts.net",
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("capture domains = %v, want %v", got, want)
+	}
+}
+
+func mustXDialFQDN(t *testing.T, value string) dnsname.FQDN {
+	t.Helper()
+	fqdn, err := dnsname.ToFQDN(value)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return fqdn
+}
