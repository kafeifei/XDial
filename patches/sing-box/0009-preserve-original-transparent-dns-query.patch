+package dns
+
+import (
+	"bytes"
+	"context"
+
+	M "github.com/sagernet/sing/common/metadata"
+)
+
+type xdialOriginalQueryContextKey struct{}
+type xdialOriginalQueryTargetContextKey struct{}
+
+// XDialOriginalQuery is the exact DNS request received from the macOS
+// Transparent Proxy together with the application's original resolver
+// endpoint. It is process-local metadata and never leaves the DNS exchange.
+type XDialOriginalQuery struct {
+	Network     string
+	Payload     []byte
+	Destination M.Socksaddr
+}
+
+type xdialOriginalQueryTarget struct {
+	network     string
+	destination M.Socksaddr
+}
+
+func ContextWithXDialOriginalQuery(
+	ctx context.Context,
+	network string,
+	payload []byte,
+	destination M.Socksaddr,
+) context.Context {
+	return context.WithValue(ctx, xdialOriginalQueryContextKey{}, XDialOriginalQuery{
+		Network:     network,
+		Payload:     bytes.Clone(payload),
+		Destination: destination,
+	})
+}
+
+func XDialOriginalQueryFromContext(ctx context.Context) (XDialOriginalQuery, bool) {
+	query, loaded := ctx.Value(xdialOriginalQueryContextKey{}).(XDialOriginalQuery)
+	if !loaded {
+		return XDialOriginalQuery{}, false
+	}
+	query.Payload = bytes.Clone(query.Payload)
+	return query, true
+}
+
+// ContextWithXDialOriginalQueryTarget carries the TCP resolver endpoint until
+// the length-prefixed DNS payload has been read by protocol/dns.
+func ContextWithXDialOriginalQueryTarget(
+	ctx context.Context,
+	network string,
+	destination M.Socksaddr,
+) context.Context {
+	return context.WithValue(ctx, xdialOriginalQueryTargetContextKey{}, xdialOriginalQueryTarget{
+		network:     network,
+		destination: destination,
+	})
+}
+
+func ContextWithXDialOriginalQueryPayload(ctx context.Context, payload []byte) context.Context {
+	target, loaded := ctx.Value(xdialOriginalQueryTargetContextKey{}).(xdialOriginalQueryTarget)
+	if !loaded {
+		return ctx
+	}
+	return ContextWithXDialOriginalQuery(
+		ctx,
+		target.network,
+		payload,
+		target.destination,
+	)
+}
