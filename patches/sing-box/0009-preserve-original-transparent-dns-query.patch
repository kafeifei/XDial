+func TestXDialOriginalQueryContextOwnsPayload(t *testing.T) {
+	target := M.SocksaddrFrom(netip.MustParseAddr("192.0.2.53"), 53)
+	payload := []byte{1, 2, 3}
+	ctx := ContextWithXDialOriginalQuery(
+		context.Background(),
+		N.NetworkUDP,
+		payload,
+		target,
+	)
+	payload[0] = 9
+
+	query, loaded := XDialOriginalQueryFromContext(ctx)
+	if !loaded || query.Network != N.NetworkUDP ||
+		query.Destination != target || query.Payload[0] != 1 {
+		t.Fatalf("unexpected original query: loaded=%v query=%+v", loaded, query)
+	}
+	query.Payload[0] = 8
+	second, _ := XDialOriginalQueryFromContext(ctx)
+	if second.Payload[0] != 1 {
+		t.Fatal("original query payload escaped context ownership")
+	}
+}
+
+func TestXDialOriginalQueryTCPPayloadJoinsCapturedTarget(t *testing.T) {
+	target := M.SocksaddrFrom(netip.MustParseAddr("192.0.2.53"), 53)
+	ctx := ContextWithXDialOriginalQueryTarget(
+		context.Background(),
+		N.NetworkTCP,
+		target,
+	)
+	ctx = ContextWithXDialOriginalQueryPayload(ctx, []byte{4, 5, 6})
+	query, loaded := XDialOriginalQueryFromContext(ctx)
+	if !loaded || query.Network != N.NetworkTCP ||
+		query.Destination != target || len(query.Payload) != 3 {
+		t.Fatalf("unexpected TCP original query: loaded=%v query=%+v", loaded, query)
+	}
+}
