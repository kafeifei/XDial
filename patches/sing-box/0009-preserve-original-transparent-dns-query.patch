+func xdialExchangeOriginalQuery(
+	ctx context.Context,
+	dialer N.Dialer,
+	message *mDNS.Msg,
+	originalQuery dns.XDialOriginalQuery,
+) (*mDNS.Msg, error) {
+	if message == nil || len(message.Question) == 0 {
+		return nil, E.New("invalid original DNS question")
+	}
+	if len(originalQuery.Payload) < 12 || len(originalQuery.Payload) > 65535 ||
+		(originalQuery.Network != N.NetworkUDP &&
+			originalQuery.Network != N.NetworkTCP) ||
+		!originalQuery.Destination.IsIP() ||
+		originalQuery.Destination.Port != 53 ||
+		originalQuery.Destination.Addr.IsUnspecified() ||
+		originalQuery.Destination.Addr.IsMulticast() {
+		return nil, E.New("invalid original DNS flow")
+	}
+	var wireRequest mDNS.Msg
+	if err := wireRequest.Unpack(originalQuery.Payload); err != nil ||
+		wireRequest.Response ||
+		wireRequest.Id != message.Id ||
+		len(wireRequest.Question) != len(message.Question) {
+		return nil, E.New("original DNS request does not match exchange")
+	}
+	for index := range wireRequest.Question {
+		if wireRequest.Question[index] != message.Question[index] {
+			return nil, E.New("original DNS request does not match exchange")
+		}
+	}
+
+	conn, err := dialer.DialContext(
+		ctx,
+		originalQuery.Network,
+		originalQuery.Destination,
+	)
+	if err != nil {
+		return nil, E.Cause(err, "dial original DNS resolver")
+	}
+	defer conn.Close()
+	if deadline, loaded := ctx.Deadline(); loaded {
+		if err := conn.SetDeadline(deadline); err != nil {
+			return nil, E.Cause(err, "set original DNS deadline")
+		}
+	}
+
+	var rawResponse []byte
+	switch originalQuery.Network {
+	case N.NetworkUDP:
+		written, writeErr := conn.Write(originalQuery.Payload)
+		if writeErr != nil {
+			return nil, E.Cause(writeErr, "write original DNS request")
+		}
+		if written != len(originalQuery.Payload) {
+			return nil, io.ErrShortWrite
+		}
+		responseBuffer := make([]byte, 65535)
+		read, readErr := conn.Read(responseBuffer)
+		if readErr != nil {
+			return nil, E.Cause(readErr, "read original DNS response")
+		}
+		rawResponse = responseBuffer[:read]
+	case N.NetworkTCP:
+		frame := make([]byte, 2+len(originalQuery.Payload))
+		binary.BigEndian.PutUint16(frame, uint16(len(originalQuery.Payload)))
+		copy(frame[2:], originalQuery.Payload)
+		if _, err := io.Copy(conn, bytes.NewReader(frame)); err != nil {
+			return nil, E.Cause(err, "write original DNS request")
+		}
+		var responseLength uint16
+		if err := binary.Read(conn, binary.BigEndian, &responseLength); err != nil {
+			return nil, E.Cause(err, "read original DNS response length")
+		}
+		if responseLength == 0 {
+			return nil, E.New("empty original DNS response")
+		}
+		rawResponse = make([]byte, int(responseLength))
+		if _, err := io.ReadFull(conn, rawResponse); err != nil {
+			return nil, E.Cause(err, "read original DNS response")
+		}
+	default:
+		return nil, E.New("invalid original DNS network")
+	}
+
+	var response mDNS.Msg
+	if err := response.Unpack(rawResponse); err != nil ||
+		!response.Response ||
+		response.Id != wireRequest.Id ||
+		len(response.Question) == 0 ||
+		response.Question[0] != wireRequest.Question[0] {
+		return nil, E.New("invalid original DNS response")
+	}
+	return &response, nil
+}
