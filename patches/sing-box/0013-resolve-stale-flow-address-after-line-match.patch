@@ -0,0 +1,52 @@
+package route
+
+import (
+	"net/netip"
+	"testing"
+
+	"github.com/sagernet/sing-box/adapter"
+	C "github.com/sagernet/sing-box/constant"
+	M "github.com/sagernet/sing/common/metadata"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestXDialFlowDomainForResolveUsesMatchedSingleStackStrategy(t *testing.T) {
+	tests := []struct {
+		name        string
+		destination string
+		trusted     bool
+		domain      string
+		strategy    C.DomainStrategy
+		want        string
+	}{
+		{"ordinary-domain", "example.com", false, "", C.DomainStrategyAsIS, "example.com"},
+		{"ipv6-to-ipv4", "2001:db8::10", true, "example.com", C.DomainStrategyIPv4Only, "example.com"},
+		{"ipv4-to-ipv6", "192.0.2.10", true, "example.com", C.DomainStrategyIPv6Only, "example.com"},
+		{"dual-stack-keeps-ip", "2001:db8::10", true, "example.com", C.DomainStrategyAsIS, ""},
+		{"same-family-keeps-ip", "192.0.2.10", true, "example.com", C.DomainStrategyIPv4Only, ""},
+		{"untrusted-keeps-ip", "2001:db8::10", false, "example.com", C.DomainStrategyIPv4Only, ""},
+		{"literal-keeps-ip", "2001:db8::10", true, "", C.DomainStrategyIPv4Only, ""},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			var destination M.Socksaddr
+			if address, err := netip.ParseAddr(test.destination); err == nil {
+				destination = M.SocksaddrFrom(address, 443)
+			} else {
+				destination = M.Socksaddr{Fqdn: test.destination, Port: 443}
+			}
+			metadata := &adapter.InboundContext{
+				Destination: destination,
+				Domain:      test.domain,
+				XDialOriginalDestinationDomain: func() string {
+					if test.trusted {
+						return test.domain
+					}
+					return ""
+				}(),
+			}
+			require.Equal(t, test.want, xdialFlowDomainForResolve(metadata, test.strategy))
+		})
+	}
+}
