+
+func xdialFlowDomainForResolve(
+	metadata *adapter.InboundContext,
+	strategy C.DomainStrategy,
+) string {
+	if metadata.Destination.IsDomain() {
+		return metadata.Destination.Fqdn
+	}
+	trustedDomain := metadata.XDialOriginalDestinationDomain
+	if !M.IsDomainName(trustedDomain) {
+		return ""
+	}
+	if strategy == C.DomainStrategyIPv4Only &&
+		metadata.Destination.Addr.Is6() ||
+		strategy == C.DomainStrategyIPv6Only &&
+			metadata.Destination.Addr.Is4() {
+		return trustedDomain
+	}
+	return ""
+}
