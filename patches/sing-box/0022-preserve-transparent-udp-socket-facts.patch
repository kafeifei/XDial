@@ -0,0 +1,137 @@
+package direct
+
+import (
+	"context"
+	"net"
+	"net/netip"
+	"strconv"
+	"syscall"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing-box/common/dialer"
+	"github.com/sagernet/sing-box/option"
+	M "github.com/sagernet/sing/common/metadata"
+
+	"github.com/stretchr/testify/require"
+	"golang.org/x/sys/unix"
+)
+
+func TestXDialSourcePortDialerOptionsKeepBaseAndInterface(t *testing.T) {
+	base := option.DialerOptions{
+		AbstractDialerOptions: option.AbstractDialerOptions{
+			DomainResolver: &option.DomainResolveOptions{Server: "xdial-native-dns"},
+		},
+	}
+	options := xdialSourcePortDialerOptions(base, "en0", 5901, netip.Addr{})
+	require.Equal(t, uint16(5901), options.UDPBindPort)
+	require.True(t, options.ReuseAddr)
+	require.Equal(t, "en0", options.BindInterface)
+	require.Equal(t, "xdial-native-dns", options.DomainResolver.Server)
+	require.Zero(t, base.UDPBindPort)
+	require.False(t, base.ReuseAddr)
+	require.Nil(t, options.Inet4BindAddress)
+	require.Nil(t, options.Inet6BindAddress)
+
+	unbound := xdialSourcePortDialerOptions(base, "", 5900, netip.Addr{})
+	require.Empty(t, unbound.BindInterface)
+
+	v4 := xdialSourcePortDialerOptions(base, "", 5900, netip.MustParseAddr("192.168.1.20"))
+	require.Equal(t, netip.MustParseAddr("192.168.1.20"), v4.Inet4BindAddress.Build(netip.Addr{}))
+	require.Nil(t, v4.Inet6BindAddress)
+	v6 := xdialSourcePortDialerOptions(base, "", 5900, netip.MustParseAddr("fd7a:115c:a1e0::1"))
+	require.Equal(t, netip.MustParseAddr("fd7a:115c:a1e0::1"), v6.Inet6BindAddress.Build(netip.Addr{}))
+	require.Nil(t, v6.Inet4BindAddress)
+	require.Nil(t, base.Inet4BindAddress)
+}
+
+func xdialApplicationSocket(t *testing.T, address string, share bool) uint16 {
+	t.Helper()
+	conn := xdialSharedSocket(t, address, 0, share)
+	return uint16(conn.LocalAddr().(*net.UDPAddr).Port)
+}
+
+func xdialSharedSocket(t *testing.T, address string, port uint16, share bool) net.PacketConn {
+	t.Helper()
+	listenConfig := net.ListenConfig{Control: func(_, _ string, raw syscall.RawConn) error {
+		if !share {
+			return nil
+		}
+		var optionErr error
+		err := raw.Control(func(fd uintptr) {
+			optionErr = unix.SetsockoptInt(int(fd), unix.SOL_SOCKET, unix.SO_REUSEADDR, 1)
+			if optionErr == nil {
+				optionErr = unix.SetsockoptInt(int(fd), unix.SOL_SOCKET, unix.SO_REUSEPORT, 1)
+			}
+		})
+		if err != nil {
+			return err
+		}
+		return optionErr
+	}}
+	conn, err := listenConfig.ListenPacket(context.Background(), "udp4", net.JoinHostPort(address, strconv.Itoa(int(port))))
+	require.NoError(t, err)
+	t.Cleanup(func() { conn.Close() })
+	return conn
+}
+
+func xdialListenOnSourcePort(sourcePort uint16, sourceAddress netip.Addr) (net.PacketConn, error) {
+	portDialer, err := dialer.NewDefault(context.Background(), xdialSourcePortDialerOptions(option.DialerOptions{}, "", sourcePort, sourceAddress))
+	if err != nil {
+		return nil, err
+	}
+	return portDialer.ListenPacket(context.Background(), M.ParseSocksaddrHostPort("127.0.0.1", 9))
+}
+
+// Screen Sharing's media sockets share their ports: the viewer binds the
+// wildcard address, the shared Mac its own address. The Direct socket joins
+// either on the same address, so the peer's datagrams to that port have a
+// receiver. A port the application holds exclusively refuses the bind, and
+// the flow keeps an ephemeral port.
+func TestXDialSourcePortDialerJoinsTheApplicationPort(t *testing.T) {
+	for name, application := range map[string]struct {
+		address       string
+		sourceAddress netip.Addr
+	}{
+		"shared wildcard":         {"0.0.0.0", netip.Addr{}},
+		"shared specific address": {"127.0.0.1", netip.MustParseAddr("127.0.0.1")},
+	} {
+		sourcePort := xdialApplicationSocket(t, application.address, true)
+		conn, err := xdialListenOnSourcePort(sourcePort, application.sourceAddress)
+		require.NoError(t, err, name)
+		local := conn.LocalAddr().(*net.UDPAddr)
+		require.Equal(t, int(sourcePort), local.Port, name)
+		require.Equal(t, application.address, local.IP.String(), name)
+		conn.Close()
+	}
+
+	exclusivePort := xdialApplicationSocket(t, "0.0.0.0", false)
+	_, err := xdialListenOnSourcePort(exclusivePort, netip.Addr{})
+	require.Error(t, err)
+}
+
+// Why the Direct socket binds the application's address: a peer's datagram
+// to a port goes to the socket bound to that exact address before any
+// wildcard socket. Had the flow joined a specific-address port on the
+// wildcard, the peer's media would never reach it.
+func TestXDialPeerDatagramsPreferTheApplicationAddress(t *testing.T) {
+	application := xdialSharedSocket(t, "127.0.0.1", 0, true)
+	sourcePort := uint16(application.LocalAddr().(*net.UDPAddr).Port)
+	wildcard, err := xdialListenOnSourcePort(sourcePort, netip.Addr{})
+	require.NoError(t, err)
+	defer wildcard.Close()
+
+	peer, err := net.DialUDP("udp4", nil, &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1), Port: int(sourcePort)})
+	require.NoError(t, err)
+	defer peer.Close()
+	_, err = peer.Write([]byte("media"))
+	require.NoError(t, err)
+
+	wildcard.SetReadDeadline(time.Now().Add(200 * time.Millisecond))
+	_, _, err = wildcard.ReadFrom(make([]byte, 16))
+	require.Error(t, err, "the wildcard socket never sees the peer's datagram")
+	application.SetReadDeadline(time.Now().Add(time.Second))
+	n, _, err := application.ReadFrom(make([]byte, 16))
+	require.NoError(t, err, "the datagram went to the application's own socket")
+	require.Equal(t, len("media"), n)
+}
