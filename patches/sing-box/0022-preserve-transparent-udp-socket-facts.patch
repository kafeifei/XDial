diff --git a/protocol/socks/xdial_udp_association.go b/protocol/socks/xdial_udp_association.go
new file mode 100644
--- /dev/null
+++ b/protocol/socks/xdial_udp_association.go
@@ -0,0 +1,128 @@
+package socks
+
+import (
+	"bytes"
+	"encoding/binary"
+	"net/netip"
+
+	"github.com/sagernet/sing-box/adapter"
+	E "github.com/sagernet/sing/common/exceptions"
+	M "github.com/sagernet/sing/common/metadata"
+)
+
+var xdialUDPAssociationMagic = []byte{0x00, 0x58, 0x44, 0x03}
+
+const (
+	xdialSourcePortFlag    = byte(1 << 3)
+	xdialSourceAddressFlag = byte(1 << 4)
+)
+
+// xdialUDPAssociation holds what the relay states about the application
+// socket behind one UDP ASSOCIATE. These are facts of the socket, not a
+// destination: every datagram still names its own target.
+type xdialUDPAssociation struct {
+	boundInterface string
+	sourcePort     uint16
+	// sourceAddress is the address the application bound its socket to, when
+	// it is not the wildcard. A peer's datagram goes to the most specific
+	// socket on its port, so the flow's own socket must bind the same address.
+	sourceAddress netip.Addr
+}
+
+func (a xdialUDPAssociation) apply(metadata *adapter.InboundContext) {
+	metadata.XDialBoundInterface = a.boundInterface
+	metadata.XDialSourcePort = a.sourcePort
+	metadata.XDialSourceAddress = a.sourceAddress
+}
+
+// parseXDialUDPAssociation decodes the UDP ASSOCIATE request address. An
+// ordinary address carries no facts and is not an error.
+func parseXDialUDPAssociation(request M.Socksaddr) (xdialUDPAssociation, bool, error) {
+	if !request.IsDomain() {
+		return xdialUDPAssociation{}, false, nil
+	}
+	raw := []byte(request.Fqdn)
+	if !bytes.HasPrefix(raw, xdialUDPAssociationMagic) {
+		return xdialUDPAssociation{}, false, nil
+	}
+	offset := len(xdialUDPAssociationMagic)
+	if len(raw) <= offset {
+		return xdialUDPAssociation{}, true, E.New("invalid XDial UDP association")
+	}
+	flags := raw[offset]
+	offset++
+	const knownFlags = xdialBoundInterfaceFlag | xdialSourcePortFlag | xdialSourceAddressFlag
+	if flags == 0 || flags&^knownFlags != 0 {
+		return xdialUDPAssociation{}, true, E.New("invalid XDial UDP association flags")
+	}
+	if flags&xdialSourceAddressFlag != 0 && flags&xdialSourcePortFlag == 0 {
+		return xdialUDPAssociation{}, true, E.New("invalid XDial UDP association flags")
+	}
+
+	var association xdialUDPAssociation
+	if flags&xdialBoundInterfaceFlag != 0 {
+		if len(raw) <= offset {
+			return xdialUDPAssociation{}, true, E.New("invalid XDial bound interface")
+		}
+		interfaceLength := int(raw[offset])
+		offset++
+		if interfaceLength == 0 || interfaceLength > 15 ||
+			len(raw) < offset+interfaceLength ||
+			!xdialValidInterfaceName(raw[offset:offset+interfaceLength]) {
+			return xdialUDPAssociation{}, true, E.New("invalid XDial bound interface")
+		}
+		association.boundInterface = string(raw[offset : offset+interfaceLength])
+		offset += interfaceLength
+	}
+	if flags&xdialSourcePortFlag != 0 {
+		if len(raw) < offset+2 {
+			return xdialUDPAssociation{}, true, E.New("invalid XDial source port")
+		}
+		association.sourcePort = binary.BigEndian.Uint16(raw[offset:])
+		offset += 2
+		if association.sourcePort == 0 {
+			return xdialUDPAssociation{}, true, E.New("invalid XDial source port")
+		}
+	}
+	if flags&xdialSourceAddressFlag != 0 {
+		if len(raw) <= offset {
+			return xdialUDPAssociation{}, true, E.New("invalid XDial source address")
+		}
+		addressLength := 0
+		switch raw[offset] {
+		case 0x01:
+			addressLength = 4
+		case 0x04:
+			addressLength = 16
+		default:
+			return xdialUDPAssociation{}, true, E.New("invalid XDial source address family")
+		}
+		offset++
+		if len(raw) < offset+addressLength {
+			return xdialUDPAssociation{}, true, E.New("invalid XDial source address")
+		}
+		address, _ := netip.AddrFromSlice(raw[offset : offset+addressLength])
+		address = address.Unmap()
+		if address.IsUnspecified() || address.IsMulticast() {
+			return xdialUDPAssociation{}, true, E.New("invalid XDial source address")
+		}
+		association.sourceAddress = address
+		offset += addressLength
+	}
+	if offset != len(raw) {
+		return xdialUDPAssociation{}, true, E.New("invalid XDial UDP association")
+	}
+	return association, true, nil
+}
+
+func xdialValidInterfaceName(name []byte) bool {
+	for _, character := range name {
+		if !(character >= 'a' && character <= 'z') &&
+			!(character >= 'A' && character <= 'Z') &&
+			!(character >= '0' && character <= '9') &&
+			character != '.' && character != '_' && character != '-' {
+			return false
+		}
+	}
+	return true
+}
diff --git a/protocol/socks/xdial_udp_association_test.go b/protocol/socks/xdial_udp_association_test.go
new file mode 100644
--- /dev/null
+++ b/protocol/socks/xdial_udp_association_test.go
@@ -0,0 +1,94 @@
+package socks
+
+import (
+	"net/netip"
+	"testing"
+
+	M "github.com/sagernet/sing/common/metadata"
+
+	"github.com/stretchr/testify/require"
+)
+
+func xdialEncodedUDPAssociation(interfaceName string, sourcePort uint16) string {
+	raw := append([]byte(nil), xdialUDPAssociationMagic...)
+	var flags byte
+	if interfaceName != "" {
+		flags |= xdialBoundInterfaceFlag
+	}
+	if sourcePort != 0 {
+		flags |= xdialSourcePortFlag
+	}
+	raw = append(raw, flags)
+	if interfaceName != "" {
+		raw = append(raw, byte(len(interfaceName)))
+		raw = append(raw, interfaceName...)
+	}
+	if sourcePort != 0 {
+		raw = append(raw, byte(sourcePort>>8), byte(sourcePort))
+	}
+	return string(raw)
+}
+
+func TestXDialUDPAssociationCarriesSocketFacts(t *testing.T) {
+	association, encoded, err := parseXDialUDPAssociation(M.Socksaddr{
+		Fqdn: xdialEncodedUDPAssociation("en0", 5901),
+	})
+	require.NoError(t, err)
+	require.True(t, encoded)
+	require.Equal(t, xdialUDPAssociation{boundInterface: "en0", sourcePort: 5901}, association)
+
+	association, encoded, err = parseXDialUDPAssociation(M.Socksaddr{
+		Fqdn: xdialEncodedUDPAssociation("", 5900),
+	})
+	require.NoError(t, err)
+	require.True(t, encoded)
+	require.Equal(t, xdialUDPAssociation{sourcePort: 5900}, association)
+
+	withAddress := xdialEncodedUDPAssociation("en0", 5901) + "\x01\xc0\xa8\x01\x14"
+	withAddress = withAddress[:len(xdialUDPAssociationMagic)] +
+		string([]byte{withAddress[len(xdialUDPAssociationMagic)] | xdialSourceAddressFlag}) +
+		withAddress[len(xdialUDPAssociationMagic)+1:]
+	association, encoded, err = parseXDialUDPAssociation(M.Socksaddr{Fqdn: withAddress})
+	require.NoError(t, err)
+	require.True(t, encoded)
+	require.Equal(t, xdialUDPAssociation{
+		boundInterface: "en0",
+		sourcePort:     5901,
+		sourceAddress:  netip.MustParseAddr("192.168.1.20"),
+	}, association)
+
+	_, encoded, err = parseXDialUDPAssociation(M.ParseSocksaddrHostPort("0.0.0.0", 0))
+	require.NoError(t, err)
+	require.False(t, encoded)
+
+	// A bound-flow envelope always names an endpoint; it is not an association.
+	_, encoded, err = parseXDialUDPAssociation(M.Socksaddr{
+		Fqdn: string(append(append([]byte(nil), xdialBoundFlowMetadataMagic...), xdialBoundInterfaceFlag, 3, 'e', 'n', '0')),
+	})
+	require.NoError(t, err)
+	require.False(t, encoded)
+}
+
+func TestXDialUDPAssociationRejectsMalformedEnvelope(t *testing.T) {
+	valid := xdialEncodedUDPAssociation("en0", 5901)
+	for name, raw := range map[string]string{
+		"no flags":      string(xdialUDPAssociationMagic) + "\x00",
+		"unknown flag":  string(xdialUDPAssociationMagic) + "\x01",
+		"zero port":     string(xdialUDPAssociationMagic) + string([]byte{xdialSourcePortFlag, 0, 0}),
+		"short port":    string(xdialUDPAssociationMagic) + string([]byte{xdialSourcePortFlag, 0x17}),
+		"trailing byte": valid + "\x00",
+		"address without port": string(xdialUDPAssociationMagic) +
+			string([]byte{xdialSourceAddressFlag, 0x01, 192, 168, 1, 20}),
+		"wildcard address": string(xdialUDPAssociationMagic) +
+			string([]byte{xdialSourcePortFlag | xdialSourceAddressFlag, 0x17, 0x0d, 0x01, 0, 0, 0, 0}),
+		"short address": string(xdialUDPAssociationMagic) +
+			string([]byte{xdialSourcePortFlag | xdialSourceAddressFlag, 0x17, 0x0d, 0x04, 0xfd}),
+		"bad family": string(xdialUDPAssociationMagic) +
+			string([]byte{xdialSourcePortFlag | xdialSourceAddressFlag, 0x17, 0x0d, 0x03, 1, 2, 3, 4}),
+		"bad interface": xdialEncodedUDPAssociation("en/0", 5901),
+	} {
+		_, encoded, err := parseXDialUDPAssociation(M.Socksaddr{Fqdn: raw})
+		require.Error(t, err, name)
+		require.True(t, encoded, name)
+	}
+}
