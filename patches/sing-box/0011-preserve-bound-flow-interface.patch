+func applyXDialBoundFlowMetadata(
+	metadata *adapter.InboundContext,
+	raw []byte,
+	reresolveIPv6Domains bool,
+) error {
+	offset := len(xdialBoundFlowMetadataMagic)
+	if len(raw) <= offset {
+		return E.New("invalid XDial bound flow metadata")
+	}
+	flags := raw[offset]
+	offset++
+	const (
+		hasEndpoint = byte(1 << 0)
+		hasHostname = byte(1 << 1)
+		knownFlags  = hasEndpoint | hasHostname | xdialBoundInterfaceFlag
+	)
+	if flags&^knownFlags != 0 || flags&xdialBoundInterfaceFlag == 0 ||
+		flags&hasHostname != 0 && flags&hasEndpoint == 0 {
+		return E.New("invalid XDial bound flow metadata flags")
+	}
+
+	var address netip.Addr
+	if flags&hasEndpoint != 0 {
+		if len(raw) <= offset {
+			return E.New("invalid XDial bound flow metadata")
+		}
+		addressLength := 0
+		switch raw[offset] {
+		case 0x01:
+			addressLength = 4
+		case 0x04:
+			addressLength = 16
+		default:
+			return E.New("invalid XDial bound flow address family")
+		}
+		offset++
+		if len(raw) < offset+addressLength {
+			return E.New("invalid XDial bound flow address")
+		}
+		var valid bool
+		address, valid = netip.AddrFromSlice(raw[offset : offset+addressLength])
+		if !valid || address.IsUnspecified() || address.IsMulticast() {
+			return E.New("invalid XDial bound flow address")
+		}
+		address = address.Unmap()
+		offset += addressLength
+	}
+
+	var hostname string
+	if flags&hasHostname != 0 {
+		if len(raw) <= offset {
+			return E.New("invalid XDial bound flow hostname")
+		}
+		hostnameLength := int(raw[offset])
+		offset++
+		if hostnameLength == 0 || len(raw) < offset+hostnameLength {
+			return E.New("invalid XDial bound flow hostname")
+		}
+		hostnameBytes := raw[offset : offset+hostnameLength]
+		if !utf8.Valid(hostnameBytes) || bytes.IndexByte(hostnameBytes, 0) >= 0 {
+			return E.New("invalid XDial bound flow hostname")
+		}
+		hostname = string(hostnameBytes)
+		if len(hostname) > 253 || strings.TrimSpace(hostname) != hostname ||
+			!M.IsDomainName(hostname) {
+			return E.New("invalid XDial bound flow hostname")
+		}
+		offset += hostnameLength
+	}
+
+	if len(raw) <= offset {
+		return E.New("invalid XDial bound interface")
+	}
+	interfaceLength := int(raw[offset])
+	offset++
+	if interfaceLength == 0 || interfaceLength > 15 ||
+		len(raw) != offset+interfaceLength {
+		return E.New("invalid XDial bound interface")
+	}
+	interfaceBytes := raw[offset:]
+	for _, character := range interfaceBytes {
+		if !(character >= 'a' && character <= 'z') &&
+			!(character >= 'A' && character <= 'Z') &&
+			!(character >= '0' && character <= '9') &&
+			character != '.' && character != '_' && character != '-' {
+			return E.New("invalid XDial bound interface")
+		}
+	}
+
+	metadata.XDialBoundInterface = string(interfaceBytes)
+	if flags&hasEndpoint == 0 {
+		metadata.Destination = M.Socksaddr{}
+		return nil
+	}
+
+	port := metadata.Destination.Port
+	metadata.Domain = hostname
+	if reresolveIPv6Domains && hostname != "" && address.Is6() {
+		metadata.Destination = M.Socksaddr{
+			Fqdn: hostname,
+			Port: port,
+		}
+	} else {
+		metadata.Destination = M.SocksaddrFrom(address, port)
+	}
+	return nil
+}
