+func xdialBoundDialerOptions(
+	base option.DialerOptions,
+	interfaceName string,
+) option.DialerOptions {
+	base.BindInterface = interfaceName
+	return base
+}
+
+func (h *Outbound) dialerForContext(
+	ctx context.Context,
+) (dialer.ParallelInterfaceDialer, error) {
+	metadata := adapter.ContextFrom(ctx)
+	if metadata == nil || metadata.XDialBoundInterface == "" {
+		return h.dialer, nil
+	}
+	interfaceName := metadata.XDialBoundInterface
+	h.boundDialerMu.Lock()
+	defer h.boundDialerMu.Unlock()
+	if boundDialer := h.boundDialers[interfaceName]; boundDialer != nil {
+		return boundDialer, nil
+	}
+	newDialer, err := dialer.NewWithOptions(dialer.Options{
+		Context: h.ctx,
+		Options: xdialBoundDialerOptions(
+			h.dialerOptions,
+			interfaceName,
+		),
+		RemoteIsDomain: true,
+		DirectOutbound: true,
+	})
+	if err != nil {
+		return nil, err
+	}
+	boundDialer, loaded := newDialer.(dialer.ParallelInterfaceDialer)
+	if !loaded {
+		return nil, E.New("bound Direct dialer lacks parallel interface support")
+	}
+	h.boundDialers[interfaceName] = boundDialer
+	return boundDialer, nil
+}
