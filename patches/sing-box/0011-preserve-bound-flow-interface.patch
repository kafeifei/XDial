+
+func xdialEncodedBoundDestination(
+	address netip.Addr,
+	hostname string,
+	interfaceName string,
+) string {
+	raw := append([]byte(nil), xdialBoundFlowMetadataMagic...)
+	flags := byte(0x01 | xdialBoundInterfaceFlag)
+	if hostname != "" {
+		flags |= 0x02
+	}
+	raw = append(raw, flags)
+	if address.Is4() {
+		raw = append(raw, 0x01)
+	} else {
+		raw = append(raw, 0x04)
+	}
+	raw = append(raw, address.AsSlice()...)
+	if hostname != "" {
+		raw = append(raw, byte(len(hostname)))
+		raw = append(raw, hostname...)
+	}
+	raw = append(raw, byte(len(interfaceName)))
+	raw = append(raw, interfaceName...)
+	return string(raw)
+}
+
+func TestXDialBoundFlowMetadataPreservesInterfaceForDirect(t *testing.T) {
+	address := netip.MustParseAddr("192.168.69.26")
+	metadata := adapter.InboundContext{
+		Destination: M.Socksaddr{
+			Fqdn: xdialEncodedBoundDestination(
+				address,
+				"Kafeifeis-iPhone.local.",
+				"en0",
+			),
+			Port: 49152,
+		},
+	}
+
+	encoded, err := applyXDialFlowMetadata(&metadata, false)
+	require.NoError(t, err)
+	require.True(t, encoded)
+	require.Equal(t, "en0", metadata.XDialBoundInterface)
+	require.Equal(t, "Kafeifeis-iPhone.local.", metadata.Domain)
+	require.Equal(t, address, metadata.Destination.Addr)
+	require.Equal(t, uint16(49152), metadata.Destination.Port)
+}
+
+func TestXDialBoundUDPAssociationPreservesInterfaceWithoutDestination(t *testing.T) {
+	raw := append([]byte(nil), xdialBoundFlowMetadataMagic...)
+	raw = append(raw, xdialBoundInterfaceFlag, 0x03)
+	raw = append(raw, "en0"...)
+	metadata := adapter.InboundContext{
+		Destination: M.Socksaddr{Fqdn: string(raw)},
+	}
+
+	encoded, err := applyXDialFlowMetadata(&metadata, false)
+	require.NoError(t, err)
+	require.True(t, encoded)
+	require.Equal(t, "en0", metadata.XDialBoundInterface)
+	require.False(t, metadata.Destination.IsValid())
+}
+
+func TestXDialBoundFlowMetadataRejectsInvalidInterface(t *testing.T) {
+	address := netip.MustParseAddr("192.168.69.26")
+	metadata := adapter.InboundContext{
+		Destination: M.Socksaddr{
+			Fqdn: xdialEncodedBoundDestination(
+				address,
+				"device.local.",
+				"bad/name",
+			),
+			Port: 443,
+		},
+	}
+
+	encoded, err := applyXDialFlowMetadata(&metadata, false)
+	require.Error(t, err)
+	require.True(t, encoded)
+	require.Empty(t, metadata.XDialBoundInterface)
+}
