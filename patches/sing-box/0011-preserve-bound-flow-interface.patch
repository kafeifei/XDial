@@ -0,0 +1,25 @@
+package direct
+
+import (
+	"testing"
+
+	"github.com/sagernet/sing-box/option"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestXDialBoundDialerOptionsOnlyOverridesInterface(t *testing.T) {
+	base := option.DialerOptions{
+		AbstractDialerOptions: option.AbstractDialerOptions{
+			DomainResolver: &option.DomainResolveOptions{
+				Server: "xdial-native-dns",
+			},
+		},
+	}
+
+	bound := xdialBoundDialerOptions(base, "en0")
+
+	require.Empty(t, base.BindInterface)
+	require.Equal(t, "en0", bound.BindInterface)
+	require.Equal(t, "xdial-native-dns", bound.DomainResolver.Server)
+}
