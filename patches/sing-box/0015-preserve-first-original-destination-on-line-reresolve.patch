+func TestXDialActionResolveReplacesStaleIPAfterAddressResult(t *testing.T) {
+	addresses := []netip.Addr{netip.MustParseAddr("192.0.2.30")}
+	resolver := &xdialResolveDNSRouter{addresses: addresses}
+	router := &Router{
+		dns:    resolver,
+		logger: log.NewNOPFactory().NewLogger("router"),
+	}
+	staleDestination := M.SocksaddrFrom(
+		netip.MustParseAddr("2001:db8::10"),
+		443,
+	)
+	metadata := &adapter.InboundContext{
+		Destination:                    staleDestination,
+		Domain:                         "sniffed.example",
+		XDialOriginalDestinationDomain: "example.com",
+		IPVersion:                      6,
+	}
+
+	err := router.actionResolve(context.Background(), metadata, &R.RuleActionResolve{
+		Strategy: C.DomainStrategyIPv4Only,
+	})
+
+	require.NoError(t, err)
+	require.Equal(t, "example.com", resolver.domain)
+	require.Equal(t, C.DomainStrategyIPv4Only, resolver.options.Strategy)
+	require.Equal(t, staleDestination, metadata.RouteOriginalDestination)
+	require.Equal(t, "example.com", metadata.Destination.Fqdn)
+	require.False(t, metadata.Destination.Addr.IsValid())
+	require.Equal(t, uint16(443), metadata.Destination.Port)
+	require.Equal(t, "example.com", metadata.Domain)
+	require.Zero(t, metadata.IPVersion)
+	require.Equal(t, addresses, metadata.DestinationAddresses)
+}
