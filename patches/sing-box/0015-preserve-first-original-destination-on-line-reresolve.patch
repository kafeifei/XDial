+func TestXDialApplyResolvedFlowDomainPreservesFirstOriginalDestination(t *testing.T) {
+	staleDestination := M.SocksaddrFrom(
+		netip.MustParseAddr("2001:db8::10"),
+		443,
+	)
+	firstOriginalDestination := M.SocksaddrFrom(
+		netip.MustParseAddr("192.0.2.20"),
+		8443,
+	)
+	metadata := &adapter.InboundContext{
+		Destination:              staleDestination,
+		RouteOriginalDestination: firstOriginalDestination,
+		IPVersion:                6,
+	}
+
+	xdialApplyResolvedFlowDomain(metadata, "example.com")
+
+	require.Equal(t, firstOriginalDestination, metadata.RouteOriginalDestination)
+	require.Equal(t, "example.com", metadata.Destination.Fqdn)
+	require.False(t, metadata.Destination.Addr.IsValid())
+	require.Equal(t, uint16(443), metadata.Destination.Port)
+	require.Equal(t, "example.com", metadata.Domain)
+	require.Zero(t, metadata.IPVersion)
+
+	metadata = &adapter.InboundContext{Destination: staleDestination}
+	xdialApplyResolvedFlowDomain(metadata, "example.com")
+	require.Equal(t, staleDestination, metadata.RouteOriginalDestination)
+}
+
+type xdialResolveDNSRouter struct {
+	adapter.DNSRouter
+	addresses []netip.Addr
+	domain    string
+	options   adapter.DNSQueryOptions
+}
+
+func (r *xdialResolveDNSRouter) Lookup(
+	_ context.Context,
+	domain string,
+	options adapter.DNSQueryOptions,
+) ([]netip.Addr, error) {
+	r.domain = domain
+	r.options = options
+	return r.addresses, nil
+}
+
+func TestXDialActionResolveFailsClosedOnEmptyAddressResult(t *testing.T) {
+	resolver := &xdialResolveDNSRouter{}
+	router := &Router{
+		dns:    resolver,
+		logger: log.NewNOPFactory().NewLogger("router"),
+	}
+	staleDestination := M.SocksaddrFrom(
+		netip.MustParseAddr("2001:db8::10"),
+		443,
+	)
+	metadata := &adapter.InboundContext{
+		Destination:                    staleDestination,
+		Domain:                         "sniffed.example",
+		XDialOriginalDestinationDomain: "example.com",
+		IPVersion:                      6,
+	}
+	before := *metadata
+
+	err := router.actionResolve(context.Background(), metadata, &R.RuleActionResolve{
+		Strategy: C.DomainStrategyIPv4Only,
+	})
+
+	require.ErrorContains(t, err, "DNS response does not contain any addresses")
+	require.Equal(t, before, *metadata)
+	require.Equal(t, "example.com", resolver.domain)
+	require.Equal(t, C.DomainStrategyIPv4Only, resolver.options.Strategy)
+}
