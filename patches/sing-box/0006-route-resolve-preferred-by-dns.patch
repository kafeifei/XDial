@@ -0,0 +1,58 @@
+package rule
+
+import (
+	"context"
+	"testing"
+
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/log"
+	"github.com/sagernet/sing-box/option"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestXDialResolvePreferredByUsesDNSTransport(t *testing.T) {
+	t.Parallel()
+
+	rule, err := NewDefaultRule(
+		context.Background(),
+		log.NewNOPFactory().NewLogger("router"),
+		option.DefaultRule{
+			RawDefaultRule: option.RawDefaultRule{
+				PreferredBy: []string{"memory-dns"},
+			},
+			RuleAction: option.RuleAction{
+				Action: C.RuleActionTypeResolve,
+				ResolveOptions: option.RouteActionResolve{
+					Server: "memory-dns",
+				},
+			},
+		},
+	)
+	require.NoError(t, err)
+	require.Len(t, rule.items, 1)
+	require.IsType(t, &PreferredByDNSItem{}, rule.items[0])
+}
+
+func TestXDialRoutePreferredByKeepsOutboundSemantics(t *testing.T) {
+	t.Parallel()
+
+	rule, err := NewDefaultRule(
+		context.Background(),
+		log.NewNOPFactory().NewLogger("router"),
+		option.DefaultRule{
+			RawDefaultRule: option.RawDefaultRule{
+				PreferredBy: []string{"tailscale"},
+			},
+			RuleAction: option.RuleAction{
+				Action: C.RuleActionTypeRoute,
+				RouteOptions: option.RouteActionOptions{
+					Outbound: "tailscale",
+				},
+			},
+		},
+	)
+	require.NoError(t, err)
+	require.Len(t, rule.items, 1)
+	require.IsType(t, &PreferredByItem{}, rule.items[0])
+}
