+
+func TestXDialFlowMetadataReresolvesAttributedIPv6Destination(t *testing.T) {
+	address := netip.MustParseAddr("2001:db8::10")
+	metadata := adapter.InboundContext{
+		Destination: M.Socksaddr{
+			Fqdn: xdialEncodedDestination(
+				0x04,
+				address.AsSlice(),
+				"video.example",
+			),
+			Port: 443,
+		},
+	}
+
+	encoded, err := applyXDialFlowMetadata(&metadata, true)
+	require.NoError(t, err)
+	require.True(t, encoded)
+	require.Equal(t, "video.example", metadata.Domain)
+	require.Equal(t, "video.example", metadata.Destination.Fqdn)
+	require.False(t, metadata.Destination.Addr.IsValid())
+	require.Equal(t, uint16(443), metadata.Destination.Port)
+}
