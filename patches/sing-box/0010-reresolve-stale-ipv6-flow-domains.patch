diff --git a/protocol/socks/xdial_flow_metadata.go b/protocol/socks/xdial_flow_metadata.go
--- a/protocol/socks/xdial_flow_metadata.go
+++ b/protocol/socks/xdial_flow_metadata.go
@@ -13,10 +13,16 @@ import (
 
 var xdialFlowMetadataMagic = []byte{0x00, 0x58, 0x44, 0x01}
 
-// applyXDialFlowMetadata decodes the authenticated loopback relay's bounded
-// SOCKS destination envelope. The original domain remains rule metadata while
-// the already-resolved NE endpoint becomes the transport destination.
-func applyXDialFlowMetadata(metadata *adapter.InboundContext) (bool, error) {
+// applyXDialFlowMetadata decodes the authenticated loopback relay's bounded SOCKS
+// destination envelope. Normally the original domain remains rule metadata while
+// the already-resolved NE endpoint stays the transport destination. When the
+// transaction proved Direct IPv6 unusable, an IPv6 endpoint carrying a trusted
+// hostname becomes a domain destination again so the current Scenario-owned
+// resolver can replace an application's stale AAAA result.
+func applyXDialFlowMetadata(
+	metadata *adapter.InboundContext,
+	reresolveIPv6Domains bool,
+) (bool, error) {
 	if !metadata.Destination.IsDomain() {
 		return false, nil
 	}
@@ -62,6 +68,13 @@ func applyXDialFlowMetadata(metadata *adapter.InboundContext) (bool, error) {
 
 	port := metadata.Destination.Port
 	metadata.Domain = hostname
-	metadata.Destination = M.SocksaddrFrom(address, port)
+	if reresolveIPv6Domains && address.Is6() {
+		metadata.Destination = M.Socksaddr{
+			Fqdn: hostname,
+			Port: port,
+		}
+	} else {
+		metadata.Destination = M.SocksaddrFrom(address, port)
+	}
 	return true, nil
 }
