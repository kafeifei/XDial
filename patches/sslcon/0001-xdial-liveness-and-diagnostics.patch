diff --git a/vpn/xdial_liveness_test.go b/vpn/xdial_liveness_test.go
new file mode 100644
index 0000000..19e6f23
--- /dev/null
+++ b/vpn/xdial_liveness_test.go
@@ -0,0 +1,92 @@
+package vpn
+
+import (
+	"bytes"
+	"encoding/binary"
+	"encoding/json"
+	"net/http"
+	"testing"
+
+	"sslcon/base"
+	"sslcon/proto"
+	"sslcon/session"
+)
+
+type xdialSessionSnapshot struct {
+	TLS struct {
+		DPDResponsesReceived uint64 `json:"dpd_responses_received"`
+	} `json:"tls"`
+	Close *struct {
+		Code string `json:"code"`
+	} `json:"close"`
+}
+
+func newVPNXDialSession() *session.ConnSession {
+	base.Cfg.SetXDialForceDPD(5)
+	return (&session.Session{}).NewConnSession(&http.Header{})
+}
+
+func cstpFrame(payloadType byte, payload []byte) []byte {
+	frame := append([]byte(nil), proto.Header...)
+	binary.BigEndian.PutUint16(frame[4:6], uint16(len(payload)))
+	frame[6] = payloadType
+	return append(frame, payload...)
+}
+
+func xdialSnapshot(t *testing.T, cSess *session.ConnSession) xdialSessionSnapshot {
+	t.Helper()
+	var snapshot xdialSessionSnapshot
+	if err := json.Unmarshal(
+		[]byte(cSess.XDialDiagnosticsJSON()),
+		&snapshot,
+	); err != nil {
+		t.Fatal(err)
+	}
+	return snapshot
+}
+
+func TestReadTLSPayloadRecordsPeerDisconnectAndTerminate(t *testing.T) {
+	for _, test := range []struct {
+		name        string
+		payloadType byte
+		wantCode    string
+	}{
+		{name: "disconnect", payloadType: 0x05, wantCode: "peer-disconnect"},
+		{name: "terminate", payloadType: 0x09, wantCode: "peer-terminate"},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			cSess := newVPNXDialSession()
+			_, keepRunning, err := readTLSPayload(
+				bytes.NewReader(cstpFrame(test.payloadType, []byte("private reason"))),
+				cSess,
+			)
+			if err != nil || keepRunning {
+				t.Fatalf("read result keep=%v err=%v", keepRunning, err)
+			}
+			snapshot := xdialSnapshot(t, cSess)
+			if snapshot.Close == nil || snapshot.Close.Code != test.wantCode {
+				t.Fatalf("close = %#v, want %q", snapshot.Close, test.wantCode)
+			}
+			if bytes.Contains(
+				[]byte(cSess.XDialDiagnosticsJSON()),
+				[]byte("private reason"),
+			) {
+				t.Fatal("peer-provided text leaked into diagnostics")
+			}
+		})
+	}
+}
+
+func TestReadTLSPayloadRecordsDPDResponse(t *testing.T) {
+	cSess := newVPNXDialSession()
+	_, keepRunning, err := readTLSPayload(
+		bytes.NewReader(cstpFrame(0x04, nil)),
+		cSess,
+	)
+	if err != nil || !keepRunning {
+		t.Fatalf("read result keep=%v err=%v", keepRunning, err)
+	}
+	if got := xdialSnapshot(t, cSess).TLS.DPDResponsesReceived; got != 1 {
+		t.Fatalf("DPD responses = %d, want 1", got)
+	}
+}
