diff --git a/session/xdial_liveness.go b/session/xdial_liveness.go
new file mode 100644
index 0000000..6345f52
--- /dev/null
+++ b/session/xdial_liveness.go
@@ -0,0 +1,488 @@
+package session
+
+import (
+	"encoding/json"
+	"errors"
+	"io"
+	"net"
+	"strings"
+	"sync"
+	"syscall"
+	"time"
+
+	"sslcon/base"
+	"sslcon/proto"
+)
+
+const (
+	xdialTLS  = "tls"
+	xdialDTLS = "dtls"
+)
+
+type xdialTransportLiveness struct {
+	negotiatedDPD       int
+	negotiatedKeepalive int
+	effectiveDPD        time.Duration
+	active              bool
+	everConnected       bool
+	lastFrame           time.Time
+	lastWrite           time.Time
+	lastDPDWritten      time.Time
+	lastDPDResponse     time.Time
+	dpdQueued           bool
+	dpdRequestsQueued   uint64
+	dpdRequestsDropped  uint64
+	dpdRequestsWritten  uint64
+	dpdResponsesRead    uint64
+	peerDPDRequestsRead uint64
+	keepalivesRead      uint64
+	lastFailureCode     string
+}
+
+type xdialCloseReason struct {
+	Code         string `json:"code"`
+	Channel      string `json:"channel"`
+	Operation    string `json:"operation"`
+	ErrorClass   string `json:"error_class"`
+	OccurredAtMS int64  `json:"occurred_at_unix_milli"`
+}
+
+type xdialLiveness struct {
+	mu          sync.Mutex
+	forceDPD    time.Duration
+	tls         xdialTransportLiveness
+	dtls        xdialTransportLiveness
+	closeReason *xdialCloseReason
+	now         func() time.Time
+}
+
+type xdialNegotiatedSnapshot struct {
+	TLSDPDSeconds        int `json:"tls_dpd_seconds"`
+	TLSKeepaliveSeconds  int `json:"tls_keepalive_seconds"`
+	DTLSDPDSeconds       int `json:"dtls_dpd_seconds"`
+	DTLSKeepaliveSeconds int `json:"dtls_keepalive_seconds"`
+}
+
+type xdialTransportSnapshot struct {
+	EffectiveDPDSeconds     int    `json:"effective_dpd_seconds"`
+	DPDRequestsQueued       uint64 `json:"dpd_requests_queued"`
+	DPDRequestsDropped      uint64 `json:"dpd_requests_dropped"`
+	DPDRequestsWritten      uint64 `json:"dpd_requests_written"`
+	DPDResponsesReceived    uint64 `json:"dpd_responses_received"`
+	PeerDPDRequestsReceived uint64 `json:"peer_dpd_requests_received"`
+	KeepalivesReceived      uint64 `json:"keepalives_received"`
+	LastFrameAgeMS          *int64 `json:"last_frame_age_ms,omitempty"`
+	LastDPDWrittenAgeMS     *int64 `json:"last_dpd_written_age_ms,omitempty"`
+	LastDPDResponseAgeMS    *int64 `json:"last_dpd_response_age_ms,omitempty"`
+	LastFailureCode         string `json:"last_failure_code,omitempty"`
+	EverConnected           bool   `json:"ever_connected"`
+	CurrentlyConnected      bool   `json:"currently_connected"`
+}
+
+type xdialDiagnosticsSnapshot struct {
+	SchemaVersion   int                     `json:"schema_version"`
+	ForceDPDSeconds int                     `json:"force_dpd_seconds"`
+	Negotiated      xdialNegotiatedSnapshot `json:"negotiated"`
+	TLS             xdialTransportSnapshot  `json:"tls"`
+	DTLS            xdialTransportSnapshot  `json:"dtls"`
+	Close           *xdialCloseReason       `json:"close,omitempty"`
+}
+
+type xdialAction struct {
+	channel string
+	kind    byte
+}
+
+type xdialStepResult struct {
+	actions  []xdialAction
+	tlsDead  bool
+	dtlsDead bool
+}
+
+func newXDialLiveness(cSess *ConnSession) *xdialLiveness {
+	now := time.Now()
+	forceSeconds := base.Cfg.XDialForceDPD()
+	forceDPD := time.Duration(forceSeconds) * time.Second
+	tlsDPD := effectiveXDialDPD(forceDPD, cSess.TLSDpdTime)
+	dtlsDPD := effectiveXDialDPD(forceDPD, cSess.DTLSDpdTime)
+	return &xdialLiveness{
+		forceDPD: forceDPD,
+		tls: xdialTransportLiveness{
+			negotiatedDPD:       cSess.TLSDpdTime,
+			negotiatedKeepalive: cSess.TLSKeepaliveTime,
+			effectiveDPD:        tlsDPD,
+			active:              true,
+			everConnected:       true,
+			lastFrame:           now,
+		},
+		dtls: xdialTransportLiveness{
+			negotiatedDPD:       cSess.DTLSDpdTime,
+			negotiatedKeepalive: cSess.DTLSKeepaliveTime,
+			effectiveDPD:        dtlsDPD,
+		},
+		now: time.Now,
+	}
+}
+
+func effectiveXDialDPD(force time.Duration, negotiatedSeconds int) time.Duration {
+	if force > 0 {
+		return force
+	}
+	if negotiatedSeconds > 0 {
+		return time.Duration(negotiatedSeconds) * time.Second
+	}
+	return 0
+}
+
+func (cSess *ConnSession) XDialStartLiveness() {
+	if cSess.xdial == nil {
+		return
+	}
+	go cSess.xdialLivenessLoop()
+}
+
+func (cSess *ConnSession) xdialLivenessLoop() {
+	tick := time.Second
+	if force := cSess.xdial.forceDPD; force > 0 && force < tick {
+		tick = force
+	}
+	ticker := time.NewTicker(tick)
+	defer ticker.Stop()
+	for {
+		select {
+		case now := <-ticker.C:
+			result := cSess.xdial.step(now)
+			for _, action := range result.actions {
+				cSess.enqueueXDialControl(action)
+			}
+			if result.dtlsDead {
+				cSess.xdialRecordTransportFailure(
+					xdialDTLS,
+					"dtls-dpd-timeout",
+				)
+				if cSess.DSess != nil {
+					cSess.DSess.Close()
+				}
+			}
+			if result.tlsDead {
+				cSess.XDialCloseWithReason(
+					"tls-dpd-timeout",
+					xdialTLS,
+					"liveness",
+					"timeout",
+				)
+				return
+			}
+		case <-cSess.CloseChan:
+			return
+		}
+	}
+}
+
+func (l *xdialLiveness) step(now time.Time) xdialStepResult {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+
+	var result xdialStepResult
+	tlsAction, tlsDead := stepXDialTransport(now, &l.tls, xdialTLS)
+	if tlsAction != nil {
+		result.actions = append(result.actions, *tlsAction)
+	}
+	result.tlsDead = tlsDead
+
+	dtlsAction, dtlsDead := stepXDialTransport(now, &l.dtls, xdialDTLS)
+	if dtlsAction != nil {
+		result.actions = append(result.actions, *dtlsAction)
+	}
+	result.dtlsDead = dtlsDead
+	if dtlsDead {
+		l.dtls.active = false
+		l.dtls.lastFailureCode = "dtls-dpd-timeout"
+	}
+	return result
+}
+
+func stepXDialTransport(
+	now time.Time,
+	state *xdialTransportLiveness,
+	channel string,
+) (*xdialAction, bool) {
+	if !state.active || state.effectiveDPD <= 0 || state.lastFrame.IsZero() {
+		return nil, false
+	}
+	sinceFrame := now.Sub(state.lastFrame)
+	if sinceFrame >= 2*state.effectiveDPD {
+		return nil, true
+	}
+	if sinceFrame < state.effectiveDPD || state.dpdQueued {
+		return nil, false
+	}
+	retry := time.Duration(int64(state.effectiveDPD/time.Second)/2) * time.Second
+	if retry < time.Second {
+		retry = time.Second
+	}
+	if !state.lastDPDWritten.IsZero() &&
+		now.Sub(state.lastDPDWritten) < retry {
+		return nil, false
+	}
+	state.dpdQueued = true
+	return &xdialAction{channel: channel, kind: 0x03}, false
+}
+
+func (cSess *ConnSession) enqueueXDialControl(action xdialAction) {
+	var out chan<- *proto.Payload
+	capacity := 8
+	if action.channel == xdialDTLS {
+		out = cSess.PayloadOutDTLS
+		capacity = 1
+	} else {
+		out = cSess.PayloadOutTLS
+	}
+	payload := &proto.Payload{Type: action.kind, Data: make([]byte, 0, capacity)}
+	select {
+	case out <- payload:
+		cSess.xdialRecordQueued(action.channel)
+	default:
+		cSess.xdialRecordDropped(action.channel)
+	}
+}
+
+func (cSess *ConnSession) xdialRecordQueued(channel string) {
+	if cSess.xdial == nil {
+		return
+	}
+	cSess.xdial.mu.Lock()
+	state := cSess.xdial.transport(channel)
+	state.dpdRequestsQueued++
+	cSess.xdial.mu.Unlock()
+}
+
+func (cSess *ConnSession) xdialRecordDropped(channel string) {
+	if cSess.xdial == nil {
+		return
+	}
+	cSess.xdial.mu.Lock()
+	state := cSess.xdial.transport(channel)
+	state.dpdQueued = false
+	state.dpdRequestsDropped++
+	cSess.xdial.mu.Unlock()
+}
+
+func (cSess *ConnSession) XDialRecordWrite(
+	channel string,
+	payloadType byte,
+	err error,
+) {
+	if cSess.xdial == nil {
+		return
+	}
+	now := cSess.xdial.now()
+	if err != nil {
+		if channel == xdialDTLS {
+			cSess.xdialRecordTransportFailure(
+				channel,
+				channel+"-write-"+xdialErrorClass(err),
+			)
+			return
+		}
+		cSess.XDialCloseWithReason(
+			channel+"-write-"+xdialErrorClass(err),
+			channel,
+			"write",
+			xdialErrorClass(err),
+		)
+		return
+	}
+	cSess.xdial.mu.Lock()
+	state := cSess.xdial.transport(channel)
+	state.lastWrite = now
+	if payloadType == 0x03 {
+		state.dpdQueued = false
+		state.dpdRequestsWritten++
+		state.lastDPDWritten = now
+	}
+	cSess.xdial.mu.Unlock()
+}
+
+func (cSess *ConnSession) XDialRecordFrame(channel string, payloadType byte) {
+	if cSess.xdial == nil {
+		return
+	}
+	now := cSess.xdial.now()
+	cSess.xdial.mu.Lock()
+	state := cSess.xdial.transport(channel)
+	state.lastFrame = now
+	switch payloadType {
+	case 0x03:
+		state.peerDPDRequestsRead++
+	case 0x04:
+		state.dpdResponsesRead++
+		state.lastDPDResponse = now
+	case 0x07:
+		state.keepalivesRead++
+	}
+	cSess.xdial.mu.Unlock()
+}
+
+func (cSess *ConnSession) XDialRecordTransportReady(channel string) {
+	if cSess.xdial == nil {
+		return
+	}
+	now := cSess.xdial.now()
+	cSess.xdial.mu.Lock()
+	state := cSess.xdial.transport(channel)
+	state.active = true
+	state.everConnected = true
+	state.lastFrame = now
+	state.lastFailureCode = ""
+	cSess.xdial.mu.Unlock()
+}
+
+func (cSess *ConnSession) xdialRecordTransportFailure(channel, code string) {
+	if cSess.xdial == nil {
+		return
+	}
+	cSess.xdial.mu.Lock()
+	state := cSess.xdial.transport(channel)
+	state.active = false
+	state.lastFailureCode = code
+	cSess.xdial.mu.Unlock()
+}
+
+func (cSess *ConnSession) XDialRecordReadFailure(channel string, err error) {
+	class := xdialErrorClass(err)
+	if channel == xdialDTLS {
+		cSess.xdialRecordTransportFailure(
+			channel,
+			channel+"-read-"+class,
+		)
+		return
+	}
+	cSess.XDialCloseWithReason(
+		channel+"-read-"+class,
+		channel,
+		"read",
+		class,
+	)
+}
+
+func (cSess *ConnSession) XDialRecordPeerClose(channel, code string) {
+	if channel == xdialDTLS {
+		cSess.xdialRecordTransportFailure(channel, code)
+		return
+	}
+	cSess.XDialCloseWithReason(code, channel, "peer", "peer")
+}
+
+func (cSess *ConnSession) XDialCloseWithReason(
+	code, channel, operation, errorClass string,
+) {
+	if cSess.xdial != nil {
+		cSess.xdial.mu.Lock()
+		if cSess.xdial.closeReason == nil {
+			cSess.xdial.closeReason = &xdialCloseReason{
+				Code:         code,
+				Channel:      channel,
+				Operation:    operation,
+				ErrorClass:   errorClass,
+				OccurredAtMS: cSess.xdial.now().UnixMilli(),
+			}
+		}
+		cSess.xdial.mu.Unlock()
+	}
+	cSess.Close()
+}
+
+func (cSess *ConnSession) XDialDiagnosticsJSON() string {
+	if cSess == nil || cSess.xdial == nil {
+		return ""
+	}
+	now := cSess.xdial.now()
+	cSess.xdial.mu.Lock()
+	snapshot := xdialDiagnosticsSnapshot{
+		SchemaVersion:   1,
+		ForceDPDSeconds: int(cSess.xdial.forceDPD / time.Second),
+		Negotiated: xdialNegotiatedSnapshot{
+			TLSDPDSeconds:        cSess.xdial.tls.negotiatedDPD,
+			TLSKeepaliveSeconds:  cSess.xdial.tls.negotiatedKeepalive,
+			DTLSDPDSeconds:       cSess.xdial.dtls.negotiatedDPD,
+			DTLSKeepaliveSeconds: cSess.xdial.dtls.negotiatedKeepalive,
+		},
+		TLS:  snapshotXDialTransport(now, cSess.xdial.tls, false),
+		DTLS: snapshotXDialTransport(now, cSess.xdial.dtls, true),
+	}
+	if cSess.xdial.closeReason != nil {
+		reason := *cSess.xdial.closeReason
+		snapshot.Close = &reason
+	}
+	cSess.xdial.mu.Unlock()
+	data, err := json.Marshal(snapshot)
+	if err != nil {
+		return ""
+	}
+	return string(data)
+}
+
+func snapshotXDialTransport(
+	now time.Time,
+	state xdialTransportLiveness,
+	includeConnection bool,
+) xdialTransportSnapshot {
+	result := xdialTransportSnapshot{
+		EffectiveDPDSeconds:     int(state.effectiveDPD / time.Second),
+		DPDRequestsQueued:       state.dpdRequestsQueued,
+		DPDRequestsDropped:      state.dpdRequestsDropped,
+		DPDRequestsWritten:      state.dpdRequestsWritten,
+		DPDResponsesReceived:    state.dpdResponsesRead,
+		PeerDPDRequestsReceived: state.peerDPDRequestsRead,
+		KeepalivesReceived:      state.keepalivesRead,
+		LastFrameAgeMS:          xdialAge(now, state.lastFrame),
+		LastDPDWrittenAgeMS:     xdialAge(now, state.lastDPDWritten),
+		LastDPDResponseAgeMS:    xdialAge(now, state.lastDPDResponse),
+		LastFailureCode:         state.lastFailureCode,
+	}
+	if includeConnection {
+		result.EverConnected = state.everConnected
+		result.CurrentlyConnected = state.active
+	}
+	return result
+}
+
+func xdialAge(now, then time.Time) *int64 {
+	if then.IsZero() {
+		return nil
+	}
+	age := now.Sub(then).Milliseconds()
+	if age < 0 {
+		age = 0
+	}
+	return &age
+}
+
+func (l *xdialLiveness) transport(channel string) *xdialTransportLiveness {
+	if channel == xdialDTLS {
+		return &l.dtls
+	}
+	return &l.tls
+}
+
+func xdialErrorClass(err error) string {
+	if err == nil {
+		return "none"
+	}
+	var netError net.Error
+	if errors.As(err, &netError) && netError.Timeout() {
+		return "timeout"
+	}
+	if errors.Is(err, io.EOF) || errors.Is(err, io.ErrUnexpectedEOF) {
+		return "eof"
+	}
+	if errors.Is(err, syscall.ECONNRESET) || errors.Is(err, syscall.EPIPE) {
+		return "reset"
+	}
+	if errors.Is(err, net.ErrClosed) ||
+		strings.Contains(strings.ToLower(err.Error()), "closed network connection") {
+		return "closed"
+	}
+	return "other"
+}
diff --git a/session/xdial_liveness_test.go b/session/xdial_liveness_test.go
new file mode 100644
index 0000000..17e2114
--- /dev/null
+++ b/session/xdial_liveness_test.go
@@ -0,0 +1,222 @@
+package session
+
+import (
+	"encoding/json"
+	"errors"
+	"net/http"
+	"sync"
+	"syscall"
+	"testing"
+	"time"
+
+	"sslcon/base"
+)
+
+func newXDialTestSession(t *testing.T) *ConnSession {
+	t.Helper()
+	base.Cfg.SetXDialForceDPD(5)
+	header := http.Header{}
+	header.Set("X-CSTP-DPD", "120")
+	header.Set("X-CSTP-Keepalive", "30")
+	header.Set("X-DTLS-DPD", "60")
+	header.Set("X-DTLS-Keepalive", "20")
+	return (&Session{}).NewConnSession(&header)
+}
+
+func TestXDialForceDPDUsesIdleAndRetryWindows(t *testing.T) {
+	cSess := newXDialTestSession(t)
+	liveness := cSess.xdial
+	started := liveness.tls.lastFrame
+	liveness.now = func() time.Time { return started.Add(5 * time.Second) }
+
+	if result := liveness.step(started.Add(4 * time.Second)); len(result.actions) != 0 {
+		t.Fatalf("DPD sent before idle interval: %#v", result)
+	}
+	first := liveness.step(started.Add(5 * time.Second))
+	if len(first.actions) != 1 || first.actions[0].channel != xdialTLS {
+		t.Fatalf("first idle step = %#v, want one TLS DPD", first)
+	}
+	cSess.xdialRecordQueued(xdialTLS)
+	cSess.XDialRecordWrite(xdialTLS, 0x03, nil)
+
+	if result := liveness.step(started.Add(6 * time.Second)); len(result.actions) != 0 {
+		t.Fatalf("DPD retried too early: %#v", result)
+	}
+	retry := liveness.step(started.Add(7 * time.Second))
+	if len(retry.actions) != 1 || retry.actions[0].channel != xdialTLS {
+		t.Fatalf("retry step = %#v, want one TLS DPD", retry)
+	}
+
+	if result := liveness.step(started.Add(10 * time.Second)); !result.tlsDead {
+		t.Fatalf("peer not declared dead after two DPD intervals: %#v", result)
+	}
+}
+
+func TestXDialAnyInboundFrameResetsDeadPeerWindow(t *testing.T) {
+	cSess := newXDialTestSession(t)
+	liveness := cSess.xdial
+	started := liveness.tls.lastFrame
+	frameAt := started.Add(9 * time.Second)
+	liveness.now = func() time.Time { return frameAt }
+	cSess.XDialRecordFrame(xdialTLS, 0x07)
+
+	if result := liveness.step(started.Add(13 * time.Second)); result.tlsDead ||
+		len(result.actions) != 0 {
+		t.Fatalf("frame did not reset idle window: %#v", result)
+	}
+	result := liveness.step(started.Add(14 * time.Second))
+	if result.tlsDead || len(result.actions) != 1 {
+		t.Fatalf("DPD not scheduled from reset frame: %#v", result)
+	}
+}
+
+func TestXDialDPDCountsQueueWriteAndResponseSeparately(t *testing.T) {
+	cSess := newXDialTestSession(t)
+	liveness := cSess.xdial
+	now := liveness.tls.lastFrame.Add(5 * time.Second)
+	liveness.now = func() time.Time { return now }
+
+	cSess.xdialRecordQueued(xdialTLS)
+	cSess.XDialRecordWrite(xdialTLS, 0x03, nil)
+	now = now.Add(time.Second)
+	cSess.XDialRecordFrame(xdialTLS, 0x04)
+
+	var snapshot xdialDiagnosticsSnapshot
+	if err := json.Unmarshal(
+		[]byte(cSess.XDialDiagnosticsJSON()),
+		&snapshot,
+	); err != nil {
+		t.Fatal(err)
+	}
+	if snapshot.TLS.DPDRequestsQueued != 1 ||
+		snapshot.TLS.DPDRequestsWritten != 1 ||
+		snapshot.TLS.DPDResponsesReceived != 1 {
+		t.Fatalf("unexpected DPD counters: %#v", snapshot.TLS)
+	}
+}
+
+func TestXDialFullWriterQueueDropsWithoutBlocking(t *testing.T) {
+	cSess := newXDialTestSession(t)
+	for len(cSess.PayloadOutTLS) < cap(cSess.PayloadOutTLS) {
+		cSess.PayloadOutTLS <- nil
+	}
+	liveness := cSess.xdial
+	now := liveness.tls.lastFrame.Add(5 * time.Second)
+	result := liveness.step(now)
+	if len(result.actions) != 1 {
+		t.Fatalf("idle step = %#v, want one queued action", result)
+	}
+	cSess.enqueueXDialControl(result.actions[0])
+	if liveness.tls.dpdRequestsDropped != 1 ||
+		liveness.tls.dpdQueued {
+		t.Fatalf(
+			"full queue state: dropped=%d queued=%v",
+			liveness.tls.dpdRequestsDropped,
+			liveness.tls.dpdQueued,
+		)
+	}
+}
+
+func TestXDialDiagnosticsKeepFalseDTLSState(t *testing.T) {
+	cSess := newXDialTestSession(t)
+	var snapshot map[string]any
+	if err := json.Unmarshal(
+		[]byte(cSess.XDialDiagnosticsJSON()),
+		&snapshot,
+	); err != nil {
+		t.Fatal(err)
+	}
+	dtls := snapshot["dtls"].(map[string]any)
+	if _, ok := dtls["ever_connected"]; !ok {
+		t.Fatal("DTLS ever_connected was omitted when false")
+	}
+	if _, ok := dtls["currently_connected"]; !ok {
+		t.Fatal("DTLS currently_connected was omitted when false")
+	}
+}
+
+func TestXDialDTLSFailureDoesNotCloseMainSession(t *testing.T) {
+	cSess := newXDialTestSession(t)
+	cSess.XDialRecordTransportReady(xdialDTLS)
+	cSess.XDialRecordReadFailure(
+		xdialDTLS,
+		&timeoutError{},
+	)
+	select {
+	case <-cSess.CloseChan:
+		t.Fatal("DTLS failure closed the TLS session")
+	default:
+	}
+	if cSess.xdial.dtls.lastFailureCode != "dtls-read-timeout" {
+		t.Fatalf(
+			"DTLS failure = %q, want dtls-read-timeout",
+			cSess.xdial.dtls.lastFailureCode,
+		)
+	}
+}
+
+func TestXDialCloseReasonFirstWriterWins(t *testing.T) {
+	cSess := newXDialTestSession(t)
+	var ready sync.WaitGroup
+	ready.Add(2)
+	start := make(chan struct{})
+	for _, reason := range []string{"tls-read-eof", "tls-write-reset"} {
+		reason := reason
+		go func() {
+			ready.Done()
+			<-start
+			cSess.XDialCloseWithReason(reason, xdialTLS, "test", "test")
+		}()
+	}
+	ready.Wait()
+	close(start)
+	<-cSess.CloseChan
+
+	var snapshot xdialDiagnosticsSnapshot
+	if err := json.Unmarshal(
+		[]byte(cSess.XDialDiagnosticsJSON()),
+		&snapshot,
+	); err != nil {
+		t.Fatal(err)
+	}
+	if snapshot.Close == nil ||
+		(snapshot.Close.Code != "tls-read-eof" &&
+			snapshot.Close.Code != "tls-write-reset") {
+		t.Fatalf("invalid first close reason: %#v", snapshot.Close)
+	}
+}
+
+func TestXDialLateOldSessionCloseCannotClearNewSession(t *testing.T) {
+	base.Cfg.SetXDialForceDPD(5)
+	owner := &Session{}
+	first := owner.NewConnSession(&http.Header{})
+	second := owner.NewConnSession(&http.Header{})
+
+	first.Close()
+	if owner.CSess != second {
+		t.Fatal("old session close cleared the current session")
+	}
+	select {
+	case <-second.sessionCloseChan:
+		t.Fatal("old session close notified the current generation")
+	default:
+	}
+}
+
+func TestXDialErrorClassification(t *testing.T) {
+	if got := xdialErrorClass(&timeoutError{}); got != "timeout" {
+		t.Fatalf("timeout class = %q", got)
+	}
+	if got := xdialErrorClass(syscall.ECONNRESET); got != "reset" {
+		t.Fatalf("reset class = %q", got)
+	}
+	if got := xdialErrorClass(errors.New("opaque")); got != "other" {
+		t.Fatalf("other class = %q", got)
+	}
+}
+
+type timeoutError struct{}
+
+func (*timeoutError) Error() string   { return "timeout" }
+func (*timeoutError) Timeout() bool   { return true }
+func (*timeoutError) Temporary() bool { return true }
