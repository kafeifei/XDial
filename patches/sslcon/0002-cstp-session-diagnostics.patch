+func TestReadTLSPayloadRecordsDataActivity(t *testing.T) {
+	cSess := newVPNXDialSession()
+	payload := []byte{0x45, 0x00, 0x00, 0x14}
+	result := make(chan *proto.Payload, 1)
+	go func() {
+		result <- <-cSess.PayloadIn
+	}()
+	_, keepRunning, err := readTLSPayload(
+		bytes.NewReader(cstpFrame(0x00, payload)),
+		cSess,
+	)
+	if err != nil || !keepRunning {
+		t.Fatalf("read result keep=%v err=%v", keepRunning, err)
+	}
+	got := <-result
+	defer putPayloadBuffer(got)
+	if !bytes.Equal(got.Data, payload) {
+		t.Fatalf("DATA payload = %x, want %x", got.Data, payload)
+	}
+	if count := xdialSnapshot(t, cSess).TLS.DataFramesReceived; count != 1 {
+		t.Fatalf("DATA frames = %d, want 1", count)
+	}
+}
