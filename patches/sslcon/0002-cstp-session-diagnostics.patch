+func xdialPeerReason(payload []byte) (*int, string, bool, string) {
+	length := len(payload)
+	if length == 0 {
+		return &length, "", false, ""
+	}
+	code := fmt.Sprintf("%02x", payload[0])
+	reason := xdialPrintableReason(payload[1:])
+	if reason == "" {
+		return &length, code, false, ""
+	}
+	return &length, code, true, xdialPeerReasonCategory(reason)
+}
+
+func xdialPrintableReason(raw []byte) string {
+	const maximumReasonBytes = 256
+	if len(raw) > maximumReasonBytes {
+		raw = raw[:maximumReasonBytes]
+	}
+	var result strings.Builder
+	spacePending := false
+	for _, current := range raw {
+		switch {
+		case current == 0:
+			raw = nil
+		case current == ' ' || current == '\t' ||
+			current == '\r' || current == '\n':
+			spacePending = result.Len() > 0
+		case current >= 0x20 && current <= 0x7e:
+			if spacePending {
+				result.WriteByte(' ')
+				spacePending = false
+			}
+			result.WriteByte(current)
+		}
+		if raw == nil {
+			break
+		}
+	}
+	return strings.ToLower(strings.TrimSpace(result.String()))
+}
+
+func xdialPeerReasonCategory(reason string) string {
+	switch {
+	case strings.Contains(reason, "idle") &&
+		strings.Contains(reason, "timeout"):
+		return "idle-timeout"
+	case strings.Contains(reason, "session") &&
+		strings.Contains(reason, "timeout"):
+		return "session-timeout"
+	case strings.Contains(reason, "duplicate") ||
+		strings.Contains(reason, "another session"):
+		return "duplicate-session"
+	case strings.Contains(reason, "auth") ||
+		strings.Contains(reason, "login") ||
+		strings.Contains(reason, "credential"):
+		return "authentication"
+	case strings.Contains(reason, "policy") ||
+		strings.Contains(reason, "denied") ||
+		strings.Contains(reason, "not allowed"):
+		return "policy"
+	case strings.Contains(reason, "rekey"):
+		return "rekey"
+	case strings.Contains(reason, "server") ||
+		strings.Contains(reason, "internal") ||
+		strings.Contains(reason, "error") ||
+		strings.Contains(reason, "failure") ||
+		strings.Contains(reason, "unavailable"):
+		return "server-error"
+	default:
+		return "other"
+	}
+}
