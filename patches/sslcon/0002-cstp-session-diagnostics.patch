+func TestReadTLSPayloadBoundsAndSanitizesDisconnectReason(t *testing.T) {
+	tests := []struct {
+		name       string
+		payload    []byte
+		wantCode   string
+		wantText   bool
+		wantReason string
+	}{
+		{name: "empty"},
+		{name: "code-only", payload: []byte{0x08}, wantCode: "08"},
+		{
+			name:       "code-and-one-character",
+			payload:    []byte{0x0a, 'x'},
+			wantCode:   "0a",
+			wantText:   true,
+			wantReason: "other",
+		},
+		{
+			name:       "nul-terminated",
+			payload:    []byte{0x01, 'i', 'd', 'l', 'e', ' ', 't', 'i', 'm', 'e', 'o', 'u', 't', 0, 's', 'e', 'c', 'r', 'e', 't'},
+			wantCode:   "01",
+			wantText:   true,
+			wantReason: "idle-timeout",
+		},
+		{
+			name:       "non-utf8",
+			payload:    []byte{0xff, 0xff, 'r', 'e', 'k', 'e', 'y', '\r', '\n'},
+			wantCode:   "ff",
+			wantText:   true,
+			wantReason: "rekey",
+		},
+		{
+			name:       "oversize",
+			payload:    append([]byte{0x02}, bytes.Repeat([]byte{'x'}, 1024)...),
+			wantCode:   "02",
+			wantText:   true,
+			wantReason: "other",
+		},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			cSess := newVPNXDialSession()
+			_, keepRunning, err := readTLSPayload(
+				bytes.NewReader(cstpFrame(0x05, test.payload)),
+				cSess,
+			)
+			if err != nil || keepRunning {
+				t.Fatalf("read result keep=%v err=%v", keepRunning, err)
+			}
+			snapshot := xdialSnapshot(t, cSess)
+			if snapshot.Close == nil ||
+				snapshot.Close.PeerPayloadLength == nil ||
+				*snapshot.Close.PeerPayloadLength != len(test.payload) ||
+				snapshot.Close.PeerReasonCode != test.wantCode ||
+				snapshot.Close.PeerHasReasonText != test.wantText ||
+				snapshot.Close.PeerReasonCategory != test.wantReason {
+				t.Fatalf("close = %#v", snapshot.Close)
+			}
+		})
+	}
+}
