+func TestXDialDurationHeadersRejectInvalidValues(t *testing.T) {
+	tests := []struct {
+		value string
+		want  *int
+	}{
+		{value: "", want: nil},
+		{value: "none", want: intPointer(0)},
+		{value: " 42 ", want: intPointer(42)},
+		{value: "-1", want: nil},
+		{value: "2147483648", want: nil},
+		{value: "not-a-duration", want: nil},
+	}
+	for _, test := range tests {
+		t.Run(test.value, func(t *testing.T) {
+			header := http.Header{}
+			header.Set("X-Test-Duration", test.value)
+			got := xdialDurationHeader(header, "X-Test-Duration")
+			if (got == nil) != (test.want == nil) ||
+				got != nil && *got != *test.want {
+				t.Fatalf("duration %q = %#v, want %#v", test.value, got, test.want)
+			}
+		})
+	}
+	if got := xdialRekeyMethod("future-method"); got != "unknown" {
+		t.Fatalf("unknown rekey method = %q", got)
+	}
+	if got := xdialRekeyMethod(""); got != "" {
+		t.Fatalf("missing rekey method = %q", got)
+	}
+}
