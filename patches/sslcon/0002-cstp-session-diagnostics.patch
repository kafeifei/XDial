+func TestXDialNegotiatedCSTPHeadersAreBoundedAndNormalized(t *testing.T) {
+	header := http.Header{}
+	header.Set("X-CSTP-DPD", "60")
+	header.Set("X-CSTP-Rekey-Time", "180")
+	header.Set("X-CSTP-Rekey-Method", " NEW-TUNNEL ")
+	header.Set("X-CSTP-Lease-Duration", "none")
+	header.Set("X-CSTP-Session-Timeout", "3600")
+	header.Set("X-CSTP-Session-Timeout-Remaining", "3500")
+	header.Set("X-CSTP-Idle-Timeout", "900")
+	cSess := (&Session{}).NewConnSession(&header)
+
+	var snapshot xdialDiagnosticsSnapshot
+	if err := json.Unmarshal(
+		[]byte(cSess.XDialDiagnosticsJSON()),
+		&snapshot,
+	); err != nil {
+		t.Fatal(err)
+	}
+	if snapshot.SchemaVersion != 2 {
+		t.Fatalf("schema version = %d, want 2", snapshot.SchemaVersion)
+	}
+	if snapshot.Negotiated.CSTPRekeySeconds == nil ||
+		*snapshot.Negotiated.CSTPRekeySeconds != 180 {
+		t.Fatalf(
+			"rekey seconds = %#v, want 180",
+			snapshot.Negotiated.CSTPRekeySeconds,
+		)
+	}
+	if snapshot.Negotiated.CSTPRekeyMethod != "new-tunnel" {
+		t.Fatalf(
+			"rekey method = %q, want new-tunnel",
+			snapshot.Negotiated.CSTPRekeyMethod,
+		)
+	}
+	if snapshot.Negotiated.CSTPLeaseDurationSeconds == nil ||
+		*snapshot.Negotiated.CSTPLeaseDurationSeconds != 0 {
+		t.Fatalf(
+			"lease duration = %#v, want disabled",
+			snapshot.Negotiated.CSTPLeaseDurationSeconds,
+		)
+	}
+	if snapshot.Negotiated.CSTPSessionTimeoutSeconds == nil ||
+		*snapshot.Negotiated.CSTPSessionTimeoutSeconds != 3600 ||
+		snapshot.Negotiated.CSTPSessionTimeoutRemainingSeconds == nil ||
+		*snapshot.Negotiated.CSTPSessionTimeoutRemainingSeconds != 3500 ||
+		snapshot.Negotiated.CSTPIdleTimeoutSeconds == nil ||
+		*snapshot.Negotiated.CSTPIdleTimeoutSeconds != 900 {
+		t.Fatalf("unexpected CSTP timeout snapshot: %#v", snapshot.Negotiated)
+	}
