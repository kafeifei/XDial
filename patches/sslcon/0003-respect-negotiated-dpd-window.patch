+func TestXDialAirplaneNegotiatedSixtySecondWindow(t *testing.T) {
+	base.Cfg.SetXDialForceDPD(5)
+	header := http.Header{}
+	header.Set("X-CSTP-DPD", "60")
+	cSess := (&Session{}).NewConnSession(&header)
+	started := cSess.xdial.tls.lastFrame
+	for _, elapsed := range []time.Duration{10 * time.Second, 10400 * time.Millisecond, 59 * time.Second} {
+		if cSess.xdial.step(started.Add(elapsed)).tlsDead {
+			t.Fatalf("false disconnect after %s with a negotiated 60s window", elapsed)
+		}
+	}
+	if !cSess.xdial.step(started.Add(60 * time.Second)).tlsDead {
+		t.Fatal("dead session exceeded its negotiated timeout")
+	}
+}
+
+func TestXDialTwoSecondDPDResponseRestartsNegotiatedWindow(t *testing.T) {
+	base.Cfg.SetXDialForceDPD(5)
+	header := http.Header{}
+	header.Set("X-CSTP-DPD", "60")
+	cSess := (&Session{}).NewConnSession(&header)
+	started := cSess.xdial.tls.lastFrame
+	if result := cSess.xdial.step(started.Add(5 * time.Second)); result.tlsDead || len(result.actions) != 1 {
+		t.Fatalf("fast probe was lost: %#v", result)
+	}
+	cSess.xdial.now = func() time.Time { return started.Add(7 * time.Second) }
+	cSess.XDialRecordFrame(xdialTLS, 0x04)
+	if cSess.xdial.step(started.Add(66 * time.Second)).tlsDead {
+		t.Fatal("two-second DPD reply did not refresh the negotiated window")
+	}
+	if !cSess.xdial.step(started.Add(67 * time.Second)).tlsDead {
+		t.Fatal("refreshed window failed to expire")
+	}
+}
