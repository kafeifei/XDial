diff --git a/ipn/ipnlocal/xdial_diagnostics.go b/ipn/ipnlocal/xdial_diagnostics.go
new file mode 100644
--- /dev/null
+++ b/ipn/ipnlocal/xdial_diagnostics.go
@@ -0,0 +1,76 @@
+// Copyright (c) Tailscale Inc & contributors
+// SPDX-License-Identifier: BSD-3-Clause
+
+package ipnlocal
+
+// XDialControlNetInfoDiagnostics is a bounded snapshot of the current control
+// client's NetInfo lifecycle. It contains no NetInfo body or DERP identifier.
+type XDialControlNetInfoDiagnostics struct {
+	ClientPresent         bool
+	ResetForCurrentClient bool
+	SetForCurrentClient   bool
+	PreferredDERPRelation string
+}
+
+type xdialControlNetInfoTracker struct {
+	generation       uint64
+	resetGeneration  uint64
+	setGeneration    uint64
+	setPreferredDERP int
+}
+
+func (t *xdialControlNetInfoTracker) nextControlClient() uint64 {
+	t.generation++
+	return t.generation
+}
+
+func (t *xdialControlNetInfoTracker) didReset(generation uint64) {
+	if generation == t.generation {
+		t.resetGeneration = generation
+	}
+}
+
+func (t *xdialControlNetInfoTracker) didSet(generation uint64, preferredDERP int) {
+	if generation != t.generation {
+		return
+	}
+	t.setGeneration = generation
+	t.setPreferredDERP = preferredDERP
+}
+
+func (t *xdialControlNetInfoTracker) snapshot(
+	clientPresent bool,
+	preferredDERPRelation string,
+) XDialControlNetInfoDiagnostics {
+	current := t.generation
+	reset := clientPresent && current != 0 && t.resetGeneration == current
+	set := clientPresent && current != 0 && t.setGeneration == current
+	if !set {
+		preferredDERPRelation = "unknown"
+	}
+	return XDialControlNetInfoDiagnostics{
+		ClientPresent:         clientPresent,
+		ResetForCurrentClient: reset,
+		SetForCurrentClient:   set,
+		PreferredDERPRelation: preferredDERPRelation,
+	}
+}
+
+// XDialControlNetInfoState reports whether the current control client was
+// installed with a matching ResetNetInfoLast and subsequently received a
+// synchronous SetNetInfo call. It intentionally exposes only a relation
+// between PreferredDERP and magicsock's runtime home.
+func (b *LocalBackend) XDialControlNetInfoState() XDialControlNetInfoDiagnostics {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+
+	clientPresent := b.cc != nil
+	relation := "unknown"
+	if clientPresent &&
+		b.xdialControlNetInfo.setGeneration == b.xdialControlNetInfo.generation {
+		relation = b.MagicConn().XDialPreferredDERPRelation(
+			b.xdialControlNetInfo.setPreferredDERP,
+		)
+	}
+	return b.xdialControlNetInfo.snapshot(clientPresent, relation)
+}
diff --git a/ipn/ipnlocal/xdial_diagnostics_test.go b/ipn/ipnlocal/xdial_diagnostics_test.go
new file mode 100644
--- /dev/null
+++ b/ipn/ipnlocal/xdial_diagnostics_test.go
@@ -0,0 +1,40 @@
+// Copyright (c) Tailscale Inc & contributors
+// SPDX-License-Identifier: BSD-3-Clause
+
+package ipnlocal
+
+import "testing"
+
+func TestXDialControlNetInfoTrackerGeneration(t *testing.T) {
+	var tracker xdialControlNetInfoTracker
+	first := tracker.nextControlClient()
+	tracker.didReset(first)
+	tracker.didSet(first, 7)
+
+	got := tracker.snapshot(true, "match")
+	if !got.ClientPresent || !got.ResetForCurrentClient ||
+		!got.SetForCurrentClient || got.PreferredDERPRelation != "match" {
+		t.Fatalf("first control generation = %+v", got)
+	}
+
+	second := tracker.nextControlClient()
+	tracker.didReset(second)
+	tracker.didSet(first, 8)
+	got = tracker.snapshot(true, "mismatch")
+	if !got.ClientPresent || !got.ResetForCurrentClient ||
+		got.SetForCurrentClient || got.PreferredDERPRelation != "unknown" {
+		t.Fatalf("stale SetNetInfo was attributed to replacement: %+v", got)
+	}
+
+	tracker.didSet(second, 9)
+	got = tracker.snapshot(true, "mismatch")
+	if !got.SetForCurrentClient || got.PreferredDERPRelation != "mismatch" {
+		t.Fatalf("current SetNetInfo missing: %+v", got)
+	}
+
+	got = tracker.snapshot(false, "match")
+	if got.ClientPresent || got.ResetForCurrentClient ||
+		got.SetForCurrentClient || got.PreferredDERPRelation != "unknown" {
+		t.Fatalf("absent control client = %+v", got)
+	}
+}
