+// setDERPProtocolReady records whether the current activeDerp generation has
+// received its DERP ServerInfo frame. The client identity check prevents a
+// reader from an older activeDerp generation from mutating its replacement.
+func (c *Conn) setDERPProtocolReady(regionID int, dc *derphttp.Client, ready bool) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	active, ok := c.activeDerp[regionID]
+	if !ok || active.c != dc {
+		return
+	}
+	active.protocolReady = ready
+	c.activeDerp[regionID] = active
+}
+
+// XDialDERPConnectionDiagnostics is a bounded snapshot of DERP lifecycle
+// state. It contains no region IDs, endpoints or public keys.
+type XDialDERPConnectionDiagnostics struct {
+	ClientCount        int
+	ProtocolReadyCount int
+	HomeConfigured     bool
+	HomeState          string
+	HomeKeyRelation    string
+}
+
+func xdialDERPHomeState(
+	transportConnected bool,
+	closed bool,
+	protocolReady bool,
+) string {
+	switch {
+	case closed:
+		return "closed"
+	case protocolReady:
+		return "protocol_ready"
+	case transportConnected:
+		return "transport_connected"
+	default:
+		return "connecting"
+	}
+}
+
+// XDialPreferredDERPRelation compares a reported PreferredDERP with the
+// current magicsock home without exposing either identifier.
+func (c *Conn) XDialPreferredDERPRelation(preferredDERP int) string {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if preferredDERP == 0 || c.myDerp == 0 {
+		return "unknown"
+	}
+	if preferredDERP == c.myDerp {
+		return "match"
+	}
+	return "mismatch"
+}
+
+// XDialDERPConnectionState distinguishes activeDerp client objects from
+// sessions whose current reader has received the DERP ServerInfo frame. The
+// client identity check in setDERPProtocolReady prevents a stale reader from
+// making a replacement look ready.
+func (c *Conn) XDialDERPConnectionState() XDialDERPConnectionDiagnostics {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	result := XDialDERPConnectionDiagnostics{
+		ClientCount:     len(c.activeDerp),
+		HomeConfigured:  c.myDerp != 0,
+		HomeState:       "unconfigured",
+		HomeKeyRelation: "unknown",
+	}
+	if c.myDerp != 0 {
+		result.HomeState = "not_created"
+	}
+	for regionID, active := range c.activeDerp {
+		if active.c == nil {
+			continue
+		}
+		transportConnected, closed := active.c.XDialConnectionState()
+		if active.protocolReady {
+			result.ProtocolReadyCount++
+		}
+		if regionID != c.myDerp {
+			continue
+		}
+		result.HomeState = xdialDERPHomeState(transportConnected, closed, active.protocolReady)
+		if !c.privateKey.IsZero() {
+			if active.c.SelfPublicKey().Compare(c.privateKey.Public()) == 0 {
+				result.HomeKeyRelation = "match"
+			} else {
+				result.HomeKeyRelation = "mismatch"
+			}
+		}
+	}
+	return result
+}
+
 // DERPs reports the number of active DERP connections.
 func (c *Conn) DERPs() int {
 	c.mu.Lock()
diff --git a/wgengine/magicsock/xdial_diagnostics_test.go b/wgengine/magicsock/xdial_diagnostics_test.go
new file mode 100644
--- /dev/null
+++ b/wgengine/magicsock/xdial_diagnostics_test.go
@@ -0,0 +1,141 @@
+// Copyright (c) Tailscale Inc & contributors
+// SPDX-License-Identifier: BSD-3-Clause
+
+package magicsock
+
+import (
+	"testing"
+	"time"
+
+	"github.com/sagernet/tailscale/derp/derphttp"
+	"github.com/sagernet/tailscale/net/netmon"
+	"github.com/sagernet/tailscale/tailcfg"
+	"github.com/sagernet/tailscale/types/key"
+)
+
+func newXDialTestDERPClient(t *testing.T, privateKey key.NodePrivate) *derphttp.Client {
+	t.Helper()
+	netMon := netmon.NewStatic()
+	t.Cleanup(func() { _ = netMon.Close() })
+	return derphttp.NewRegionClient(
+		privateKey,
+		t.Logf,
+		netMon,
+		func() *tailcfg.DERPRegion { return nil },
+	)
+}
+
+func TestXDialDERPProtocolReadyTracksReconnect(t *testing.T) {
+	c := newConn(t.Logf)
+	privateKey := key.NewNode()
+	client := newXDialTestDERPClient(t, privateKey)
+	c.mu.Lock()
+	c.myDerp = 7
+	c.privateKey = privateKey
+	c.activeDerp = map[int]activeDerp{
+		7: {c: client, createTime: time.Now()},
+	}
+	c.mu.Unlock()
+
+	c.setDERPProtocolReady(7, client, true)
+	if got := c.XDialDERPConnectionState(); got.ProtocolReadyCount != 1 ||
+		got.HomeState != "protocol_ready" {
+		t.Fatalf("ServerInfo did not mark protocol ready: %+v", got)
+	}
+
+	c.setDERPProtocolReady(7, client, false)
+	if got := c.XDialDERPConnectionState(); got.ProtocolReadyCount != 0 ||
+		got.HomeState == "protocol_ready" {
+		t.Fatalf("receive error did not clear protocol readiness: %+v", got)
+	}
+
+	c.setDERPProtocolReady(7, client, true)
+	if got := c.XDialDERPConnectionState(); got.ProtocolReadyCount != 1 ||
+		got.HomeState != "protocol_ready" {
+		t.Fatalf("reconnected ServerInfo did not restore readiness: %+v", got)
+	}
+}
+
+func TestXDialDERPProtocolReadyRejectsStaleClient(t *testing.T) {
+	c := newConn(t.Logf)
+	privateKey := key.NewNode()
+	stale := newXDialTestDERPClient(t, privateKey)
+	current := newXDialTestDERPClient(t, privateKey)
+	c.mu.Lock()
+	c.myDerp = 7
+	c.privateKey = privateKey
+	c.activeDerp = map[int]activeDerp{
+		7: {c: current, createTime: time.Now()},
+	}
+	c.mu.Unlock()
+
+	c.setDERPProtocolReady(7, stale, true)
+	if got := c.XDialDERPConnectionState(); got.ProtocolReadyCount != 0 {
+		t.Fatalf("stale reader marked replacement ready: %+v", got)
+	}
+
+	c.setDERPProtocolReady(7, current, true)
+	c.setDERPProtocolReady(7, stale, false)
+	if got := c.XDialDERPConnectionState(); got.ProtocolReadyCount != 1 ||
+		got.HomeState != "protocol_ready" {
+		t.Fatalf("stale reader cleared replacement readiness: %+v", got)
+	}
+}
+
+func TestXDialDERPHomeState(t *testing.T) {
+	tests := []struct {
+		transportConnected bool
+		closed             bool
+		ready              bool
+		want               string
+	}{
+		{false, false, false, "connecting"},
+		{true, false, false, "transport_connected"},
+		{true, false, true, "protocol_ready"},
+		{true, true, true, "closed"},
+	}
+	for _, test := range tests {
+		if got := xdialDERPHomeState(test.transportConnected, test.closed, test.ready); got != test.want {
+			t.Fatalf("state %+v: got %q, want %q", test, got, test.want)
+		}
+	}
+}
+
+func TestXDialDERPConnectionDiagnosticsKeyRelation(t *testing.T) {
+	c := newConn(t.Logf)
+	c.mu.Lock()
+	c.myDerp = 7
+	c.mu.Unlock()
+
+	got := c.XDialDERPConnectionState()
+	if !got.HomeConfigured || got.HomeState != "not_created" ||
+		got.HomeKeyRelation != "unknown" {
+		t.Fatalf("home without client = %+v", got)
+	}
+
+	clientKey := key.NewNode()
+	client := newXDialTestDERPClient(t, clientKey)
+	c.mu.Lock()
+	c.privateKey = clientKey
+	c.activeDerp = map[int]activeDerp{
+		7: {c: client, createTime: time.Now()},
+	}
+	c.mu.Unlock()
+	if got := c.XDialDERPConnectionState(); got.HomeKeyRelation != "match" {
+		t.Fatalf("matching key relation = %+v", got)
+	}
+
+	c.mu.Lock()
+	c.privateKey = key.NewNode()
+	c.mu.Unlock()
+	if got := c.XDialDERPConnectionState(); got.HomeKeyRelation != "mismatch" {
+		t.Fatalf("mismatching key relation = %+v", got)
+	}
+
+	c.mu.Lock()
+	c.privateKey = key.NodePrivate{}
+	c.mu.Unlock()
+	if got := c.XDialDERPConnectionState(); got.HomeKeyRelation != "unknown" {
+		t.Fatalf("unknown key relation = %+v", got)
+	}
+}
