diff --git a/wgengine/magicsock/xdial_derp_reselection.go b/wgengine/magicsock/xdial_derp_reselection.go
new file mode 100644
index 0000000..b147e93
--- /dev/null
+++ b/wgengine/magicsock/xdial_derp_reselection.go
@@ -0,0 +1,324 @@
+// Copyright (c) Tailscale Inc & contributors
+// SPDX-License-Identifier: BSD-3-Clause
+
+package magicsock
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"time"
+
+	"github.com/sagernet/tailscale/derp/derphttp"
+	"github.com/sagernet/tailscale/net/netcheck"
+	"github.com/sagernet/tailscale/tailcfg"
+	"github.com/sagernet/tailscale/types/key"
+)
+
+const xdialNetcheckFreshness = 30 * time.Second
+
+// XDialDERPHomeReselectionPlan is an opaque, single-use plan. Its fields stay
+// private so region and identity details cannot cross the package boundary.
+type XDialDERPHomeReselectionPlan struct {
+	conn            *Conn
+	attemptID       uint64
+	originalDERP    int
+	alternateDERP   int
+	privateKey      key.NodePublic
+	alternateClient *derphttp.Client
+	committed       bool
+}
+
+// XDialDERPHomeReselectionCommit reports only local commit facts.
+type XDialDERPHomeReselectionCommit struct {
+	AlternatePrepared        bool
+	HomePromoted             bool
+	NetInfoCallbackScheduled bool
+}
+
+// c.mu must be held.
+func (c *Conn) clearXDialDERPReselectionLocked() {
+	c.xdialPinnedDERP = 0
+	c.xdialDERPReselectionActive = 0
+}
+
+// c.mu must be held.
+func (c *Conn) xdialNormalizePinnedDERPLocked() int {
+	pinnedDERP := c.xdialPinnedDERP
+	if pinnedDERP == 0 {
+		return 0
+	}
+	if c.closed ||
+		c.homeless ||
+		c.privateKey.IsZero() ||
+		c.myDerp != pinnedDERP ||
+		c.derpMap == nil ||
+		c.derpMap.Regions[pinnedDERP] == nil {
+		c.clearXDialDERPReselectionLocked()
+		return 0
+	}
+	return pinnedDERP
+}
+
+// XDialNormalizeNetInfoForControl clones ni and applies the HomeDERP that is
+// valid at the control-send boundary. A callback queued before a reselection
+// commit must not publish its stale PreferredDERP after that commit.
+func (c *Conn) XDialNormalizeNetInfoForControl(
+	ni *tailcfg.NetInfo,
+) *tailcfg.NetInfo {
+	if ni == nil {
+		return nil
+	}
+	normalized := ni.Clone()
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if pinnedDERP := c.xdialNormalizePinnedDERPLocked(); pinnedDERP != 0 {
+		normalized.PreferredDERP = pinnedDERP
+	}
+	return normalized
+}
+
+func xdialPickAlternateDERP(
+	current int,
+	report *netcheck.Report,
+	derpMap *tailcfg.DERPMap,
+) int {
+	if current == 0 || report == nil || derpMap == nil {
+		return 0
+	}
+	var selected int
+	var selectedLatency time.Duration
+	for regionID, latency := range report.RegionLatency {
+		if regionID == current || latency <= 0 {
+			continue
+		}
+		region := derpMap.Regions[regionID]
+		if region == nil ||
+			region.Avoid ||
+			region.NoMeasureNoHome ||
+			len(region.Nodes) == 0 {
+			continue
+		}
+		if selected == 0 ||
+			latency < selectedLatency ||
+			(latency == selectedLatency && regionID < selected) {
+			selected = regionID
+			selectedLatency = latency
+		}
+	}
+	return selected
+}
+
+// c.mu must be held.
+func (c *Conn) xdialDERPReselectionReadyLocked(
+	plan *XDialDERPHomeReselectionPlan,
+) (bool, error) {
+	switch {
+	case plan == nil || plan.conn != c:
+		return false, errors.New("DERP reselection plan is invalid")
+	case plan.committed:
+		return false, errors.New("DERP reselection plan was already committed")
+	case c.xdialDERPReselectionActive != plan.attemptID:
+		return false, errors.New("DERP reselection attempt is no longer active")
+	case c.closed:
+		return false, errors.New("magicsock is closed")
+	case c.privateKey.IsZero() ||
+		c.privateKey.Public() != plan.privateKey:
+		return false, errors.New("node key changed during DERP preparation")
+	case c.myDerp != plan.originalDERP:
+		return false, errors.New("home DERP changed during DERP preparation")
+	case c.derpMap == nil ||
+		c.derpMap.Regions[plan.alternateDERP] == nil:
+		return false, errors.New("alternate DERP is no longer in the map")
+	}
+	active, ok := c.activeDerp[plan.alternateDERP]
+	if !ok || active.c != plan.alternateClient {
+		return false, errors.New("alternate DERP connection generation changed")
+	}
+	return active.protocolReady, nil
+}
+
+// XDialPrepareHomeDERPReselection prepares one measured alternate DERP
+// without changing HomeDERP or publishing NetInfo.
+func (c *Conn) XDialPrepareHomeDERPReselection(
+	ctx context.Context,
+) (plan *XDialDERPHomeReselectionPlan, err error) {
+	if ctx == nil {
+		return nil, errors.New("reselection context is nil")
+	}
+	report := c.lastNetCheckReport.Load()
+	if report == nil || report.Now.IsZero() {
+		return nil, errors.New("fresh netcheck is unavailable")
+	}
+	age := time.Since(report.Now)
+	if age < 0 || age > xdialNetcheckFreshness {
+		return nil, fmt.Errorf("netcheck is stale")
+	}
+
+	c.mu.Lock()
+	if c.xdialDERPReselectionSeq != 0 {
+		c.mu.Unlock()
+		return nil, errors.New("home DERP reselection was already attempted")
+	}
+	c.xdialDERPReselectionSeq++
+	c.xdialDERPReselectionActive = c.xdialDERPReselectionSeq
+	plan = &XDialDERPHomeReselectionPlan{
+		conn:         c,
+		attemptID:    c.xdialDERPReselectionActive,
+		originalDERP: c.myDerp,
+		privateKey:   c.privateKey.Public(),
+	}
+	plan.alternateDERP = xdialPickAlternateDERP(
+		c.myDerp,
+		report,
+		c.derpMap,
+	)
+	switch {
+	case c.closed:
+		err = errors.New("magicsock is closed")
+	case c.privateKey.IsZero():
+		err = errors.New("node key is unavailable")
+	case c.netInfoLast == nil || c.netInfoFunc == nil:
+		err = errors.New("NetInfo publisher is unavailable")
+	case plan.alternateDERP == 0:
+		err = errors.New("no measured alternate DERP is available")
+	}
+	c.mu.Unlock()
+	if err != nil {
+		c.XDialCancelHomeDERPReselection(plan)
+		return nil, err
+	}
+
+	if c.derpWriteChanForRegion(
+		plan.alternateDERP,
+		key.NodePublic{},
+	) == nil {
+		c.XDialCancelHomeDERPReselection(plan)
+		return nil, errors.New("alternate DERP connection could not start")
+	}
+	c.mu.Lock()
+	active, ok := c.activeDerp[plan.alternateDERP]
+	if ok {
+		plan.alternateClient = active.c
+	}
+	c.mu.Unlock()
+	if plan.alternateClient == nil {
+		c.XDialCancelHomeDERPReselection(plan)
+		return nil, errors.New("alternate DERP client is unavailable")
+	}
+
+	ticker := time.NewTicker(25 * time.Millisecond)
+	defer ticker.Stop()
+	for {
+		c.mu.Lock()
+		ready, readyErr := c.xdialDERPReselectionReadyLocked(plan)
+		c.mu.Unlock()
+		if readyErr != nil {
+			c.XDialCancelHomeDERPReselection(plan)
+			return nil, readyErr
+		}
+		if ready {
+			return plan, nil
+		}
+		select {
+		case <-ctx.Done():
+			c.XDialCancelHomeDERPReselection(plan)
+			return nil, ctx.Err()
+		case <-ticker.C:
+		}
+	}
+}
+
+// XDialCommitHomeDERPReselection atomically promotes a prepared alternate,
+// pins it until an explicit lifecycle invalidation or Conn close, and
+// schedules matching NetInfo.
+func (c *Conn) XDialCommitHomeDERPReselection(
+	ctx context.Context,
+	plan *XDialDERPHomeReselectionPlan,
+) (result XDialDERPHomeReselectionCommit, err error) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	if ctx == nil {
+		return result, errors.New("reselection context is nil")
+	}
+	if err := ctx.Err(); err != nil {
+		return result, err
+	}
+	ready, err := c.xdialDERPReselectionReadyLocked(plan)
+	if err != nil {
+		return result, err
+	}
+	if !ready {
+		return result, errors.New("alternate DERP lost protocol readiness")
+	}
+	if c.netInfoLast == nil || c.netInfoFunc == nil {
+		return result, errors.New("NetInfo publisher is unavailable")
+	}
+
+	now := time.Now()
+	if original, ok := c.activeDerp[plan.originalDERP]; ok &&
+		original.lastWrite != nil {
+		*original.lastWrite = now
+		c.activeDerp[plan.originalDERP] = original
+	}
+	c.xdialPinnedDERP = plan.alternateDERP
+	if !c.setNearestDERPLocked(plan.alternateDERP) {
+		c.xdialPinnedDERP = 0
+		return result, errors.New("alternate DERP could not become home")
+	}
+	ni := c.netInfoLast.Clone()
+	ni.PreferredDERP = plan.alternateDERP
+	c.callNetInfoCallbackLocked(ni)
+	c.scheduleCleanStaleDerpLocked()
+
+	plan.committed = true
+	c.xdialDERPReselectionActive = 0
+	result.AlternatePrepared = true
+	result.HomePromoted = true
+	result.NetInfoCallbackScheduled = true
+	return result, nil
+}
+
+// XDialCancelHomeDERPReselection invalidates an uncommitted plan without
+// changing HomeDERP or NetInfo. The auxiliary DERP is left to normal cleanup.
+func (c *Conn) XDialCancelHomeDERPReselection(
+	plan *XDialDERPHomeReselectionPlan,
+) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if plan == nil ||
+		plan.conn != c ||
+		plan.committed ||
+		c.xdialDERPReselectionActive != plan.attemptID {
+		return
+	}
+	c.xdialDERPReselectionActive = 0
+}
+
+// XDialAlternateDERP returns the opaque plan's internal candidate for
+// same-module control-view observation. It must never cross the app boundary.
+func (p *XDialDERPHomeReselectionPlan) XDialAlternateDERP() int {
+	if p == nil {
+		return 0
+	}
+	return p.alternateDERP
+}
+
+// XDialOriginalDERP returns the plan's baseline HomeDERP for same-module
+// causal validation. It must never cross the app boundary.
+func (p *XDialDERPHomeReselectionPlan) XDialOriginalDERP() int {
+	if p == nil {
+		return 0
+	}
+	return p.originalDERP
+}
+
+// XDialNodeKey returns the plan's node identity for same-module validation.
+// It must never cross the app boundary.
+func (p *XDialDERPHomeReselectionPlan) XDialNodeKey() key.NodePublic {
+	if p == nil {
+		return key.NodePublic{}
+	}
+	return p.privateKey
+}
