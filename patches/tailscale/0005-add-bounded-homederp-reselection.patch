diff --git a/ipn/ipnlocal/xdial_derp_reselection.go b/ipn/ipnlocal/xdial_derp_reselection.go
new file mode 100644
index 0000000..ea96496
--- /dev/null
+++ b/ipn/ipnlocal/xdial_derp_reselection.go
@@ -0,0 +1,280 @@
+// Copyright (c) Tailscale Inc & contributors
+// SPDX-License-Identifier: BSD-3-Clause
+
+package ipnlocal
+
+import (
+	"context"
+	"errors"
+	"time"
+
+	"github.com/sagernet/tailscale/control/controlclient"
+	"github.com/sagernet/tailscale/types/key"
+	"github.com/sagernet/tailscale/types/netmap"
+)
+
+// XDialDERPHomeReselection reports only bounded relations. No DERP region,
+// endpoint, node key, tailnet name, or credential leaves the patched module.
+type XDialDERPHomeReselection struct {
+	ControlGeneration                   uint64
+	AlternatePrepared                   bool
+	HomePromoted                        bool
+	ControlClientNotified               bool
+	ControlUpdateObservable             bool
+	ControlUpdateQueued                 bool
+	ControlUpdateAttempted              bool
+	ControlUpdateHTTPAccepted           bool
+	ControlUpdateFailed                 bool
+	ControlUpdateSuperseded             bool
+	ControlViewAligned                  bool
+	FailureCode                         string
+	PrecommitBaselineChecked            bool
+	PlanNodeMatchesCurrent              bool
+	ControlSelfPresent                  bool
+	ControlSelfNodeMatchesCurrent       bool
+	ControlSelfHomeMatchesPlanOriginal  bool
+	ControlSelfHomeMatchesPlanAlternate bool
+	ControlNetInfoSetForCurrentClient   bool
+	ControlNetInfoMatchesPlanOriginal   bool
+	ControlNetInfoMatchesPlanAlternate  bool
+}
+
+type xdialControlUpdateFacts struct {
+	observable   bool
+	queued       bool
+	attempted    bool
+	httpAccepted bool
+	failed       bool
+	superseded   bool
+}
+
+func xdialControlUpdateFactsFromState(
+	state controlclient.XDialNetInfoReceiptState,
+) xdialControlUpdateFacts {
+	return xdialControlUpdateFacts{
+		observable:   state.Observable,
+		queued:       state.Queued,
+		attempted:    state.Attempted,
+		httpAccepted: state.HTTPAccepted,
+		failed:       state.Failed,
+		superseded:   state.Superseded,
+	}
+}
+
+func xdialLocalControlBaselineMatches(
+	planNodeMatches bool,
+	netInfoSetForCurrentClient bool,
+	netInfoPreferredDERP int,
+	originalDERP int,
+) bool {
+	return planNodeMatches &&
+		netInfoSetForCurrentClient &&
+		netInfoPreferredDERP == originalDERP
+}
+
+type xdialControlBaselineFacts struct {
+	selfPresent          bool
+	nodeMatches          bool
+	homeMatchesOriginal  bool
+	homeMatchesAlternate bool
+}
+
+func xdialControlBaseline(
+	netMap *netmap.NetworkMap,
+	nodeKey key.NodePublic,
+	originalDERP int,
+	alternateDERP int,
+) xdialControlBaselineFacts {
+	facts := xdialControlBaselineFacts{
+		selfPresent: netMap != nil && netMap.SelfNode.Valid(),
+	}
+	if !facts.selfPresent {
+		return facts
+	}
+	facts.nodeMatches = netMap.SelfNode.Key() == nodeKey
+	if !facts.nodeMatches {
+		return facts
+	}
+	facts.homeMatchesOriginal =
+		netMap.SelfNode.HomeDERP() == originalDERP
+	facts.homeMatchesAlternate =
+		netMap.SelfNode.HomeDERP() == alternateDERP
+	return facts
+}
+
+// XDialReselectHomeDERP performs one bounded Prepare-only home change. It
+// commits only while the same control client and node identity remain current.
+// The server-provided SelfNode HomeDERP is sampled for diagnostics but is not
+// used as a synchronous acknowledgement: SetNetInfo has no such protocol
+// contract. A fresh handshake and real egress remain the caller's success gate.
+func (b *LocalBackend) XDialReselectHomeDERP(
+	ctx context.Context,
+) (result XDialDERPHomeReselection, err error) {
+	if ctx == nil {
+		return result, errors.New("reselection context is nil")
+	}
+
+	b.mu.Lock()
+	controlClient := b.cc
+	controlGeneration := b.xdialControlNetInfo.generation
+	nodeKey := key.NodePublic{}
+	if controlClient != nil &&
+		controlGeneration != 0 &&
+		b.pm != nil &&
+		b.hasNodeKeyLocked() {
+		nodeKey = b.pm.CurrentPrefs().Persist().PublicNodeKey()
+	}
+	b.mu.Unlock()
+	result.ControlGeneration = controlGeneration
+	if controlClient == nil || controlGeneration == 0 {
+		return result, errors.New("current control client is unavailable")
+	}
+	if nodeKey.IsZero() {
+		return result, errors.New("current node key is unavailable")
+	}
+
+	mc := b.MagicConn()
+	if mc == nil {
+		return result, errors.New("magicsock is unavailable")
+	}
+	plan, err := mc.XDialPrepareHomeDERPReselection(ctx)
+	if err != nil {
+		return result, err
+	}
+	cancelPlan := true
+	defer func() {
+		if cancelPlan {
+			mc.XDialCancelHomeDERPReselection(plan)
+		}
+	}()
+	if err := ctx.Err(); err != nil {
+		return result, err
+	}
+	result.AlternatePrepared = true
+
+	b.xdialNetInfoSendMu.Lock()
+	b.mu.Lock()
+	if err := ctx.Err(); err != nil {
+		b.mu.Unlock()
+		b.xdialNetInfoSendMu.Unlock()
+		return result, err
+	}
+	sameControl :=
+		b.cc == controlClient &&
+			b.xdialControlNetInfo.generation == controlGeneration
+	sameNode :=
+		b.hasNodeKeyLocked() &&
+			b.pm.CurrentPrefs().Persist().PublicNodeKey() == nodeKey
+	if !sameControl || !sameNode {
+		b.mu.Unlock()
+		b.xdialNetInfoSendMu.Unlock()
+		return result, errors.New("control or node identity changed during DERP preparation")
+	}
+	netMap := b.NetMap()
+	originalDERP := plan.XDialOriginalDERP()
+	alternateDERP := plan.XDialAlternateDERP()
+	planNodeMatches := plan.XDialNodeKey() == nodeKey
+	controlBaseline := xdialControlBaseline(
+		netMap,
+		nodeKey,
+		originalDERP,
+		alternateDERP,
+	)
+	netInfoSet :=
+		b.xdialControlNetInfo.setGeneration == controlGeneration
+	netInfoPreferredDERP := b.xdialControlNetInfo.setPreferredDERP
+	result.PrecommitBaselineChecked = true
+	result.PlanNodeMatchesCurrent = planNodeMatches
+	result.ControlSelfPresent = controlBaseline.selfPresent
+	result.ControlSelfNodeMatchesCurrent = controlBaseline.nodeMatches
+	result.ControlSelfHomeMatchesPlanOriginal =
+		controlBaseline.homeMatchesOriginal
+	result.ControlSelfHomeMatchesPlanAlternate =
+		controlBaseline.homeMatchesAlternate
+	result.ControlNetInfoSetForCurrentClient = netInfoSet
+	result.ControlNetInfoMatchesPlanOriginal =
+		netInfoSet && netInfoPreferredDERP == originalDERP
+	result.ControlNetInfoMatchesPlanAlternate =
+		netInfoSet && netInfoPreferredDERP == alternateDERP
+	sameBaseline := xdialLocalControlBaselineMatches(
+		planNodeMatches,
+		netInfoSet,
+		netInfoPreferredDERP,
+		originalDERP,
+	)
+	if !sameBaseline {
+		b.mu.Unlock()
+		b.xdialNetInfoSendMu.Unlock()
+		result.FailureCode = "local_control_baseline_mismatch"
+		return result, nil
+	}
+	commit, commitErr := mc.XDialCommitHomeDERPReselection(ctx, plan)
+	b.mu.Unlock()
+	b.xdialNetInfoSendMu.Unlock()
+	if commitErr != nil {
+		return result, commitErr
+	}
+	cancelPlan = false
+	result.AlternatePrepared = commit.AlternatePrepared
+	result.HomePromoted = commit.HomePromoted
+	if !commit.NetInfoCallbackScheduled {
+		return result, nil
+	}
+
+	ticker := time.NewTicker(25 * time.Millisecond)
+	defer ticker.Stop()
+	for {
+		b.mu.Lock()
+		sameControl =
+			b.cc == controlClient &&
+				b.xdialControlNetInfo.generation == controlGeneration
+		sameNode =
+			b.hasNodeKeyLocked() &&
+				b.pm.CurrentPrefs().Persist().PublicNodeKey() == nodeKey
+		notified :=
+			b.xdialControlNetInfo.setGeneration == controlGeneration &&
+				b.xdialControlNetInfo.setPreferredDERP == alternateDERP
+		updateReceipt := b.xdialControlNetInfo.setReceipt
+		b.mu.Unlock()
+		if notified {
+			result.ControlClientNotified = true
+			updateFacts := xdialControlUpdateFactsFromState(
+				updateReceipt.State(),
+			)
+			result.ControlUpdateObservable = updateFacts.observable
+			result.ControlUpdateQueued = updateFacts.queued
+			result.ControlUpdateAttempted = updateFacts.attempted
+			result.ControlUpdateHTTPAccepted =
+				updateFacts.httpAccepted
+			result.ControlUpdateFailed = updateFacts.failed
+			result.ControlUpdateSuperseded =
+				updateFacts.superseded
+		}
+		if !sameControl || !sameNode {
+			return result, nil
+		}
+		if notified {
+			netMap := b.NetMap()
+			aligned :=
+				netMap != nil &&
+					netMap.SelfNode.Valid() &&
+					netMap.SelfNode.Key() == nodeKey &&
+					netMap.SelfNode.HomeDERP() == alternateDERP
+			result.ControlViewAligned = aligned
+			if result.ControlUpdateHTTPAccepted ||
+				!result.ControlUpdateObservable ||
+				!result.ControlUpdateQueued {
+				return result, nil
+			}
+		}
+
+		select {
+		case <-ctx.Done():
+			// The local promotion and any observed control call are facts.
+			// Return them without converting an observation timeout into a
+			// false claim that the operation never happened.
+			return result, nil
+		case <-ticker.C:
+		}
+	}
+}
