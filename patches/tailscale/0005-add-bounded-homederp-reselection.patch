+)
+
+func xdialTestDERPMap() *tailcfg.DERPMap {
+	return &tailcfg.DERPMap{
+		Regions: map[int]*tailcfg.DERPRegion{
+			2: {
+				RegionID: 2,
+				Nodes:    []*tailcfg.DERPNode{{RegionID: 2}},
+			},
+			3: {
+				RegionID: 3,
+				Nodes:    []*tailcfg.DERPNode{{RegionID: 3}},
+			},
+			4: {
+				RegionID: 4,
+				Nodes:    []*tailcfg.DERPNode{{RegionID: 4}},
+			},
+			5: {
+				RegionID: 5,
+				Avoid:    true,
+				Nodes:    []*tailcfg.DERPNode{{RegionID: 5}},
+			},
+			6: {
+				RegionID:        6,
+				NoMeasureNoHome: true,
+				Nodes:           []*tailcfg.DERPNode{{RegionID: 6}},
+			},
+		},
+	}
+}
+
+func TestXDialPickAlternateDERPUsesLowestMeasuredLatency(t *testing.T) {
+	report := &netcheck.Report{
+		RegionLatency: map[int]time.Duration{
+			2: 20 * time.Millisecond,
+			3: 30 * time.Millisecond,
+			4: 10 * time.Millisecond,
+			5: 5 * time.Millisecond,
+			6: 1 * time.Millisecond,
+		},
+	}
+	if got := xdialPickAlternateDERP(
+		2,
+		report,
+		xdialTestDERPMap(),
+	); got != 4 {
+		t.Fatalf("alternate DERP = %d, want lowest eligible region 4", got)
+	}
+}
+
+func TestXDialPickAlternateDERPRejectsUnmeasuredAndUnknown(t *testing.T) {
+	report := &netcheck.Report{
+		RegionLatency: map[int]time.Duration{
+			2: 20 * time.Millisecond,
+			3: 0,
+			7: 10 * time.Millisecond,
+		},
+	}
+	if got := xdialPickAlternateDERP(
+		2,
+		report,
+		xdialTestDERPMap(),
+	); got != 0 {
+		t.Fatalf("alternate DERP = %d, want none", got)
+	}
+}
+
+func TestXDialCommitHomeDERPReselectionIsAtomic(t *testing.T) {
+	c := newConn(t.Logf)
+	privateKey := key.NewNode()
+	originalClient := newXDialTestDERPClient(t, privateKey)
+	alternateClient := newXDialTestDERPClient(t, privateKey)
+	oldWrite := time.Now().Add(-2 * time.Minute)
+	callback := make(chan *tailcfg.NetInfo, 1)
+	plan := &XDialDERPHomeReselectionPlan{
+		conn:            c,
+		attemptID:       1,
+		originalDERP:    2,
+		alternateDERP:   4,
+		privateKey:      privateKey.Public(),
+		alternateClient: alternateClient,
+	}
+
+	c.mu.Lock()
+	c.privateKey = privateKey
+	c.myDerp = 2
+	c.derpMap = xdialTestDERPMap()
+	c.derpMapAtomic.Store(c.derpMap)
+	c.activeDerp = map[int]activeDerp{
+		2: {
+			c:         originalClient,
+			lastWrite: &oldWrite,
+		},
+		4: {
+			c:             alternateClient,
+			lastWrite:     new(time.Time),
+			protocolReady: true,
+		},
+	}
+	c.netInfoLast = &tailcfg.NetInfo{PreferredDERP: 2}
+	c.netInfoFunc = func(ni *tailcfg.NetInfo) { callback <- ni }
+	c.xdialDERPReselectionSeq = 1
+	c.xdialDERPReselectionActive = 1
+	c.mu.Unlock()
+
+	result, err := c.XDialCommitHomeDERPReselection(
+		context.Background(),
+		plan,
+	)
+	if err != nil {
+		t.Fatalf("commit failed: %v", err)
+	}
+	if !result.AlternatePrepared ||
+		!result.HomePromoted ||
+		!result.NetInfoCallbackScheduled {
+		t.Fatalf("incomplete commit result: %+v", result)
+	}
+	select {
+	case ni := <-callback:
+		if ni.PreferredDERP != 4 {
+			t.Fatalf("callback PreferredDERP = %d, want 4", ni.PreferredDERP)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("NetInfo callback was not scheduled")
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.myDerp != 4 || c.xdialPinnedDERP != 4 {
+		t.Fatalf("home=%d pin=%d, want 4", c.myDerp, c.xdialPinnedDERP)
+	}
+	if oldWrite.Before(time.Now().Add(-time.Minute)) {
+		t.Fatalf("original HomeDERP grace was not refreshed: %v", oldWrite)
+	}
+}
+
+func TestXDialPinnedDERPWinsOverInflightReport(t *testing.T) {
+	c := newConn(t.Logf)
+	privateKey := key.NewNode()
+	c.mu.Lock()
+	c.privateKey = privateKey
+	c.derpMap = xdialTestDERPMap()
+	c.myDerp = 4
+	c.xdialPinnedDERP = 4
+	c.mu.Unlock()
+	report := &netcheck.Report{
+		PreferredDERP: 2,
+		RegionLatency: map[int]time.Duration{
+			2: 10 * time.Millisecond,
+			4: 20 * time.Millisecond,
+		},
+	}
+	if got := c.maybeSetNearestDERP(report); got != 4 {
+		t.Fatalf("in-flight report selected DERP %d, want pinned 4", got)
+	}
+
+	callback := make(chan *tailcfg.NetInfo, 2)
+	c.mu.Lock()
+	c.netInfoLast = &tailcfg.NetInfo{
+		PreferredDERP: 4,
+		LinkType:      "wired",
+	}
+	c.netInfoFunc = func(ni *tailcfg.NetInfo) { callback <- ni }
+	c.mu.Unlock()
+	c.callNetInfoCallback(&tailcfg.NetInfo{
+		PreferredDERP: 2,
+		LinkType:      "wifi",
+	})
+	select {
+	case ni := <-callback:
+		if ni.PreferredDERP != 4 {
+			t.Fatalf("precomputed NetInfo published DERP %d, want pinned 4", ni.PreferredDERP)
+		}
+		if ni.LinkType != "wifi" {
+			t.Fatalf("precomputed NetInfo link type = %q, want wifi", ni.LinkType)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("precomputed NetInfo callback was not scheduled")
+	}
+	c.mu.Lock()
+	if c.netInfoLast.PreferredDERP != 4 {
+		t.Fatalf(
+			"cached NetInfo DERP = %d, want pinned 4",
+			c.netInfoLast.PreferredDERP,
+		)
+	}
+	c.mu.Unlock()
+
+	c.callNetInfoCallback(&tailcfg.NetInfo{
+		PreferredDERP: 2,
+		LinkType:      "wifi",
+	})
+	select {
+	case ni := <-callback:
+		t.Fatalf("equivalent normalized NetInfo was republished: %+v", ni)
+	case <-time.After(50 * time.Millisecond):
+	}
+	c.mu.Lock()
+	cachedPreferredDERP := c.netInfoLast.PreferredDERP
+	c.mu.Unlock()
+	if cachedPreferredDERP != 4 {
+		t.Fatalf(
+			"equivalent stale NetInfo reversed cache to DERP %d",
+			cachedPreferredDERP,
+		)
+	}
+
+	stale := &tailcfg.NetInfo{
+		PreferredDERP: 2,
+		LinkType:      "cellular",
+	}
+	normalized := c.XDialNormalizeNetInfoForControl(stale)
+	if stale.PreferredDERP != 2 {
+		t.Fatalf("control normalization mutated input DERP to %d", stale.PreferredDERP)
+	}
+	if normalized == stale {
+		t.Fatal("control normalization returned the input pointer")
+	}
+	if normalized.PreferredDERP != 4 || normalized.LinkType != "cellular" {
+		t.Fatalf("control normalization = %+v, want DERP 4 cellular", normalized)
+	}
+}
+
+func TestXDialPrepareHomeDERPReselectionRequiresFreshNetcheck(t *testing.T) {
+	c := newConn(t.Logf)
+	_, err := c.XDialPrepareHomeDERPReselection(t.Context())
+	if err == nil {
+		t.Fatal("reselection unexpectedly succeeded without a netcheck")
+	}
+}
+
+func TestXDialCommitHomeDERPReselectionHonorsCanceledContext(t *testing.T) {
+	c := newConn(t.Logf)
+	privateKey := key.NewNode()
+	alternateClient := newXDialTestDERPClient(t, privateKey)
+	callback := make(chan *tailcfg.NetInfo, 1)
+	plan := &XDialDERPHomeReselectionPlan{
+		conn:            c,
+		attemptID:       1,
+		originalDERP:    2,
+		alternateDERP:   4,
+		privateKey:      privateKey.Public(),
+		alternateClient: alternateClient,
+	}
+	c.mu.Lock()
+	c.privateKey = privateKey
+	c.myDerp = 2
+	c.derpMap = xdialTestDERPMap()
+	c.activeDerp = map[int]activeDerp{
+		4: {
+			c:             alternateClient,
+			lastWrite:     new(time.Time),
+			protocolReady: true,
+		},
+	}
+	c.netInfoLast = &tailcfg.NetInfo{PreferredDERP: 2}
+	c.netInfoFunc = func(ni *tailcfg.NetInfo) { callback <- ni }
+	c.xdialDERPReselectionSeq = 1
+	c.xdialDERPReselectionActive = 1
+	c.mu.Unlock()
+
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	result, err := c.XDialCommitHomeDERPReselection(ctx, plan)
+	if !errors.Is(err, context.Canceled) {
+		t.Fatalf("commit error = %v, want context canceled", err)
+	}
+	if result != (XDialDERPHomeReselectionCommit{}) {
+		t.Fatalf("canceled commit returned facts: %+v", result)
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.myDerp != 2 ||
+		c.xdialPinnedDERP != 0 ||
+		plan.committed ||
+		c.netInfoLast.PreferredDERP != 2 {
+		t.Fatalf(
+			"canceled commit mutated home=%d pin=%d committed=%v netInfo=%d",
+			c.myDerp,
+			c.xdialPinnedDERP,
+			plan.committed,
+			c.netInfoLast.PreferredDERP,
+		)
+	}
+	select {
+	case ni := <-callback:
+		t.Fatalf("canceled commit published NetInfo: %+v", ni)
+	default:
+	}
+}
+
+func TestXDialPrivateKeyChangeInvalidatesReselection(t *testing.T) {
+	oldKey := key.NewNode()
+	newKey := key.NewNode()
+	tests := []struct {
+		name           string
+		newKey         key.NodePrivate
+		wantPin        int
+		wantActive     uint64
+		wantPublicZero bool
+	}{
+		{
+			name:       "same key",
+			newKey:     oldKey,
+			wantPin:    4,
+			wantActive: 1,
+		},
+		{
+			name:       "changed key",
+			newKey:     newKey,
+			wantPin:    0,
+			wantActive: 0,
+		},
+		{
+			name:           "zero key",
+			newKey:         key.NodePrivate{},
+			wantPin:        0,
+			wantActive:     0,
+			wantPublicZero: true,
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			c := newConn(t.Logf)
+			c.mu.Lock()
+			c.privateKey = oldKey
+			c.xdialPinnedDERP = 4
+			c.xdialDERPReselectionSeq = 1
+			c.xdialDERPReselectionActive = 1
+			c.mu.Unlock()
+
+			if err := c.SetPrivateKey(tt.newKey); err != nil {
+				t.Fatalf("SetPrivateKey failed: %v", err)
+			}
+			c.mu.Lock()
+			defer c.mu.Unlock()
+			if c.xdialPinnedDERP != tt.wantPin ||
+				c.xdialDERPReselectionActive != tt.wantActive ||
+				c.xdialDERPReselectionSeq != 1 {
+				t.Fatalf(
+					"pin=%d active=%d seq=%d, want pin=%d active=%d seq=1",
+					c.xdialPinnedDERP,
+					c.xdialDERPReselectionActive,
+					c.xdialDERPReselectionSeq,
+					tt.wantPin,
+					tt.wantActive,
+				)
+			}
+			if c.privateKey.IsZero() != tt.wantPublicZero {
+				t.Fatalf(
+					"public key zero=%v, want %v",
+					c.privateKey.IsZero(),
+					tt.wantPublicZero,
+				)
+			}
+		})
+	}
+}
