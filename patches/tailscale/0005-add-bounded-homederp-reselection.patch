+func TestXDialHomelessInvalidatesReselection(t *testing.T) {
+	c := newConn(t.Logf)
+	c.mu.Lock()
+	c.privateKey = key.NewNode()
+	c.derpMap = xdialTestDERPMap()
+	c.myDerp = 4
+	c.xdialPinnedDERP = 4
+	c.xdialDERPReselectionSeq = 1
+	c.xdialDERPReselectionActive = 1
+	c.mu.Unlock()
+
+	c.SetHomeless(true)
+	c.mu.Lock()
+	if c.myDerp != 0 ||
+		c.xdialPinnedDERP != 0 ||
+		c.xdialDERPReselectionActive != 0 ||
+		c.xdialDERPReselectionSeq != 1 {
+		t.Fatalf(
+			"home=%d pin=%d active=%d seq=%d after homeless",
+			c.myDerp,
+			c.xdialPinnedDERP,
+			c.xdialDERPReselectionActive,
+			c.xdialDERPReselectionSeq,
+		)
+	}
+	c.mu.Unlock()
+
+}
