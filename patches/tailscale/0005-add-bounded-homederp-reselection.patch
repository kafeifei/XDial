diff --git a/control/controlclient/xdial_update.go b/control/controlclient/xdial_update.go
new file mode 100644
index 0000000..066b350
--- /dev/null
+++ b/control/controlclient/xdial_update.go
@@ -0,0 +1,149 @@
+// Copyright (c) Tailscale Inc & contributors
+// SPDX-License-Identifier: BSD-3-Clause
+
+package controlclient
+
+type xdialNetInfoSnapshot struct {
+	revision      uint64
+	present       bool
+	preferredDERP int
+}
+
+func (c *Direct) xdialNetInfoSnapshotLocked() xdialNetInfoSnapshot {
+	snapshot := xdialNetInfoSnapshot{
+		revision: c.xdialNetInfoRevision,
+		present:  c.netinfo != nil,
+	}
+	if c.netinfo != nil {
+		snapshot.preferredDERP = c.netinfo.PreferredDERP
+	}
+	return snapshot
+}
+
+func (c *Direct) xdialNetInfoSnapshot() xdialNetInfoSnapshot {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return c.xdialNetInfoSnapshotLocked()
+}
+
+type xdialLiteMapAck struct {
+	generation updateGen
+	netInfo    xdialNetInfoSnapshot
+}
+
+// XDialNetInfoReceipt binds one NetInfo value to the control update generation
+// that covers it. Its fields intentionally remain private so no DERP identifier
+// or request payload can leave the patched module.
+type XDialNetInfoReceipt struct {
+	client          *Auto
+	generation      updateGen
+	netInfoRevision uint64
+	preferredDERP   int
+	netInfoPresent  bool
+}
+
+// XDialNetInfoReceiptState reports only bounded lifecycle facts. HTTPAccepted
+// means a lite map request carrying this receipt's NetInfo snapshot received a
+// successful HTTP response and its body was drained. It does not claim another
+// peer consumed a resulting network map.
+type XDialNetInfoReceiptState struct {
+	Observable   bool
+	Queued       bool
+	Attempted    bool
+	HTTPAccepted bool
+	Failed       bool
+	Superseded   bool
+	ClientClosed bool
+}
+
+func (c *Auto) xdialReceiptLocked(
+	generation updateGen,
+	snapshot xdialNetInfoSnapshot,
+) XDialNetInfoReceipt {
+	receipt := XDialNetInfoReceipt{
+		client:          c,
+		generation:      generation,
+		netInfoRevision: snapshot.revision,
+		preferredDERP:   snapshot.preferredDERP,
+		netInfoPresent:  snapshot.present,
+	}
+	c.xdialLastNetInfoReceipt = receipt
+	return receipt
+}
+
+func (r XDialNetInfoReceipt) xdialMatches(
+	client *Auto,
+	snapshot xdialNetInfoSnapshot,
+) bool {
+	return r.client == client &&
+		r.generation > 0 &&
+		r.netInfoRevision == snapshot.revision &&
+		r.netInfoPresent == snapshot.present &&
+		(!snapshot.present ||
+			r.preferredDERP == snapshot.preferredDERP)
+}
+
+func (c *Auto) xdialRecordHTTPAcceptedLocked(
+	generation updateGen,
+	snapshot xdialNetInfoSnapshot,
+) {
+	ack := xdialLiteMapAck{
+		generation: generation,
+		netInfo:    snapshot,
+	}
+	if generation >= c.xdialLastHTTPAccepted.generation {
+		c.xdialLastHTTPAccepted = ack
+	}
+	if !snapshot.present {
+		return
+	}
+	if c.xdialHTTPAcceptedByPreferredDERP == nil {
+		c.xdialHTTPAcceptedByPreferredDERP =
+			make(map[int]xdialLiteMapAck)
+	}
+	previous :=
+		c.xdialHTTPAcceptedByPreferredDERP[snapshot.preferredDERP]
+	if generation >= previous.generation &&
+		snapshot.revision >= previous.netInfo.revision {
+		c.xdialHTTPAcceptedByPreferredDERP[snapshot.preferredDERP] =
+			ack
+	}
+}
+
+// State samples this receipt without waiting or performing network I/O.
+func (r XDialNetInfoReceipt) State() XDialNetInfoReceiptState {
+	if r.client == nil || r.generation == 0 {
+		return XDialNetInfoReceiptState{}
+	}
+	c := r.client
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	state := XDialNetInfoReceiptState{
+		Observable:   true,
+		Queued:       true,
+		Attempted:    c.xdialLastUpdateAttemptedGen >= r.generation,
+		Failed:       c.xdialLastUpdateFailedGen >= r.generation,
+		ClientClosed: c.closed,
+	}
+	if r.netInfoPresent {
+		ack :=
+			c.xdialHTTPAcceptedByPreferredDERP[r.preferredDERP]
+		state.HTTPAccepted =
+			ack.generation >= r.generation &&
+				ack.netInfo.revision >= r.netInfoRevision &&
+				ack.netInfo.present &&
+				ack.netInfo.preferredDERP == r.preferredDERP
+	}
+	if state.HTTPAccepted {
+		state.Failed = false
+		return state
+	}
+	latest := c.xdialLastHTTPAccepted
+	state.Superseded =
+		latest.generation >= r.generation &&
+			latest.netInfo.revision >= r.netInfoRevision &&
+			(!latest.netInfo.present ||
+				latest.netInfo.preferredDERP != r.preferredDERP)
+	return state
+}
diff --git a/control/controlclient/xdial_update_test.go b/control/controlclient/xdial_update_test.go
new file mode 100644
index 0000000..2bfb4d5
--- /dev/null
+++ b/control/controlclient/xdial_update_test.go
@@ -0,0 +1,88 @@
+// Copyright (c) Tailscale Inc & contributors
+// SPDX-License-Identifier: BSD-3-Clause
+
+package controlclient
+
+import "testing"
+
+func TestXDialNetInfoReceiptRequiresExactHTTPAcceptedSnapshot(
+	t *testing.T,
+) {
+	c := &Auto{}
+	snapshot := xdialNetInfoSnapshot{
+		revision:      7,
+		present:       true,
+		preferredDERP: 2,
+	}
+	c.mu.Lock()
+	receipt := c.xdialReceiptLocked(12, snapshot)
+	c.xdialLastUpdateAttemptedGen = 12
+	c.xdialLastUpdateFailedGen = 12
+	c.mu.Unlock()
+
+	state := receipt.State()
+	if !state.Observable || !state.Queued || !state.Attempted ||
+		!state.Failed || state.HTTPAccepted || state.Superseded {
+		t.Fatalf("failed attempt state = %+v", state)
+	}
+
+	c.mu.Lock()
+	c.xdialRecordHTTPAcceptedLocked(
+		11,
+		snapshot,
+	)
+	c.mu.Unlock()
+	state = receipt.State()
+	if state.HTTPAccepted {
+		t.Fatalf("older generation accepted receipt: %+v", state)
+	}
+
+	c.mu.Lock()
+	c.xdialRecordHTTPAcceptedLocked(
+		12,
+		xdialNetInfoSnapshot{
+			revision:      8,
+			present:       true,
+			preferredDERP: 3,
+		},
+	)
+	c.mu.Unlock()
+	state = receipt.State()
+	if state.HTTPAccepted || !state.Superseded {
+		t.Fatalf("different NetInfo snapshot = %+v", state)
+	}
+
+	c.mu.Lock()
+	c.xdialRecordHTTPAcceptedLocked(13, snapshot)
+	c.mu.Unlock()
+	state = receipt.State()
+	if !state.HTTPAccepted || state.Failed || state.Superseded {
+		t.Fatalf("exact accepted state = %+v", state)
+	}
+}
+
+func TestXDialNetInfoReceiptIsBoundToClientAndRevision(t *testing.T) {
+	c := &Auto{}
+	snapshot := xdialNetInfoSnapshot{
+		revision:      4,
+		present:       true,
+		preferredDERP: 5,
+	}
+	c.mu.Lock()
+	receipt := c.xdialReceiptLocked(9, snapshot)
+	c.mu.Unlock()
+
+	if !receipt.xdialMatches(c, snapshot) {
+		t.Fatal("receipt did not match its client snapshot")
+	}
+	if receipt.xdialMatches(&Auto{}, snapshot) {
+		t.Fatal("receipt crossed control clients")
+	}
+	snapshot.revision++
+	if receipt.xdialMatches(c, snapshot) {
+		t.Fatal("receipt crossed NetInfo revisions")
+	}
+	if state := (XDialNetInfoReceipt{}).State(); state.Observable {
+		t.Fatalf("zero receipt became observable: %+v", state)
+	}
+}
