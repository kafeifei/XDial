+)
+
+func TestXDialDERPHomeReselectionRequiresCurrentControlClient(t *testing.T) {
+	var backend LocalBackend
+	result, err := backend.XDialReselectHomeDERP(context.Background())
+	if err == nil {
+		t.Fatal("reselection unexpectedly succeeded without a control client")
+	}
+	if result.ControlGeneration != 0 ||
+		result.AlternatePrepared ||
+		result.HomePromoted ||
+		result.ControlClientNotified ||
+		result.ControlUpdateObservable ||
+		result.ControlUpdateQueued ||
+		result.ControlUpdateAttempted ||
+		result.ControlUpdateHTTPAccepted ||
+		result.ControlUpdateFailed ||
+		result.ControlUpdateSuperseded ||
+		result.ControlViewAligned {
+		t.Fatalf(
+			"reselection mutated state without a control client: %+v",
+			result,
+		)
+	}
+}
+
+func TestXDialControlUpdateFactsPreserveReceiptState(
+	t *testing.T,
+) {
+	tests := []struct {
+		name  string
+		state controlclient.XDialNetInfoReceiptState
+		want  xdialControlUpdateFacts
+	}{
+		{
+			name: "not observable",
+		},
+		{
+			name: "queued",
+			state: controlclient.XDialNetInfoReceiptState{
+				Observable: true,
+				Queued:     true,
+			},
+			want: xdialControlUpdateFacts{
+				observable: true,
+				queued:     true,
+			},
+		},
+		{
+			name: "attempted and failed",
+			state: controlclient.XDialNetInfoReceiptState{
+				Observable: true,
+				Queued:     true,
+				Attempted:  true,
+				Failed:     true,
+			},
+			want: xdialControlUpdateFacts{
+				observable: true,
+				queued:     true,
+				attempted:  true,
+				failed:     true,
+			},
+		},
+		{
+			name: "superseded",
+			state: controlclient.XDialNetInfoReceiptState{
+				Observable: true,
+				Queued:     true,
+				Attempted:  true,
+				Superseded: true,
+			},
+			want: xdialControlUpdateFacts{
+				observable: true,
+				queued:     true,
+				attempted:  true,
+				superseded: true,
+			},
+		},
+		{
+			name: "target accepted",
+			state: controlclient.XDialNetInfoReceiptState{
+				Observable:   true,
+				Queued:       true,
+				Attempted:    true,
+				HTTPAccepted: true,
+			},
+			want: xdialControlUpdateFacts{
+				observable:   true,
+				queued:       true,
+				attempted:    true,
+				httpAccepted: true,
+			},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got := xdialControlUpdateFactsFromState(
+				tt.state,
+			)
+			if got != tt.want {
+				t.Fatalf("facts = %+v, want %+v", got, tt.want)
+			}
+		})
+	}
+}
+
+func TestXDialLocalControlBaselineUsesCurrentGenerationNetInfo(
+	t *testing.T,
+) {
+	tests := []struct {
+		name            string
+		planNodeMatches bool
+		netInfoSet      bool
+		preferredDERP   int
+		originalDERP    int
+		want            bool
+	}{
+		{
+			name:            "matching current generation",
+			planNodeMatches: true,
+			netInfoSet:      true,
+			preferredDERP:   2,
+			originalDERP:    2,
+			want:            true,
+		},
+		{
+			name:          "plan identity changed",
+			netInfoSet:    true,
+			preferredDERP: 2,
+			originalDERP:  2,
+		},
+		{
+			name:            "current generation has no NetInfo",
+			planNodeMatches: true,
+			preferredDERP:   2,
+			originalDERP:    2,
+		},
+		{
+			name:            "NetInfo no longer matches original",
+			planNodeMatches: true,
+			netInfoSet:      true,
+			preferredDERP:   3,
+			originalDERP:    2,
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got := xdialLocalControlBaselineMatches(
+				tt.planNodeMatches,
+				tt.netInfoSet,
+				tt.preferredDERP,
+				tt.originalDERP,
+			)
+			if got != tt.want {
+				t.Fatalf("baseline match = %v, want %v", got, tt.want)
+			}
+		})
+	}
+}
+
+func TestXDialControlHomeMatchesExactBaseline(t *testing.T) {
+	nodeKey := key.NewNode().Public()
+	otherKey := key.NewNode().Public()
+	netMap := &netmap.NetworkMap{
+		SelfNode: (&tailcfg.Node{
+			Key:      nodeKey,
+			HomeDERP: 2,
+		}).View(),
+	}
+	tests := []struct {
+		name          string
+		netMap        *netmap.NetworkMap
+		nodeKey       key.NodePublic
+		originalDERP  int
+		alternateDERP int
+		want          xdialControlBaselineFacts
+	}{
+		{
+			name:          "exact baseline",
+			netMap:        netMap,
+			nodeKey:       nodeKey,
+			originalDERP:  2,
+			alternateDERP: 3,
+			want: xdialControlBaselineFacts{
+				selfPresent:         true,
+				nodeMatches:         true,
+				homeMatchesOriginal: true,
+			},
+		},
+		{
+			name:          "already at alternate",
+			netMap:        netMap,
+			nodeKey:       nodeKey,
+			originalDERP:  3,
+			alternateDERP: 2,
+			want: xdialControlBaselineFacts{
+				selfPresent:          true,
+				nodeMatches:          true,
+				homeMatchesAlternate: true,
+			},
+		},
+		{
+			name:          "missing map",
+			nodeKey:       nodeKey,
+			originalDERP:  2,
+			alternateDERP: 3,
+		},
+		{
+			name:          "invalid self",
+			netMap:        &netmap.NetworkMap{},
+			nodeKey:       nodeKey,
+			originalDERP:  2,
+			alternateDERP: 3,
+		},
+		{
+			name:          "different node",
+			netMap:        netMap,
+			nodeKey:       otherKey,
+			originalDERP:  2,
+			alternateDERP: 3,
+			want: xdialControlBaselineFacts{
+				selfPresent: true,
+			},
+		},
+		{
+			name:          "unrelated home",
+			netMap:        netMap,
+			nodeKey:       nodeKey,
+			originalDERP:  3,
+			alternateDERP: 4,
+			want: xdialControlBaselineFacts{
+				selfPresent: true,
+				nodeMatches: true,
+			},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			if got := xdialControlBaseline(
+				tt.netMap,
+				tt.nodeKey,
+				tt.originalDERP,
+				tt.alternateDERP,
+			); got != tt.want {
+				t.Fatalf("baseline match = %v, want %v", got, tt.want)
+			}
+		})
+	}
+}
