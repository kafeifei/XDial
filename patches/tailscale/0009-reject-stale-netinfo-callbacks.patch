@@ -235,6 +241,64 @@ func TestXDialPinnedDERPWinsOverInflightReport(t *testing.T) {
 	}
 }
 
+func TestXDialNetInfoControlBoundaryRejectsSupersededCallbacks(
+	t *testing.T,
+) {
+	c := newConn(t.Logf)
+	first := &tailcfg.NetInfo{
+		PreferredDERP: 3,
+		LinkType:      "cellular",
+	}
+	second := &tailcfg.NetInfo{
+		PreferredDERP: 3,
+		LinkType:      "wifi",
+	}
+
+	c.mu.Lock()
+	c.myDerp = 3
+	c.netInfoLast = first
+	c.mu.Unlock()
+	accepted, current := c.XDialNormalizeNetInfoForControl(first)
+	if !current || accepted == nil {
+		t.Fatal("current NetInfo callback was rejected")
+	}
+	if accepted == first {
+		t.Fatal("current NetInfo callback was not cloned")
+	}
+
+	c.mu.Lock()
+	c.myDerp = 2
+	c.netInfoLast = second
+	c.mu.Unlock()
+	if stale, current := c.XDialNormalizeNetInfoForControl(first); current ||
+		stale != nil {
+		t.Fatal("superseded NetInfo callback was accepted")
+	}
+
+	accepted, current = c.XDialNormalizeNetInfoForControl(second)
+	if !current || accepted == nil {
+		t.Fatal("replacement NetInfo callback was rejected")
+	}
+	if accepted.PreferredDERP != 2 {
+		t.Fatalf(
+			"replacement callback published DERP %d, want runtime DERP 2",
+			accepted.PreferredDERP,
+		)
+	}
+	if second.PreferredDERP != 3 {
+		t.Fatalf(
+			"control normalization mutated replacement callback to DERP %d",
+			second.PreferredDERP,
+		)
+	}
+
+	c.ResetNetInfoLast()
+	if reset, current := c.XDialNormalizeNetInfoForControl(second); current ||
+		reset != nil {
+		t.Fatal("pre-reset NetInfo callback was accepted")
+	}
+}
