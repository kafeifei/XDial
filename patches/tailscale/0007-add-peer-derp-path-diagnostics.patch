+// XDialConnectionDiagnostics returns only bounded DERP transport facts. It
+// intentionally omits addresses, region identifiers, and server identities.
+type XDialConnectionDiagnostics struct {
+	Connected            bool
+	Closed               bool
+	Generation           int
+	IdealKnown           bool
+	Ideal                bool
+	ServerChangeSequence uint64
+}
+
+func (c *Client) XDialConnectionDiagnostics() XDialConnectionDiagnostics {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	state := c.atomicState.Load()
+	return XDialConnectionDiagnostics{
+		Connected:            state.Connected,
+		Closed:               state.Closed,
+		Generation:           c.connGen,
+		IdealKnown:           c.xdialIdealKnown,
+		Ideal:                c.xdialIdeal,
+		ServerChangeSequence: c.xdialServerChangeSeq,
+	}
+}
+
+// XDialConnectionGeneration safely returns the current DERP connection
+// generation without exposing the selected server.
+func (c *Client) XDialConnectionGeneration() int {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return c.connGen
+}
+
+// xdialRecordConnectionLocked records bounded properties of a newly
+// established connection. c.mu must be held.
+func (c *Client) xdialRecordConnectionLocked(
+	serverKey key.NodePublic,
+	idealKnown bool,
+	ideal bool,
+) {
+	if !serverKey.IsZero() {
+		if c.xdialServerIdentityKnown &&
+			c.xdialServerIdentity != serverKey {
+			c.xdialServerChangeSeq++
+		}
+		c.xdialServerIdentityKnown = true
+		c.xdialServerIdentity = serverKey
+	}
+	c.xdialIdealKnown = idealKnown
+	c.xdialIdeal = idealKnown && ideal
+}
+
 func (c *Client) String() string {
 	return fmt.Sprintf("<derphttp_client.Client %s url=%s>", c.ServerPublicKey().ShortString(), c.url)
 }
