+func TestXDialDERPReasonMappingsAreClosed(t *testing.T) {
+	closeReasons := map[string]string{
+		"derp-disabled":               xdialDERPClientCloseDisabled,
+		"derp-region-redefined":       xdialDERPClientCloseRegionRedefined,
+		"debug-break-derp":            xdialDERPClientCloseDebugBreak,
+		"network-down":                xdialDERPClientCloseNetworkDown,
+		"rebind-no-localaddr":         xdialDERPClientCloseRebindNoLocalAddr,
+		"rebind-default-route-change": xdialDERPClientCloseRebindDefaultRouteChange,
+		"rebind-ping-fail":            xdialDERPClientCloseRebindPingFailed,
+		"idle":                        xdialDERPClientCloseIdle,
+		"zero-private-key":            xdialDERPClientCloseZeroPrivateKey,
+		"new-private-key":             xdialDERPClientCloseNewPrivateKey,
+		"conn-close":                  xdialDERPClientCloseConnClose,
+		"set-homeless":                xdialDERPClientCloseSetHomeless,
+	}
+	for raw, want := range closeReasons {
+		if got := xdialDERPClientCloseReason(raw); got != want {
+			t.Fatalf("close reason %q = %q, want %q", raw, got, want)
+		}
+	}
+	if got := xdialDERPClientCloseReason("new-raw-reason"); got != xdialDERPClientCloseUnknown {
+		t.Fatalf("unknown close reason leaked as %q", got)
+	}
+	if got := xdialDERPReaderErrorReason(
+		errors.New("raw transport detail"),
+		false,
+		false,
+	); got != xdialDERPReaderErrorTransport {
+		t.Fatalf("raw reader error leaked as %q", got)
+	}
+	if got := xdialDERPRouteInvalidationReason("raw route detail"); got != xdialDERPRouteInvalidationUnknown {
+		t.Fatalf("raw route invalidation leaked as %q", got)
+	}
+	if got := xdialDERPBoundedReaderErrorReason("raw reader detail"); got != xdialDERPReaderErrorUnknown {
+		t.Fatalf("raw reader reason leaked as %q", got)
+	}
+	if got := xdialDERPBoundedRouteKind("raw route kind"); got != xdialDERPRouteKindNone {
+		t.Fatalf("raw route kind leaked as %q", got)
+	}
+	if !xdialDERPConnectionChangedSinceLastSend(1, 2) ||
+		xdialDERPConnectionChangedSinceLastSend(2, 2) ||
+		xdialDERPConnectionChangedSinceLastSend(0, 2) {
+		t.Fatal("same-client reconnect generation comparison is incorrect")
+	}
+}
