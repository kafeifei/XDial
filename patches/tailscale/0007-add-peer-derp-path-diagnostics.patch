new file mode 100644
index 0000000..78022a4
--- /dev/null
+++ b/derp/derphttp/xdial_diagnostics_test.go
@@ -0,0 +1,84 @@
+// Copyright (c) Tailscale Inc & AUTHORS
+// SPDX-License-Identifier: BSD-3-Clause
+
+package derphttp
+
+import (
+	"net/netip"
+	"testing"
+
+	"github.com/sagernet/tailscale/derp"
+	"github.com/sagernet/tailscale/types/key"
+)
+
+type xdialTestCloser struct {
+	closed bool
+}
+
+func (c *xdialTestCloser) Close() error {
+	c.closed = true
+	return nil
+}
+
+func TestXDialCloseForReconnectClearsConnectedState(t *testing.T) {
+	broken := new(derp.Client)
+	closer := new(xdialTestCloser)
+	c := new(Client)
+	c.client = broken
+	c.netConn = closer
+	c.connGen = 3
+	c.atomicState.Store(ConnectedState{
+		Connected: true,
+		LocalAddr: netip.MustParseAddrPort("192.0.2.1:1234"),
+	})
+
+	c.closeForReconnect(broken)
+
+	got := c.XDialConnectionDiagnostics()
+	if got.Connected || got.Closed || got.Generation != 3 {
+		t.Fatalf("diagnostics after reconnect close = %+v", got)
+	}
+	if c.client != nil || c.netConn != nil || !closer.closed {
+		t.Fatalf(
+			"reconnect close did not clear transport: client=%v conn=%v closed=%v",
+			c.client,
+			c.netConn,
+			closer.closed,
+		)
+	}
+}
+
+func TestXDialConnectionGenerationAndServerChange(t *testing.T) {
+	firstServer := key.NewNode().Public()
+	secondServer := key.NewNode().Public()
+	c := new(Client)
+
+	c.mu.Lock()
+	c.xdialRecordConnectionLocked(key.NodePublic{}, false, false)
+	c.serverPubKey = key.NodePublic{}
+	c.connGen++
+	c.xdialRecordConnectionLocked(firstServer, true, true)
+	c.serverPubKey = firstServer
+	c.connGen++
+	c.xdialRecordConnectionLocked(firstServer, true, false)
+	c.serverPubKey = firstServer
+	c.connGen++
+	c.xdialRecordConnectionLocked(secondServer, true, false)
+	c.serverPubKey = secondServer
+	c.connGen++
+	c.mu.Unlock()
+
+	got := c.XDialConnectionDiagnostics()
+	if got.Generation != 4 {
+		t.Fatalf("same Client reconnect generation = %d, want 4", got.Generation)
+	}
+	if !got.IdealKnown || got.Ideal {
+		t.Fatalf("last ideal-node relationship = %+v", got)
+	}
+	if got.ServerChangeSequence != 1 {
+		t.Fatalf("server change sequence = %d, want 1", got.ServerChangeSequence)
+	}
+	if generation := c.XDialConnectionGeneration(); generation != 4 {
+		t.Fatalf("safe generation = %d, want 4", generation)
+	}
+}
