+	"github.com/sagernet/tailscale/derp/derphttp"
+	"github.com/sagernet/tailscale/types/key"
+)
+
+const (
+	xdialDERPStateAbsent  = "absent"
+	xdialDERPStateCurrent = "current"
+	xdialDERPStateStale   = "stale"
+
+	xdialDERPRouteKindNone      = "none"
+	xdialDERPRouteKindRequested = "requested"
+	xdialDERPRouteKindReverse   = "reverse"
+
+	xdialDERPClientMissing              = "missing"
+	xdialDERPClientCurrentNotReady      = "current_not_ready"
+	xdialDERPClientCurrentProtocolReady = "current_protocol_ready"
+	xdialDERPClientStale                = "stale"
+	xdialDERPClientClosed               = "closed"
+	xdialDERPClientUnknown              = "unknown"
+
+	xdialDERPReasonNone = "none"
+
+	xdialDERPRouteInvalidationPeerGoneNotHere      = "peer_gone_not_here"
+	xdialDERPRouteInvalidationPeerGoneDisconnected = "peer_gone_disconnected"
+	xdialDERPRouteInvalidationPeerGoneUnknown      = "peer_gone_unknown"
+	xdialDERPRouteInvalidationReaderError          = "reader_error"
+	xdialDERPRouteInvalidationUnknown              = "unknown"
+
+	xdialDERPReaderErrorClientClosed    = "client_closed"
+	xdialDERPReaderErrorNetworkDown     = "network_down"
+	xdialDERPReaderErrorContextCanceled = "context_cancelled"
+	xdialDERPReaderErrorTransport       = "transport_error"
+	xdialDERPReaderErrorUnknown         = "unknown"
+
+	xdialDERPClientCloseDisabled                 = "derp_disabled"
+	xdialDERPClientCloseRegionRedefined          = "derp_region_redefined"
+	xdialDERPClientCloseDebugBreak               = "debug_break"
+	xdialDERPClientCloseNetworkDown              = "network_down"
+	xdialDERPClientCloseRebindNoLocalAddr        = "rebind_no_local_addr"
+	xdialDERPClientCloseRebindDefaultRouteChange = "rebind_default_route_change"
+	xdialDERPClientCloseRebindPingFailed         = "rebind_ping_failed"
+	xdialDERPClientCloseIdle                     = "idle"
+	xdialDERPClientCloseZeroPrivateKey           = "zero_private_key"
+	xdialDERPClientCloseNewPrivateKey            = "new_private_key"
+	xdialDERPClientCloseConnClose                = "conn_close"
+	xdialDERPClientCloseSetHomeless              = "set_homeless"
+	xdialDERPClientCloseUnknown                  = "unknown"
+)
+
+// XDialPeerDERPDiagnostics is a bounded, process-local view of the DERP path
+// most recently used for one peer. It intentionally contains no peer key,
+// region identifier, endpoint, address, or DERP server identity.
+type XDialPeerDERPDiagnostics struct {
+	Observed bool
+
+	ReplyRouteState      string
+	LastWriteRouteState  string
+	LastWriteRouteKind   string
+	LastWriteClientState string
+
+	LastWriteClientIdealKnown bool
+	LastWriteClientIdeal      bool
+	ServerChangeSequence      uint64
+
+	LastSendConnectionGeneration   int
+	CurrentConnectionGeneration    int
+	ConnectionChangedSinceLastSend bool
+
+	SendAttemptSequence uint64
+	SendSuccessSequence uint64
+	SendErrorSequence   uint64
+	LastSendWasDisco    bool
+
+	ReceivePacketSequence uint64
+
+	RouteInvalidationSequence uint64
+	RouteInvalidationReason   string
+
+	ReaderErrorSequence uint64
+	ReaderErrorReason   string
+
+	ServerInfoSequence uint64
+
+	ClientCloseSequence uint64
+	ClientCloseReason   string
+}
+
+type xdialPeerDERPLedger struct {
+	lastReplyRegion int
+	lastReplyClient *derphttp.Client
+
+	lastWriteRegion int
+	lastWriteClient *derphttp.Client
+	lastWriteKind   string
+
+	lastSendConnectionGeneration int
+	lastSendWasDisco             bool
+
+	sendAttemptSequence uint64
+	sendSuccessSequence uint64
+	sendErrorSequence   uint64
+
+	receivePacketSequence uint64
+
+	routeInvalidationSequence uint64
+	routeInvalidationReason   string
+
+	readerErrorSequence uint64
+	readerErrorReason   string
+
+	serverInfoSequence uint64
+
+	clientCloseSequence uint64
+	clientCloseReason   string
+}
+
+func (c *Conn) xdialNextPeerDERPSequenceLocked() uint64 {
+	c.xdialPeerDERPSequence++
+	return c.xdialPeerDERPSequence
+}
+
+func (c *Conn) xdialPeerDERPLedgerLocked(
+	peer key.NodePublic,
+	create bool,
+) *xdialPeerDERPLedger {
+	if peer.IsZero() {
+		return nil
+	}
+	if ledger := c.xdialPeerDERP[peer]; ledger != nil || !create {
+		return ledger
+	}
+	if c.xdialPeerDERP == nil {
+		c.xdialPeerDERP = make(map[key.NodePublic]*xdialPeerDERPLedger)
+	}
+	ledger := new(xdialPeerDERPLedger)
+	c.xdialPeerDERP[peer] = ledger
+	return ledger
+}
+
+func (c *Conn) xdialNotePeerDERPWriteRouteLocked(
+	peer key.NodePublic,
+	regionID int,
+	dc *derphttp.Client,
+	kind string,
+	active activeDerp,
+) {
+	ledger := c.xdialPeerDERPLedgerLocked(peer, true)
+	if ledger == nil {
+		return
+	}
+	ledger.lastWriteRegion = regionID
+	ledger.lastWriteClient = dc
+	ledger.lastWriteKind = kind
+	if active.xdialServerInfoSequence > ledger.serverInfoSequence {
+		ledger.serverInfoSequence = active.xdialServerInfoSequence
+	}
+}
+
+func (c *Conn) xdialNotePeerDERPSendAttempt(
+	peer key.NodePublic,
+	regionID int,
+	dc *derphttp.Client,
+	kind string,
+	isDisco bool,
+) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	ledger := c.xdialPeerDERPLedgerLocked(peer, true)
+	if ledger == nil {
+		return
+	}
+	ledger.lastWriteRegion = regionID
+	ledger.lastWriteClient = dc
+	ledger.lastWriteKind = kind
+	ledger.lastSendWasDisco = isDisco
+	if active, ok := c.activeDerp[regionID]; ok && active.c == dc &&
+		active.xdialServerInfoSequence > ledger.serverInfoSequence {
+		ledger.serverInfoSequence = active.xdialServerInfoSequence
+	}
+	ledger.sendAttemptSequence = c.xdialNextPeerDERPSequenceLocked()
+}
+
+func (c *Conn) xdialNotePeerDERPSendResult(
+	peer key.NodePublic,
+	regionID int,
+	dc *derphttp.Client,
+	kind string,
+	isDisco bool,
+	generation int,
+	err error,
+) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	ledger := c.xdialPeerDERPLedgerLocked(peer, true)
+	if ledger == nil {
+		return
+	}
+	ledger.lastWriteRegion = regionID
+	ledger.lastWriteClient = dc
+	ledger.lastWriteKind = kind
+	ledger.lastSendWasDisco = isDisco
+	ledger.lastSendConnectionGeneration = generation
+	if err != nil {
+		ledger.sendErrorSequence = c.xdialNextPeerDERPSequenceLocked()
+	} else {
+		ledger.sendSuccessSequence = c.xdialNextPeerDERPSequenceLocked()
+	}
+}
+
+func (c *Conn) xdialNotePeerDERPReceivePacket(
+	peer key.NodePublic,
+	regionID int,
+	dc *derphttp.Client,
+) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	ledger := c.xdialPeerDERPLedgerLocked(peer, true)
+	if ledger == nil {
+		return
+	}
+	ledger.lastReplyRegion = regionID
+	ledger.lastReplyClient = dc
+	ledger.receivePacketSequence = c.xdialNextPeerDERPSequenceLocked()
+}
+
+func (c *Conn) xdialRemoveDERPPeerRoute(
+	peer key.NodePublic,
+	regionID int,
+	dc *derphttp.Client,
+	reason string,
+	recordIfAbsent bool,
+) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	expected := derpRoute{regionID, dc}
+	route, present := c.derpRoute[peer]
+	current := present && route == expected
+	if current {
+		delete(c.derpRoute, peer)
+	}
+	if !current && !recordIfAbsent {
+		return
+	}
+	ledger := c.xdialPeerDERPLedgerLocked(peer, true)
+	if ledger == nil {
+		return
+	}
+	ledger.routeInvalidationSequence = c.xdialNextPeerDERPSequenceLocked()
+	ledger.routeInvalidationReason =
+		xdialDERPRouteInvalidationReason(reason)
+}
+
+func xdialDERPPeerGoneReason(reason derp.PeerGoneReasonType) string {
+	switch reason {
+	case derp.PeerGoneReasonNotHere:
+		return xdialDERPRouteInvalidationPeerGoneNotHere
+	case derp.PeerGoneReasonDisconnected:
+		return xdialDERPRouteInvalidationPeerGoneDisconnected
+	default:
+		return xdialDERPRouteInvalidationPeerGoneUnknown
+	}
+}
+
+func xdialDERPRouteInvalidationReason(reason string) string {
+	switch reason {
+	case xdialDERPRouteInvalidationPeerGoneNotHere,
+		xdialDERPRouteInvalidationPeerGoneDisconnected,
+		xdialDERPRouteInvalidationPeerGoneUnknown,
+		xdialDERPRouteInvalidationReaderError:
+		return reason
+	default:
+		return xdialDERPRouteInvalidationUnknown
+	}
+}
+
+func xdialDERPReaderErrorReason(
+	err error,
+	networkDown bool,
+	contextDone bool,
+) string {
+	switch {
+	case errors.Is(err, derphttp.ErrClientClosed):
+		return xdialDERPReaderErrorClientClosed
+	case networkDown:
+		return xdialDERPReaderErrorNetworkDown
+	case contextDone:
+		return xdialDERPReaderErrorContextCanceled
+	case err != nil:
+		return xdialDERPReaderErrorTransport
+	default:
+		return xdialDERPReaderErrorUnknown
+	}
+}
+
+func xdialDERPBoundedReaderErrorReason(reason string) string {
+	switch reason {
+	case xdialDERPReaderErrorClientClosed,
+		xdialDERPReaderErrorNetworkDown,
+		xdialDERPReaderErrorContextCanceled,
+		xdialDERPReaderErrorTransport,
+		xdialDERPReaderErrorUnknown:
+		return reason
+	default:
+		return xdialDERPReaderErrorUnknown
+	}
+}
+
+func (c *Conn) xdialLedgerUsesClientLocked(
+	peer key.NodePublic,
+	ledger *xdialPeerDERPLedger,
+	regionID int,
+	dc *derphttp.Client,
+) bool {
+	if ledger.lastWriteRegion == regionID && ledger.lastWriteClient == dc {
+		return true
+	}
+	if ledger.lastReplyRegion == regionID && ledger.lastReplyClient == dc {
+		return true
+	}
+	route, ok := c.derpRoute[peer]
+	return ok && route.regionID == regionID && route.dc == dc
+}
+
+func (c *Conn) xdialNoteDERPReaderError(
+	regionID int,
+	dc *derphttp.Client,
+	reason string,
+) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	sequence := c.xdialNextPeerDERPSequenceLocked()
+	reason = xdialDERPBoundedReaderErrorReason(reason)
+	for peer, ledger := range c.xdialPeerDERP {
+		if c.xdialLedgerUsesClientLocked(peer, ledger, regionID, dc) {
+			ledger.readerErrorSequence = sequence
+			ledger.readerErrorReason = reason
+		}
+	}
+}
+
+func (c *Conn) xdialNoteDERPServerInfo(
+	regionID int,
+	dc *derphttp.Client,
+) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	active, ok := c.activeDerp[regionID]
+	if !ok || active.c != dc {
+		return
+	}
+	sequence := c.xdialNextPeerDERPSequenceLocked()
+	active.xdialServerInfoSequence = sequence
+	c.activeDerp[regionID] = active
+	for peer, ledger := range c.xdialPeerDERP {
+		if c.xdialLedgerUsesClientLocked(peer, ledger, regionID, dc) {
+			ledger.serverInfoSequence = sequence
+		}
+	}
+}
+
+func xdialDERPClientCloseReason(raw string) string {
+	switch raw {
+	case "derp-disabled":
+		return xdialDERPClientCloseDisabled
+	case "derp-region-redefined":
+		return xdialDERPClientCloseRegionRedefined
+	case "debug-break-derp":
+		return xdialDERPClientCloseDebugBreak
+	case "network-down":
+		return xdialDERPClientCloseNetworkDown
+	case "rebind-no-localaddr":
+		return xdialDERPClientCloseRebindNoLocalAddr
+	case "rebind-default-route-change":
+		return xdialDERPClientCloseRebindDefaultRouteChange
+	case "rebind-ping-fail":
+		return xdialDERPClientCloseRebindPingFailed
+	case "idle":
+		return xdialDERPClientCloseIdle
+	case "zero-private-key":
+		return xdialDERPClientCloseZeroPrivateKey
+	case "new-private-key":
+		return xdialDERPClientCloseNewPrivateKey
+	case "conn-close":
+		return xdialDERPClientCloseConnClose
+	case "set-homeless":
+		return xdialDERPClientCloseSetHomeless
+	default:
+		return xdialDERPClientCloseUnknown
+	}
+}
+
+func xdialDERPConnectionChangedSinceLastSend(last, current int) bool {
+	return last > 0 && current > 0 && last != current
+}
+
+func xdialDERPBoundedRouteKind(kind string) string {
+	switch kind {
+	case xdialDERPRouteKindRequested, xdialDERPRouteKindReverse:
+		return kind
+	default:
+		return xdialDERPRouteKindNone
+	}
+}
+
+// xdialNoteDERPClientCloseLocked records an explicit magicsock close
+// separately from a later reader error. c.mu must be held.
+func (c *Conn) xdialNoteDERPClientCloseLocked(
+	regionID int,
+	dc *derphttp.Client,
+	rawReason string,
+) {
+	sequence := c.xdialNextPeerDERPSequenceLocked()
+	reason := xdialDERPClientCloseReason(rawReason)
+	for peer, ledger := range c.xdialPeerDERP {
+		if c.xdialLedgerUsesClientLocked(peer, ledger, regionID, dc) {
+			ledger.clientCloseSequence = sequence
+			ledger.clientCloseReason = reason
+		}
+	}
+}
+
+// XDialPeerDERPState returns bounded DERP path diagnostics for peer.
+func (c *Conn) XDialPeerDERPState(
+	peer key.NodePublic,
+) XDialPeerDERPDiagnostics {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	result := XDialPeerDERPDiagnostics{
+		ReplyRouteState:         xdialDERPStateAbsent,
+		LastWriteRouteState:     xdialDERPStateAbsent,
+		LastWriteRouteKind:      xdialDERPRouteKindNone,
+		LastWriteClientState:    xdialDERPClientMissing,
+		RouteInvalidationReason: xdialDERPReasonNone,
+		ReaderErrorReason:       xdialDERPReasonNone,
+		ClientCloseReason:       xdialDERPReasonNone,
+	}
+	ledger := c.xdialPeerDERPLedgerLocked(peer, false)
+	if ledger == nil {
+		return result
+	}
+	result.Observed = true
+	result.LastWriteRouteKind =
+		xdialDERPBoundedRouteKind(ledger.lastWriteKind)
+	result.LastSendConnectionGeneration = ledger.lastSendConnectionGeneration
+	result.SendAttemptSequence = ledger.sendAttemptSequence
+	result.SendSuccessSequence = ledger.sendSuccessSequence
+	result.SendErrorSequence = ledger.sendErrorSequence
+	result.LastSendWasDisco = ledger.lastSendWasDisco
+	result.ReceivePacketSequence = ledger.receivePacketSequence
+	result.RouteInvalidationSequence = ledger.routeInvalidationSequence
+	result.RouteInvalidationReason = ledger.routeInvalidationReason
+	if result.RouteInvalidationReason == "" {
+		result.RouteInvalidationReason = xdialDERPReasonNone
+	}
+	result.ReaderErrorSequence = ledger.readerErrorSequence
+	result.ReaderErrorReason = ledger.readerErrorReason
+	if result.ReaderErrorReason == "" {
+		result.ReaderErrorReason = xdialDERPReasonNone
+	}
+	result.ServerInfoSequence = ledger.serverInfoSequence
+	result.ClientCloseSequence = ledger.clientCloseSequence
+	result.ClientCloseReason = ledger.clientCloseReason
+	if result.ClientCloseReason == "" {
+		result.ClientCloseReason = xdialDERPReasonNone
+	}
+
+	if route, ok := c.derpRoute[peer]; ok {
+		result.ReplyRouteState = xdialDERPStateStale
+		if active, ok := c.activeDerp[route.regionID]; ok &&
+			active.c == route.dc {
+			result.ReplyRouteState = xdialDERPStateCurrent
+		}
+	}
+
+	if ledger.lastWriteClient == nil {
+		return result
+	}
+
+	active, activePresent := c.activeDerp[ledger.lastWriteRegion]
+	activeMatches := activePresent && active.c == ledger.lastWriteClient
+	result.LastWriteRouteState = xdialDERPStateStale
+	switch ledger.lastWriteKind {
+	case xdialDERPRouteKindRequested:
+		if activeMatches {
+			result.LastWriteRouteState = xdialDERPStateCurrent
+		}
+	case xdialDERPRouteKindReverse:
+		reply, ok := c.derpRoute[peer]
+		if activeMatches && ok &&
+			reply.regionID == ledger.lastWriteRegion &&
+			reply.dc == ledger.lastWriteClient {
+			result.LastWriteRouteState = xdialDERPStateCurrent
+		}
+	case "", xdialDERPRouteKindNone:
+		result.LastWriteRouteState = xdialDERPStateAbsent
+	default:
+		result.LastWriteClientState = xdialDERPClientUnknown
+	}
+
+	client := ledger.lastWriteClient.XDialConnectionDiagnostics()
+	result.CurrentConnectionGeneration = client.Generation
+	result.ConnectionChangedSinceLastSend =
+		xdialDERPConnectionChangedSinceLastSend(
+			ledger.lastSendConnectionGeneration,
+			client.Generation,
+		)
+	result.LastWriteClientIdealKnown = client.IdealKnown
+	result.LastWriteClientIdeal = client.Ideal
+	result.ServerChangeSequence = client.ServerChangeSequence
+	switch {
+	case client.Closed:
+		result.LastWriteClientState = xdialDERPClientClosed
+	case !activeMatches:
+		result.LastWriteClientState = xdialDERPClientStale
+	case active.protocolReady:
+		result.LastWriteClientState = xdialDERPClientCurrentProtocolReady
+	default:
+		result.LastWriteClientState = xdialDERPClientCurrentNotReady
+	}
+	return result
+}
