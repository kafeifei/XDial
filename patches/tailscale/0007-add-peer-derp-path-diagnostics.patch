+// Copyright (c) Tailscale Inc & AUTHORS
+// SPDX-License-Identifier: BSD-3-Clause
+
+package magicsock
+
+import (
+	"errors"
+	"testing"
+	"time"
+
+	"github.com/sagernet/tailscale/derp"
+	"github.com/sagernet/tailscale/types/key"
+	"github.com/sagernet/tailscale/util/set"
+)
+
+func xdialTestActiveDERP(
+	t *testing.T,
+	c *Conn,
+	regionID int,
+	protocolReady bool,
+) activeDerp {
+	t.Helper()
+	lastWrite := time.Now()
+	active := activeDerp{
+		c:             newXDialTestDERPClient(t, key.NewNode()),
+		lastWrite:     &lastWrite,
+		createTime:    time.Now(),
+		protocolReady: protocolReady,
+	}
+	c.activeDerp = map[int]activeDerp{regionID: active}
+	return active
+}
+
+func TestXDialPeerDERPStateNotHereWithoutReplyRoute(t *testing.T) {
+	c := newConn(t.Logf)
+	peer := key.NewNode().Public()
+	client := newXDialTestDERPClient(t, key.NewNode())
+
+	c.xdialRemoveDERPPeerRoute(
+		peer,
+		7,
+		client,
+		xdialDERPPeerGoneReason(derp.PeerGoneReasonNotHere),
+		true,
+	)
+
+	got := c.XDialPeerDERPState(peer)
+	if !got.Observed ||
+		got.ReplyRouteState != xdialDERPStateAbsent ||
+		got.RouteInvalidationSequence == 0 ||
+		got.RouteInvalidationReason !=
+			xdialDERPRouteInvalidationPeerGoneNotHere {
+		t.Fatalf("route-absent NotHere = %+v", got)
+	}
+}
+
+func TestXDialPeerDERPStateSeparatesExplicitCloseAndReaderError(t *testing.T) {
+	c := newConn(t.Logf)
+	peer := key.NewNode().Public()
+	const regionID = 7
+
+	c.mu.Lock()
+	active := xdialTestActiveDERP(t, c, regionID, true)
+	c.xdialNotePeerDERPWriteRouteLocked(
+		peer,
+		regionID,
+		active.c,
+		xdialDERPRouteKindRequested,
+		active,
+	)
+	c.xdialNoteDERPClientCloseLocked(regionID, active.c, "idle")
+	c.mu.Unlock()
+	c.xdialNoteDERPReaderError(
+		regionID,
+		active.c,
+		xdialDERPReaderErrorTransport,
+	)
+
+	got := c.XDialPeerDERPState(peer)
+	if got.ClientCloseSequence == 0 ||
+		got.ClientCloseReason != xdialDERPClientCloseIdle {
+		t.Fatalf("explicit close = %+v", got)
+	}
+	if got.ReaderErrorSequence == 0 ||
+		got.ReaderErrorReason != xdialDERPReaderErrorTransport {
+		t.Fatalf("reader error = %+v", got)
+	}
+	if got.ClientCloseSequence >= got.ReaderErrorSequence {
+		t.Fatalf("close and reader error order collapsed: %+v", got)
+	}
+}
+
+func TestXDialPeerDERPStateTracksRoutesAndSendSequences(t *testing.T) {
+	c := newConn(t.Logf)
+	peer := key.NewNode().Public()
+	const regionID = 7
+
+	c.mu.Lock()
+	active := xdialTestActiveDERP(t, c, regionID, true)
+	c.derpRoute = map[key.NodePublic]derpRoute{
+		peer: {regionID: regionID, dc: active.c},
+	}
+	c.xdialNotePeerDERPWriteRouteLocked(
+		peer,
+		regionID,
+		active.c,
+		xdialDERPRouteKindReverse,
+		active,
+	)
+	c.mu.Unlock()
+	c.xdialNotePeerDERPSendAttempt(
+		peer,
+		regionID,
+		active.c,
+		xdialDERPRouteKindReverse,
+		false,
+	)
+	c.xdialNotePeerDERPSendResult(
+		peer,
+		regionID,
+		active.c,
+		xdialDERPRouteKindReverse,
+		false,
+		1,
+		nil,
+	)
+	c.xdialNotePeerDERPReceivePacket(peer, regionID, active.c)
+	c.xdialNoteDERPServerInfo(regionID, active.c)
+
+	got := c.XDialPeerDERPState(peer)
+	if got.ReplyRouteState != xdialDERPStateCurrent ||
+		got.LastWriteRouteState != xdialDERPStateCurrent ||
+		got.LastWriteRouteKind != xdialDERPRouteKindReverse ||
+		got.LastWriteClientState !=
+			xdialDERPClientCurrentProtocolReady {
+		t.Fatalf("current routes = %+v", got)
+	}
+	if got.SendAttemptSequence == 0 ||
+		got.SendSuccessSequence <= got.SendAttemptSequence ||
+		got.SendErrorSequence != 0 ||
+		got.ReceivePacketSequence == 0 ||
+		got.ServerInfoSequence == 0 ||
+		got.LastSendConnectionGeneration != 1 {
+		t.Fatalf("event sequences = %+v", got)
+	}
+
+	c.xdialNotePeerDERPSendResult(
+		peer,
+		regionID,
+		active.c,
+		xdialDERPRouteKindReverse,
+		false,
+		2,
+		errors.New("send failed"),
+	)
+	got = c.XDialPeerDERPState(peer)
+	if got.SendErrorSequence <= got.SendSuccessSequence ||
+		got.LastSendConnectionGeneration != 2 {
+		t.Fatalf("send error sequence = %+v", got)
+	}
+
+	c.mu.Lock()
+	delete(c.derpRoute, peer)
+	c.mu.Unlock()
+	got = c.XDialPeerDERPState(peer)
+	if got.ReplyRouteState != xdialDERPStateAbsent ||
+		got.LastWriteRouteState != xdialDERPStateStale {
+		t.Fatalf("removed reverse route = %+v", got)
+	}
+}
