-	client, _, err := c.connect(c.newContext(), "derphttp.Client.Send")
+	_, err := c.XDialSendWithGeneration(dstKey, b)
+	return err
+}
+
+// XDialSendWithGeneration sends a packet and returns the exact connection
+// generation used by the send. The generation contains no server identity.
+func (c *Client) XDialSendWithGeneration(dstKey key.NodePublic, b []byte) (int, error) {
+	client, generation, err := c.connect(c.newContext(), "derphttp.Client.Send")
 	if err != nil {
-		return err
+		return 0, err
 	}
 	if err := client.Send(dstKey, b); err != nil {
 		c.closeForReconnect(client)
+		return generation, err
 	}
-	return err
+	return generation, nil
 }
 
