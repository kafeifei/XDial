{
  "log": {
    "level": "debug",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "type": "local",
        "tag": "underlay-dns"
      }
    ],
    "final": "underlay-dns"
  },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "transparent-flow-in",
      "listen": "127.0.0.1",
      "listen_port": 20888
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "underlay"
    }
  ],
  "route": {
    "rules": [
      {
        "action": "sniff"
      },
      {
        "protocol": "dns",
        "action": "hijack-dns"
      }
    ],
    "default_domain_resolver": "underlay-dns",
    "final": "underlay"
  }
}
